#!/usr/bin/env node
// A fake signal-cli for tests and development: speaks `jsonRpc` (one JSON
// object per line on stdin/stdout) like the real one, with canned answers.
// Point Settings → Connection → signal-cli program at this file to try the
// desktop app without an account.
//
// Environment:
//   FAKE_SIGNAL_CLI_ACCOUNTS   JSON array for listAccounts (default: one account)
//   FAKE_SIGNAL_CLI_MESSAGES   messages delivered after subscribeReceive (default 2)
//   FAKE_SIGNAL_CLI_CRASH_AFTER  exit(3) after this many requests (restart tests)
//   FAKE_SIGNAL_CLI_ARGS_FILE  write the command line here (argument tests)
// The same settings can come from `<--config dir>/fake.json` ({ accounts,
// messages, crashAfter }), which is how the Rust tests configure it; the
// fake also writes its pid to `<--config dir>/fake.pid`.
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import readline from 'node:readline';

const args = process.argv.slice(2);
if (args.includes('--version')) {
  process.stdout.write('signal-cli 0.0.0-fake\n');
  process.exit(0);
}
if (process.env.FAKE_SIGNAL_CLI_ARGS_FILE)
  writeFileSync(process.env.FAKE_SIGNAL_CLI_ARGS_FILE, JSON.stringify(args));
if (!args.includes('jsonRpc') || !args.includes('--receive-mode=manual')) {
  process.stderr.write(`fake signal-cli: unexpected arguments ${JSON.stringify(args)}\n`);
  process.exit(2);
}
const single = args.includes('-a') ? args[args.indexOf('-a') + 1] : null;
const configDir = args.includes('--config') ? args[args.indexOf('--config') + 1] : null;
const file =
  configDir && existsSync(path.join(configDir, 'fake.json'))
    ? JSON.parse(readFileSync(path.join(configDir, 'fake.json'), 'utf8'))
    : {};
if (configDir && existsSync(configDir))
  writeFileSync(path.join(configDir, 'fake.pid'), String(process.pid));
const ACI = '11111111-1111-4111-8111-111111111111';
const accounts = process.env.FAKE_SIGNAL_CLI_ACCOUNTS
  ? JSON.parse(process.env.FAKE_SIGNAL_CLI_ACCOUNTS)
  : (file.accounts ?? [{ number: '+15550001', aci: ACI }]);
const messages = Number(process.env.FAKE_SIGNAL_CLI_MESSAGES ?? file.messages ?? 2);
const crashAfter = Number(process.env.FAKE_SIGNAL_CLI_CRASH_AFTER ?? file.crashAfter ?? 0);
let handled = 0;
let nextSubscription = 0;

process.stderr.write(
  `INFO  fake signal-cli started (${single ? `account ${single}` : 'multi-account'})\n`,
);
const send = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);
const ok = (id, result) => send({ jsonrpc: '2.0', result, id });
const fail = (id, code, message) =>
  send({ jsonrpc: '2.0', error: { code, message, data: null }, id });

function envelope(i, account) {
  const now = Date.now() + i;
  return {
    envelope: {
      source: '+15550002',
      sourceNumber: '+15550002',
      sourceUuid: '22222222-2222-4222-8222-222222222222',
      sourceName: 'Fake Friend',
      sourceDevice: 1,
      timestamp: now,
      dataMessage: {
        timestamp: now,
        message: `fake message ${i + 1}`,
        expiresInSeconds: 0,
        viewOnce: false,
      },
    },
    account,
  };
}

const methods = {
  version: () => ({ version: '0.0.0-fake' }),
  listAccounts: () => {
    if (single) throw { code: -32601, message: 'Method not implemented' };
    return accounts;
  },
  listGroups: () => [],
  listContacts: () => [],
  listIdentities: () => [],
  getUserStatus: () => [],
  send: () => ({ timestamp: Date.now(), results: [{ type: 'SUCCESS' }] }),
  sendTyping: () => ({}),
  sendReceipt: () => ({}),
  sendReaction: () => ({ timestamp: Date.now(), results: [] }),
  getAttachment: () => ({ data: Buffer.from('hello attachment').toString('base64') }),
  startLink: () => ({ deviceLinkUri: 'sgnl://linkdevice?uuid=ZmFrZQ&pub_key=BfakeKey' }),
  finishLink: () => ({ number: '+15550001', aci: ACI }),
  subscribeReceive: (params) => {
    const subscription = nextSubscription++;
    const account = params?.account ?? single ?? accounts[0]?.number ?? null;
    setTimeout(() => {
      for (let i = 0; i < messages; i++)
        send({
          jsonrpc: '2.0',
          method: 'receive',
          params: { subscription, result: envelope(i, account) },
        });
    }, 20);
    return subscription;
  },
  unsubscribeReceive: () => true,
};

readline
  .createInterface({ input: process.stdin })
  .on('line', (line) => {
    if (!line.trim()) return;
    let request;
    try {
      request = JSON.parse(line);
    } catch {
      fail(null, -32700, 'Parse error');
      return;
    }
    const { id, method, params } = request;
    const handler = methods[method];
    if (!handler) fail(id, -32601, 'Method not implemented');
    else if (
      !single &&
      params?.account === undefined &&
      ['listGroups', 'listContacts', 'send'].includes(method)
    )
      fail(id, -32602, 'Method requires valid account parameter');
    else {
      try {
        ok(id, handler(params));
      } catch (error) {
        fail(id, error.code ?? -32603, error.message ?? String(error));
      }
    }
    handled++;
    if (crashAfter && handled >= crashAfter) {
      process.stderr.write('fake signal-cli: crashing as asked\n');
      setTimeout(() => process.exit(3), 10);
    }
  })
  .on('close', () => setTimeout(() => process.exit(0), 50));

if (process.env.FAKE_SIGNAL_CLI_LOG) appendFileSync(process.env.FAKE_SIGNAL_CLI_LOG, 'started\n');
