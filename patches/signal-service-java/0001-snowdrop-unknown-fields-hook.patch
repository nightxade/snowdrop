index 0000000..91ee6e2
--- /dev/null
+++ b/lib/libsignal-service/src/test/java/org/whispersystems/signalservice/api/messages/SignalServiceDataMessageUnknownFieldsTest.kt
@@ -0,0 +1,69 @@
+/*
+ * Licensed according to the LICENSE file in this repository.
+ */
+
+package org.whispersystems.signalservice.api.messages
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import com.squareup.wire.FieldEncoding
+import okio.ByteString
+import org.junit.Test
+import org.whispersystems.signalservice.internal.push.DataMessage
+
+/**
+ * Covers the generic "extra unknown-field bytes" hook on [SignalServiceDataMessage]: a caller
+ * (e.g. a signal-cli patch) can attach pre-encoded Wire unknown-field bytes that survive into
+ * the proto this library builds for sending, without this library knowing anything about the
+ * field's number or meaning.
+ */
+class SignalServiceDataMessageUnknownFieldsTest {
+
+  @Test
+  fun `builder without unknownFields leaves it absent`() {
+    val message = SignalServiceDataMessage.newBuilder().withBody("hi").build()
+
+    assertThat(message.unknownFields.isPresent).isFalse()
+  }
+
+  @Test
+  fun `builder carries unknownFields bytes through to the built message`() {
+    val extra = ByteString.of(1, 2, 3)
+
+    val message = SignalServiceDataMessage.newBuilder()
+      .withBody("hi")
+      .withUnknownFields(extra)
+      .build()
+
+    assertThat(message.unknownFields.isPresent).isTrue()
+    assertThat(message.unknownFields.get()).isEqualTo(extra)
+  }
+
+  @Test
+  fun `addUnknownFields on the Wire builder round-trips through encode and decode`() {
+    // This is the exact mechanism SignalServiceMessageSender.createDataMessage relies on:
+    // Message.Builder#addUnknownFields merges pre-encoded field bytes in, and Wire's normal
+    // ADAPTER.encode/decode preserves them as unknown fields on the far side (this is what lets
+    // a field number this library's .proto doesn't declare, such as a high field number used by
+    // a downstream fork, survive a round trip without any schema change here).
+    val fieldNumber = 9000
+    val payload = ByteString.of(42, 7)
+    val encodedField = okio.Buffer().apply {
+      val writer = com.squareup.wire.ProtoWriter(this)
+      writer.writeTag(fieldNumber, FieldEncoding.LENGTH_DELIMITED)
+      writer.writeVarint32(payload.size)
+      writer.writeBytes(payload)
+    }.readByteString()
+
+    val builder = DataMessage.Builder().body("hi")
+    builder.addUnknownFields(encodedField)
+    val encoded = DataMessage.ADAPTER.encode(builder.build())
+
+    val decoded = DataMessage.ADAPTER.decode(encoded)
+
+    assertThat(decoded.body).isEqualTo("hi")
+    assertThat(decoded.unknownFields).isEqualTo(encodedField)
+  }
+}
