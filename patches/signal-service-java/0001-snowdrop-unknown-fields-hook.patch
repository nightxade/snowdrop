diff --git a/lib/libsignal-service/src/test/java/org/whispersystems/signalservice/api/messages/SignalServiceDataMessageUnknownFieldsTest.kt b/lib/libsignal-service/src/test/java/org/whispersystems/signalservice/api/messages/SignalServiceDataMessageUnknownFieldsTest.kt
