+ */
+
+package org.whispersystems.signalservice.api.messages
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import okio.ByteString.Companion.toByteString
+import org.junit.Test
+import org.signal.core.models.ServiceId.ACI
+import org.whispersystems.signalservice.api.crypto.EnvelopeMetadata
+import org.whispersystems.signalservice.api.messages.multidevice.SignalServiceSyncMessage
+import org.whispersystems.signalservice.internal.push.AddressableMessage
+import org.whispersystems.signalservice.internal.push.ConversationIdentifier
+import org.whispersystems.signalservice.internal.push.Content
+import org.whispersystems.signalservice.internal.push.Envelope
+import org.whispersystems.signalservice.internal.push.SyncMessage
+import java.util.UUID
+
+/**
+ * A synced DeleteForMe is kept when it is decoded from the wire: the stock parser turned it into
+ * an empty sync message, so a delete made on another device never reached the application.
+ */
+class SignalServiceContentDeleteForMeTest {
+
+  private val self = ACI.from(UUID.fromString("11111111-2222-3333-4444-555555555555"))
+  private val other = UUID.fromString("66666666-7777-8888-9999-000000000000")
+
+  private fun decode(deleteForMe: SyncMessage.DeleteForMe): SignalServiceSyncMessage {
+    // Round-trip through the wire format, as a received envelope would be.
+    val content = Content.ADAPTER.decode(Content(syncMessage = SyncMessage(deleteForMe = deleteForMe)).encode())
+    val metadata = EnvelopeMetadata(
+      sourceServiceId = self,
+      sourceE164 = null,
+      sourceDeviceId = 2,
+      sealedSender = false,
+      groupId = null,
+      destinationServiceId = self,
+      ciphertextMessageType = 0
+    )
+    val decoded = SignalServiceContent.createFrom(null, Envelope(), metadata, content, 0)!!
+    assertThat(decoded.syncMessage.isPresent).isTrue()
+    return decoded.syncMessage.get()
+  }
+
+  @Test
+  fun `message deletes are decoded`() {
+    val sync = decode(
+      SyncMessage.DeleteForMe(
+        messageDeletes = listOf(
+          SyncMessage.DeleteForMe.MessageDeletes(
+            conversation = ConversationIdentifier(threadServiceId = other.toString()),
+            messages = listOf(AddressableMessage(authorServiceId = self.toString(), sentTimestamp = 1234L))
+          )
+        )
+      )
+    )
+    assertThat(sync.deleteForMe.isPresent).isTrue()
+    val deletes = sync.deleteForMe.get().messageDeletes
+    assertThat(deletes.size).isEqualTo(1)
+    assertThat(deletes[0].conversation!!.threadServiceId).isEqualTo(other.toString())
+    assertThat(deletes[0].messages[0].authorServiceId).isEqualTo(self.toString())
+    assertThat(deletes[0].messages[0].sentTimestamp).isEqualTo(1234L)
+  }
+
+  @Test
+  fun `conversation deletes and local-only deletes are decoded`() {
+    val sync = decode(
+      SyncMessage.DeleteForMe(
+        conversationDeletes = listOf(
+          SyncMessage.DeleteForMe.ConversationDelete(
+            conversation = ConversationIdentifier(threadGroupId = byteArrayOf(1, 2, 3, 4).toByteString()),
+            mostRecentMessages = listOf(AddressableMessage(authorE164 = "+15550001111", sentTimestamp = 99L)),
+            isFullDelete = true
+          )
+        ),
+        localOnlyConversationDeletes = listOf(
+          SyncMessage.DeleteForMe.LocalOnlyConversationDelete(conversation = ConversationIdentifier(threadE164 = "+15550002222"))
+        )
+      )
+    )
+    val deleteForMe = sync.deleteForMe.get()
+    assertThat(deleteForMe.conversationDeletes[0].conversation!!.threadGroupId!!.toByteArray().toList()).isEqualTo(listOf<Byte>(1, 2, 3, 4))
+    assertThat(deleteForMe.conversationDeletes[0].isFullDelete).isEqualTo(true)
+    assertThat(deleteForMe.conversationDeletes[0].mostRecentMessages[0].authorE164).isEqualTo("+15550001111")
+    assertThat(deleteForMe.localOnlyConversationDeletes[0].conversation!!.threadE164).isEqualTo("+15550002222")
+  }
+
+  @Test
+  fun `a sync message without deleteForMe has none`() {
+    val content = Content.ADAPTER.decode(Content(syncMessage = SyncMessage(deviceNameChange = SyncMessage.DeviceNameChange(deviceId = 3))).encode())
+    val metadata = EnvelopeMetadata(self, null, 2, false, null, self, 0)
+    val decoded = SignalServiceContent.createFrom(null, Envelope(), metadata, content, 0)!!
+    assertThat(decoded.syncMessage.get().deleteForMe.isPresent).isFalse()
+  }
+
+  @Test
+  fun `forDeleteForMe carries the proto and leaves the other fields empty`() {
+    val proto = SyncMessage.DeleteForMe(
+      messageDeletes = listOf(SyncMessage.DeleteForMe.MessageDeletes(conversation = ConversationIdentifier(threadServiceId = other.toString())))
+    )
+    val sync = SignalServiceSyncMessage.forDeleteForMe(proto)
+    assertThat(sync.deleteForMe.get()).isEqualTo(proto)
+    assertThat(sync.read.isPresent).isFalse()
+    assertThat(sync.sent.isPresent).isFalse()
+    assertThat(sync.attachmentBackfillRequest.isPresent).isFalse()
+  }
+}
