diff --git a/lib/src/main/java/org/asamk/signal/manager/storage/AttachmentBackfillStore.java b/lib/src/main/java/org/asamk/signal/manager/storage/AttachmentBackfillStore.java
new file mode 100644
index 0000000..f37173b
--- /dev/null
+++ b/lib/src/main/java/org/asamk/signal/manager/storage/AttachmentBackfillStore.java
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.storage;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.sql.SQLException;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Remembers the attachment ids a message's backfill request asked the phone for, keyed by the
+ * same (author, sentTimestamp) pair that identifies that message on the wire ({@code
+ * AddressableMessage}). {@link org.asamk.signal.manager.helper.AttachmentBackfillHelper} consults
+ * this when a {@code SyncMessage.attachmentBackfillResponse} comes back, to map the response's
+ * pointers back onto the original attachment ids by index, and to coalesce a repeated request for
+ * a message that's already pending.
+ * <p>
+ * Its table lives in the same account database as everything else, but — like {@code
+ * AttachmentPointerStore}'s {@code snowdrop_attachment_pointer} — outside {@link AccountDatabase}'s
+ * own versioned schema: created lazily with {@code CREATE TABLE IF NOT EXISTS} on first use, not
+ * gated behind a {@code DATABASE_VERSION} bump (see that class's javadoc for why).
+ */
+public class AttachmentBackfillStore {
+
+    private static final Logger logger = LoggerFactory.getLogger(AttachmentBackfillStore.class);
+    private static final String TABLE_ATTACHMENT_BACKFILL = "snowdrop_attachment_backfill";
+
+    /** Ids never contain this; see {@link #store}. */
+    private static final String ID_SEPARATOR = "\n";
+
+    /** A request nobody answered for this long is abandoned rather than kept forever. */
+    private static final long MAX_AGE_MILLIS = TimeUnit.DAYS.toMillis(1);
+
+    private final Database database;
+
+    public AttachmentBackfillStore(final Database database) {
+        this.database = database;
+        try (final var connection = database.getConnection(); final var statement = connection.createStatement()) {
+            statement.executeUpdate(("""
+                                     CREATE TABLE IF NOT EXISTS %s (
+                                       target_author TEXT NOT NULL,
+                                       target_timestamp INTEGER NOT NULL,
+                                       attachment_ids TEXT NOT NULL,
+                                       created_at INTEGER NOT NULL,
+                                       PRIMARY KEY (target_author, target_timestamp)
+                                     )
+                                     """).formatted(TABLE_ATTACHMENT_BACKFILL));
+        } catch (SQLException e) {
+            throw new RuntimeException("Failed to initialize attachment backfill storage", e);
+        }
+    }
+
+    public record PendingRequest(List<String> attachmentIds, long createdAt) {}
+
+    /**
+     * Records a new pending request, pruning any requests old enough that nobody is still
+     * waiting on an answer for them. Does nothing to an existing row for the same message — call
+     * {@link #get} first to coalesce a repeated request instead of resending it.
+     */
+    public void store(final String targetAuthor, final long targetTimestamp, final List<String> attachmentIds) {
+        pruneOlderThan(System.currentTimeMillis() - MAX_AGE_MILLIS);
+        final var sql = ("""
+                         INSERT INTO %s (target_author, target_timestamp, attachment_ids, created_at)
+                         VALUES (?, ?, ?, ?)
+                         ON CONFLICT (target_author, target_timestamp)
+                           DO UPDATE SET attachment_ids = excluded.attachment_ids, created_at = excluded.created_at
+                         """).formatted(TABLE_ATTACHMENT_BACKFILL);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setString(1, targetAuthor);
+            statement.setLong(2, targetTimestamp);
+            statement.setString(3, String.join(ID_SEPARATOR, attachmentIds));
+            statement.setLong(4, System.currentTimeMillis());
+            statement.executeUpdate();
+        } catch (SQLException e) {
+            logger.warn("Failed to persist pending attachment backfill request, ignoring: {}", e.getMessage());
+        }
+    }
+
+    /** The pending request for this message, if one is still outstanding. */
+    public Optional<PendingRequest> get(final String targetAuthor, final long targetTimestamp) {
+        final var sql = ("""
+                         SELECT attachment_ids, created_at FROM %s
+                         WHERE target_author = ? AND target_timestamp = ?
+                         """).formatted(TABLE_ATTACHMENT_BACKFILL);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setString(1, targetAuthor);
+            statement.setLong(2, targetTimestamp);
+            try (final var result = statement.executeQuery()) {
+                if (!result.next()) {
+                    return Optional.empty();
+                }
+                final var ids = List.of(result.getString("attachment_ids").split(ID_SEPARATOR));
+                return Optional.of(new PendingRequest(ids, result.getLong("created_at")));
+            }
+        } catch (SQLException e) {
+            logger.warn("Failed to read pending attachment backfill request, ignoring: {}", e.getMessage());
+            return Optional.empty();
+        }
+    }
+
+    /** Called once a response resolves a request, terminally or not: nothing further to wait for. */
+    public void remove(final String targetAuthor, final long targetTimestamp) {
+        final var sql = ("""
+                         DELETE FROM %s WHERE target_author = ? AND target_timestamp = ?
+                         """).formatted(TABLE_ATTACHMENT_BACKFILL);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setString(1, targetAuthor);
+            statement.setLong(2, targetTimestamp);
+            statement.executeUpdate();
+        } catch (SQLException e) {
+            logger.warn("Failed to remove resolved attachment backfill request, ignoring: {}", e.getMessage());
+        }
+    }
+
+    private void pruneOlderThan(final long cutoffMillis) {
+        final var sql = ("""
+                         DELETE FROM %s WHERE created_at < ?
+                         """).formatted(TABLE_ATTACHMENT_BACKFILL);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setLong(1, cutoffMillis);
+            statement.executeUpdate();
+        } catch (SQLException e) {
+            logger.warn("Failed to prune stale attachment backfill requests, ignoring: {}", e.getMessage());
+        }
+    }
+}
