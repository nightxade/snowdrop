@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.api;
+
+import java.util.List;
+
+/**
+ * The outcome of a {@code SyncMessage.attachmentBackfillResponse}, matched back to the request it
+ * answers. Delivered to {@link org.asamk.signal.manager.Manager.AttachmentBackfillListener}s and
+ * from there to the JSON-RPC {@code attachmentBackfill} notification (see
+ * {@code SignalJsonRpcDispatcherHandler}).
+ */
+public record AttachmentBackfillResult(
+        String targetAuthor,
+        long targetTimestamp,
+        Status status,
+        List<String> attachmentIds
+) {
+
+    public enum Status {
+        /** The phone is still looking; a later response for the same message may still arrive. */
+        PENDING,
+        /** The phone answered; any attachment it still had was stored and can now be re-downloaded. */
+        READY,
+        /** The phone doesn't know this message, or its answer didn't match the request. */
+        FAILED
+    }
+}
diff --git a/lib/src/main/java/org/asamk/signal/manager/helper/AttachmentBackfillHelper.java b/lib/src/main/java/org/asamk/signal/manager/helper/AttachmentBackfillHelper.java
new file mode 100644
index 0000000..1f92f7c
--- /dev/null
+++ b/lib/src/main/java/org/asamk/signal/manager/helper/AttachmentBackfillHelper.java
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.AttachmentBackfillResult;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.asamk.signal.manager.storage.AttachmentBackfillStore;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentPointer;
+import org.whispersystems.signalservice.api.messages.multidevice.SignalServiceSyncMessage;
+import org.whispersystems.signalservice.api.push.SignalServiceAddress;
+import org.whispersystems.signalservice.api.util.AttachmentPointerUtil;
+import org.whispersystems.signalservice.internal.push.AddressableMessage;
+import org.whispersystems.signalservice.internal.push.ConversationIdentifier;
+import org.whispersystems.signalservice.internal.push.SyncMessage;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.function.BiConsumer;
+import java.util.function.Consumer;
+
+import okio.ByteString;
+
+/**
+ * Sends {@code SyncMessage.attachmentBackfillRequest} to our own linked devices (in practice, the
+ * primary — only it can actually answer) and processes the {@code
+ * SyncMessage.attachmentBackfillResponse} that comes back, mapping any re-uploaded attachment onto
+ * {@code AttachmentPointerStore} under the same id Snowdrop already knows it by, so {@code
+ * getAttachment}'s existing on-demand re-download path (patch 0014) just works.
+ * <p>
+ * Pending requests are tracked in {@link AttachmentBackfillStore} by (author, sentTimestamp) —
+ * the same pair the wire protocol's {@code AddressableMessage} identifies a message by — so a
+ * repeated request for a message that's already waiting on an answer is coalesced rather than
+ * sent again, and an answer can be matched back to the ids that were actually asked for.
+ */
+public class AttachmentBackfillHelper {
+
+    private static final Logger logger = LoggerFactory.getLogger(AttachmentBackfillHelper.class);
+
+    private final AttachmentBackfillStore store;
+    private final Consumer<SyncMessage.AttachmentBackfillRequest> sender;
+    private final BiConsumer<String, SignalServiceAttachmentPointer> pointerSink;
+    private final Set<Manager.AttachmentBackfillListener> listeners = new HashSet<>();
+
+    public AttachmentBackfillHelper(final Context context) {
+        this(new AttachmentBackfillStore(context.getAccount().getAccountDatabase()),
+                request -> context.getSendHelper()
+                        .sendSyncMessage(SignalServiceSyncMessage.forAttachmentBackfillRequest(request)),
+                context.getAttachmentHelper()::storeBackfilledPointer);
+    }
+
+    /** Exposed for tests: sending and pointer storage are injected instead of needing a real {@link Context}. */
+    AttachmentBackfillHelper(
+            final AttachmentBackfillStore store,
+            final Consumer<SyncMessage.AttachmentBackfillRequest> sender,
+            final BiConsumer<String, SignalServiceAttachmentPointer> pointerSink
+    ) {
+        this.store = store;
+        this.sender = sender;
+        this.pointerSink = pointerSink;
+    }
+
+    public void addListener(final Manager.AttachmentBackfillListener listener) {
+        synchronized (listeners) {
+            listeners.add(listener);
+        }
+    }
+
+    public void removeListener(final Manager.AttachmentBackfillListener listener) {
+        synchronized (listeners) {
+            listeners.remove(listener);
+        }
+    }
+
+    /**
+     * @return true if a new request was sent to our primary; false if one was already pending
+     * for this exact message and this call coalesced into it instead of asking again.
+     */
+    public boolean request(
+            final RecipientIdentifier targetConversation,
+            final RecipientIdentifier.Single targetAuthor,
+            final long targetTimestamp,
+            final List<String> attachmentIds
+    ) {
+        final var authorKey = targetAuthor.getIdentifier();
+        if (store.get(authorKey, targetTimestamp).isPresent()) {
+            logger.debug("Attachment backfill already pending for this message, not asking again.");
+            return false;
+        }
+        store.store(authorKey, targetTimestamp, attachmentIds);
+
+        final var backfillRequest = new SyncMessage.AttachmentBackfillRequest.Builder()
+                .targetMessage(addressableMessage(targetAuthor, targetTimestamp))
+                .targetConversation(conversationIdentifier(targetConversation))
+                .build();
+        sender.accept(backfillRequest);
+        return true;
+    }
+
+    /**
+     * Handles a {@code SyncMessage.attachmentBackfillResponse}. Only a response from device id
+     * {@link SignalServiceAddress#DEFAULT_DEVICE_ID} (our primary) is trusted; a sync message's
+     * fanout can reach our other linked devices too, but only the primary can actually answer
+     * this request, so a response claiming to come from anywhere else is ignored.
+     */
+    public void handleResponse(final int senderDeviceId, final SyncMessage.AttachmentBackfillResponse response) {
+        if (senderDeviceId != SignalServiceAddress.DEFAULT_DEVICE_ID) {
+            logger.warn("Received attachment backfill response from non-primary device {}, ignoring.", senderDeviceId);
+            return;
+        }
+        final var targetMessage = response.targetMessage;
+        final var authorKey = targetMessage == null ? null : addressKey(targetMessage);
+        if (authorKey == null || targetMessage.sentTimestamp == null) {
+            logger.warn("Received attachment backfill response with no usable target message, ignoring.");
+            return;
+        }
+        final var targetTimestamp = targetMessage.sentTimestamp;
+        final var pending = store.get(authorKey, targetTimestamp);
+        if (pending.isEmpty()) {
+            logger.debug("Received attachment backfill response for an unknown or already-resolved request, ignoring.");
+            return;
+        }
+
+        final var attachmentIds = pending.get().attachmentIds();
+        final AttachmentBackfillResult.Status status;
+        if (response.error != null) {
+            status = AttachmentBackfillResult.Status.FAILED;
+            store.remove(authorKey, targetTimestamp);
+        } else {
+            final var items = response.attachments == null
+                    ? List.<SyncMessage.AttachmentBackfillResponse.AttachmentData>of()
+                    : response.attachments.attachments;
+            if (items.size() != attachmentIds.size()) {
+                logger.warn("Attachment backfill response had {} attachments, expected {}; failing.",
+                        items.size(),
+                        attachmentIds.size());
+                status = AttachmentBackfillResult.Status.FAILED;
+                store.remove(authorKey, targetTimestamp);
+            } else {
+                storeResolvedPointers(attachmentIds, items);
+                final var stillPending = items.stream()
+                        .anyMatch(item -> item.status == SyncMessage.AttachmentBackfillResponse.AttachmentData.Status.PENDING);
+                if (stillPending) {
+                    // Keep the request: a later response for the same message is still coming.
+                    status = AttachmentBackfillResult.Status.PENDING;
+                } else {
+                    status = AttachmentBackfillResult.Status.READY;
+                    store.remove(authorKey, targetTimestamp);
+                }
+            }
+        }
+        notifyListeners(new AttachmentBackfillResult(authorKey, targetTimestamp, status, attachmentIds));
+    }
+
+    /** Stores whatever pointers the phone actually sent; a PENDING or TERMINAL_ERROR item has none. */
+    private void storeResolvedPointers(
+            final List<String> attachmentIds,
+            final List<SyncMessage.AttachmentBackfillResponse.AttachmentData> items
+    ) {
+        for (var i = 0; i < attachmentIds.size(); i++) {
+            final var item = items.get(i);
+            if (item.attachment == null) {
+                continue;
+            }
+            final var id = attachmentIds.get(i);
+            try {
+                final var pointer = AttachmentPointerUtil.createSignalAttachmentPointer(item.attachment);
+                pointerSink.accept(id, pointer);
+            } catch (Exception e) {
+                logger.warn("Failed to store backfilled pointer for attachment {}, ignoring: {}", id, e.getMessage());
+            }
+        }
+    }
+
+    private void notifyListeners(final AttachmentBackfillResult result) {
+        final Set<Manager.AttachmentBackfillListener> current;
+        synchronized (listeners) {
+            current = Set.copyOf(listeners);
+        }
+        for (final var listener : current) {
+            listener.handle(result);
+        }
+    }
+
+    private static String addressKey(final AddressableMessage message) {
+        return message.authorServiceId != null ? message.authorServiceId : message.authorE164;
+    }
+
+    private static AddressableMessage addressableMessage(final RecipientIdentifier.Single author, final long sentTimestamp) {
+        final var builder = new AddressableMessage.Builder().sentTimestamp(sentTimestamp);
+        switch (author) {
+            case RecipientIdentifier.Uuid uuid -> builder.authorServiceId(uuid.uuid().toString());
+            case RecipientIdentifier.Pni pni -> builder.authorServiceId(pni.getIdentifier());
+            case RecipientIdentifier.Number number -> builder.authorE164(number.number());
+            case RecipientIdentifier.Username username -> throw new IllegalArgumentException(
+                    "Attachment backfill needs an ACI, PNI or phone number author, not a username");
+        }
+        return builder.build();
+    }
+
+    private static ConversationIdentifier conversationIdentifier(final RecipientIdentifier target) {
+        final var builder = new ConversationIdentifier.Builder();
+        switch (target) {
+            case RecipientIdentifier.Group group -> builder.threadGroupId(ByteString.of(group.groupId().serialize()));
+            case RecipientIdentifier.Uuid uuid -> builder.threadServiceId(uuid.uuid().toString());
+            case RecipientIdentifier.Pni pni -> builder.threadServiceId(pni.getIdentifier());
+            case RecipientIdentifier.Number number -> builder.threadE164(number.number());
+            case RecipientIdentifier.Username username -> throw new IllegalArgumentException(
+                    "Attachment backfill needs an ACI, PNI, phone number or group conversation, not a username");
+            case RecipientIdentifier.NoteToSelf noteToSelf -> throw new IllegalArgumentException(
+                    "Attachment backfill does not apply to Note to Self");
+        }
+        return builder.build();
+    }
+}
