+++ b/lib/src/test/java/org/asamk/signal/manager/helper/AttachmentBackfillHelperTest.java
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.asamk.signal.manager.api.AttachmentBackfillResult;
+import org.asamk.signal.manager.api.GroupId;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.asamk.signal.manager.storage.AccountDatabase;
+import org.asamk.signal.manager.storage.AttachmentBackfillStore;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.whispersystems.signalservice.api.push.SignalServiceAddress;
+import org.whispersystems.signalservice.internal.push.AddressableMessage;
+import org.whispersystems.signalservice.internal.push.AttachmentPointer;
+import org.whispersystems.signalservice.internal.push.SyncMessage;
+import org.whispersystems.signalservice.internal.push.SyncMessage.AttachmentBackfillResponse.AttachmentData;
+
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class AttachmentBackfillHelperTest {
+
+    private static final UUID AUTHOR = UUID.fromString("00000000-0000-0000-0000-0000000000a1");
+    private static final long TIMESTAMP = 1_700_000_000_000L;
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private AttachmentBackfillStore store;
+    private final List<SyncMessage.AttachmentBackfillRequest> sentRequests = new ArrayList<>();
+    private final Map<String, org.whispersystems.signalservice.api.messages.SignalServiceAttachmentPointer> storedPointers =
+            new HashMap<>();
+    private final List<AttachmentBackfillResult> notifications = new ArrayList<>();
+    private AttachmentBackfillHelper helper;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new AttachmentBackfillStore(database);
+        helper = new AttachmentBackfillHelper(store, sentRequests::add, storedPointers::put);
+        helper.addListener(notifications::add);
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    /** Complete enough for {@code AttachmentPointerUtil.createSignalAttachmentPointer} to accept. */
+    private static AttachmentPointer downloadablePointer(final long cdnId) {
+        return new AttachmentPointer.Builder().cdnId(cdnId)
+                .cdnNumber(2)
+                .key(ByteString.of((byte) 1, (byte) 2, (byte) 3))
+                .contentType("image/jpeg")
+                .fileName("photo.jpg")
+                .uploadTimestamp(42L)
+                .digest(ByteString.of((byte) 4, (byte) 5))
+                .size(100)
+                .build();
+    }
+
+    private static AttachmentBackfillResponseBuilder response() {
+        return new AttachmentBackfillResponseBuilder();
+    }
+
+    /** Small fluent wrapper so each test's response shape reads as what it's asserting about. */
+    private static final class AttachmentBackfillResponseBuilder {
+
+        private final List<AttachmentData> items = new ArrayList<>();
+        private SyncMessage.AttachmentBackfillResponse.Error error;
+
+        AttachmentBackfillResponseBuilder withPointer(final long cdnId) {
+            items.add(new AttachmentData.Builder().attachment(downloadablePointer(cdnId)).build());
+            return this;
+        }
+
+        AttachmentBackfillResponseBuilder withPending() {
+            items.add(new AttachmentData.Builder().status(AttachmentData.Status.PENDING).build());
+            return this;
+        }
+
+        AttachmentBackfillResponseBuilder withTerminalError() {
+            items.add(new AttachmentData.Builder().status(AttachmentData.Status.TERMINAL_ERROR).build());
+            return this;
+        }
+
+        AttachmentBackfillResponseBuilder notFound() {
+            this.error = SyncMessage.AttachmentBackfillResponse.Error.MESSAGE_NOT_FOUND;
+            return this;
+        }
+
+        SyncMessage.AttachmentBackfillResponse build() {
+            final var builder = new SyncMessage.AttachmentBackfillResponse.Builder().targetMessage(
+                    new AddressableMessage.Builder().authorServiceId(AUTHOR.toString()).sentTimestamp(TIMESTAMP).build());
+            if (error != null) {
+                return builder.error(error).build();
+            }
+            return builder.attachments(new SyncMessage.AttachmentBackfillResponse.AttachmentDataList.Builder()
+                    .attachments(items)
+                    .build()).build();
+        }
+    }
+
+    @Test
+    void sendsANewRequestAndTracksItAsPending() {
+        final var accepted = helper.request(new RecipientIdentifier.Uuid(UUID.randomUUID()),
+                new RecipientIdentifier.Uuid(AUTHOR),
+                TIMESTAMP,
+                List.of("att-1.jpg", "att-2.jpg"));
+
+        assertTrue(accepted);
+        assertEquals(1, sentRequests.size());
+        assertTrue(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void coalescesARepeatedRequestForTheSameMessage() {
+        final var conversation = new RecipientIdentifier.Group(GroupId.unknownVersion(new byte[]{1, 2, 3}));
+        final var author = new RecipientIdentifier.Uuid(AUTHOR);
+
+        final var first = helper.request(conversation, author, TIMESTAMP, List.of("att-1.jpg"));
+        final var second = helper.request(conversation, author, TIMESTAMP, List.of("att-1.jpg"));
+
+        assertTrue(first);
+        assertFalse(second);
+        assertEquals(1, sentRequests.size());
+    }
+
+    @Test
+    void responseMapsPointersBackOntoAttachmentIdsByIndex() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg", "att-2.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID,
+                response().withPointer(11).withPointer(22).build());
+
+        assertEquals(2, storedPointers.size());
+        assertTrue(storedPointers.containsKey("att-1.jpg"));
+        assertTrue(storedPointers.containsKey("att-2.jpg"));
+        assertEquals(1, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.READY, notifications.get(0).status());
+        assertFalse(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void pendingResponseIsFollowedByAReadyOne() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg", "att-2.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID,
+                response().withPointer(11).withPending().build());
+
+        assertEquals(1, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.PENDING, notifications.get(0).status());
+        // One attachment already resolved even while the other is still pending.
+        assertEquals(1, storedPointers.size());
+        assertTrue(storedPointers.containsKey("att-1.jpg"));
+        // The request is kept: a later response for the same message is still expected.
+        assertTrue(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID,
+                response().withPointer(11).withPointer(22).build());
+
+        assertEquals(2, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.READY, notifications.get(1).status());
+        assertEquals(2, storedPointers.size());
+        assertFalse(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void terminalErrorResolvesWithoutStoringThatAttachment() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg", "att-2.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID,
+                response().withPointer(11).withTerminalError().build());
+
+        assertEquals(1, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.READY, notifications.get(0).status());
+        assertEquals(1, storedPointers.size());
+        assertTrue(storedPointers.containsKey("att-1.jpg"));
+        assertFalse(storedPointers.containsKey("att-2.jpg"));
+    }
+
+    @Test
+    void messageNotFoundFails() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID, response().notFound().build());
+
+        assertEquals(1, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.FAILED, notifications.get(0).status());
+        assertTrue(storedPointers.isEmpty());
+        assertFalse(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void mismatchedAttachmentCountFails() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg", "att-2.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID, response().withPointer(11).build());
+
+        assertEquals(1, notifications.size());
+        assertEquals(AttachmentBackfillResult.Status.FAILED, notifications.get(0).status());
+        assertTrue(storedPointers.isEmpty());
+        assertFalse(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void responseFromAForeignDeviceIsIgnored() {
+        store.store(AUTHOR.toString(), TIMESTAMP, List.of("att-1.jpg"));
+
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID + 1, response().withPointer(11).build());
+
+        assertTrue(notifications.isEmpty());
+        assertTrue(storedPointers.isEmpty());
+        // Still pending: a genuine answer from the primary may still arrive.
+        assertTrue(store.get(AUTHOR.toString(), TIMESTAMP).isPresent());
+    }
+
+    @Test
+    void responseForAnUnknownRequestIsIgnored() {
+        helper.handleResponse(SignalServiceAddress.DEFAULT_DEVICE_ID, response().withPointer(11).build());
+
+        assertTrue(notifications.isEmpty());
+        assertTrue(storedPointers.isEmpty());
+    }
+}
