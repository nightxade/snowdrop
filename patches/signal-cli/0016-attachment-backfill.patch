+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.storage;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class AttachmentBackfillStoreTest {
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private AttachmentBackfillStore store;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new AttachmentBackfillStore(database);
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    @Test
+    void roundTripsAPendingRequest() {
+        store.store("author-1", 1000L, List.of("att-1.jpg", "att-2.jpg"));
+
+        final var pending = store.get("author-1", 1000L);
+
+        assertTrue(pending.isPresent());
+        assertEquals(List.of("att-1.jpg", "att-2.jpg"), pending.get().attachmentIds());
+    }
+
+    @Test
+    void unknownRequestIsEmpty() {
+        assertFalse(store.get("author-1", 1000L).isPresent());
+    }
+
+    @Test
+    void removedRequestIsGone() {
+        store.store("author-1", 1000L, List.of("att-1.jpg"));
+
+        store.remove("author-1", 1000L);
+
+        assertFalse(store.get("author-1", 1000L).isPresent());
+    }
+
+    @Test
+    void distinguishesRequestsByAuthorAndTimestamp() {
+        store.store("author-1", 1000L, List.of("att-1.jpg"));
+        store.store("author-2", 1000L, List.of("att-2.jpg"));
+        store.store("author-1", 2000L, List.of("att-3.jpg"));
+
+        assertEquals(List.of("att-1.jpg"), store.get("author-1", 1000L).orElseThrow().attachmentIds());
+        assertEquals(List.of("att-2.jpg"), store.get("author-2", 1000L).orElseThrow().attachmentIds());
+        assertEquals(List.of("att-3.jpg"), store.get("author-1", 2000L).orElseThrow().attachmentIds());
+    }
+
+    @Test
+    void survivesAcrossDatabaseReopens() throws Exception {
+        store.store("author-1", 1000L, List.of("att-1.jpg"));
+        database.close();
+
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new AttachmentBackfillStore(database);
+
+        assertTrue(store.get("author-1", 1000L).isPresent());
+    }
+
+    @Test
+    void storingPrunesRequestsOlderThanADay() throws Exception {
+        store.store("stale-author", 1000L, List.of("att-1.jpg"));
+        try (final var connection = database.getConnection();
+                final var statement = connection.prepareStatement(
+                        "UPDATE snowdrop_attachment_backfill SET created_at = ? WHERE target_author = ?")) {
+            statement.setLong(1, System.currentTimeMillis() - TimeUnit.DAYS.toMillis(2));
+            statement.setString(2, "stale-author");
+            statement.executeUpdate();
+        }
+
+        store.store("fresh-author", 2000L, List.of("att-2.jpg"));
+
+        assertFalse(store.get("stale-author", 1000L).isPresent());
+        assertTrue(store.get("fresh-author", 2000L).isPresent());
+    }
+}
