+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+import org.asamk.signal.util.CommandUtil;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Asks our own primary device to re-upload a message's attachments (Signal's {@code
+ * SyncMessage.attachmentBackfillRequest}/{@code attachmentBackfillResponse} pair). See patches/
+ * signal-cli/README.md "0016: attachment backfill" for the full protocol and the {@code
+ * attachmentBackfill} notification this eventually produces.
+ */
+public class RequestAttachmentBackfillCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "requestAttachmentBackfill";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Ask our primary device to re-upload a message's attachments.");
+        var mut = subparser.addMutuallyExclusiveGroup().required(true);
+        mut.addArgument("--recipient").help("DM peer the message belongs to.");
+        mut.addArgument("-g", "--group-id").help("Group the message belongs to.");
+        subparser.addArgument("--target-author")
+                .required(true)
+                .help("The message's sender (ACI, PNI or phone number), as Snowdrop already knows it.");
+        subparser.addArgument("--target-timestamp")
+                .required(true)
+                .help("The message's sentTimestamp, as a decimal string.");
+        subparser.addArgument("--attachment-ids")
+                .required(true)
+                .nargs("+")
+                .help("Attachment ids to backfill, in the message's own attachment order.");
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var recipientString = ns.getString("recipient");
+        final var groupIdString = ns.getString("group-id");
+        final var targetAuthorString = ns.getString("target-author");
+        final var targetTimestampString = ns.getString("target-timestamp");
+        final List<?> rawAttachmentIds = ns.getList("attachment-ids");
+
+        if (rawAttachmentIds == null || rawAttachmentIds.isEmpty()) {
+            throw new UserErrorException("Missing attachment-ids parameter");
+        }
+        final var attachmentIds = rawAttachmentIds.stream().map(String.class::cast).toList();
+
+        final long targetTimestamp;
+        try {
+            targetTimestamp = Long.parseLong(targetTimestampString);
+        } catch (NumberFormatException | NullPointerException e) {
+            throw new UserErrorException("Invalid target-timestamp: " + targetTimestampString);
+        }
+
+        final RecipientIdentifier targetConversation = groupIdString != null
+                ? new RecipientIdentifier.Group(CommandUtil.getGroupId(groupIdString))
+                : CommandUtil.getSingleRecipientIdentifier(recipientString, m.getSelfNumber());
+        final var targetAuthor = CommandUtil.getSingleRecipientIdentifier(targetAuthorString, m.getSelfNumber());
+
+        final boolean accepted;
+        try {
+            accepted = m.requestAttachmentBackfill(targetConversation, targetAuthor, targetTimestamp, attachmentIds);
+        } catch (IllegalArgumentException e) {
+            throw new UserErrorException(e.getMessage(), e);
+        }
+
+        switch (outputWriter) {
+            case PlainTextWriter writer -> writer.println(accepted ? "Requested" : "Already pending");
+            case JsonWriter writer -> writer.write(Map.of("accepted", accepted));
+        }
+    }
+}
