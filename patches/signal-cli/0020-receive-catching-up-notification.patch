index 0000000..6563830
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/helper/ReceiveHelperCatchingUpTest.java
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.junit.jupiter.api.Test;
+import org.signal.core.util.SleepTimer;
+import org.signal.network.websocket.WebSocketRequestMessage;
+import org.whispersystems.signalservice.api.websocket.SignalWebSocket;
+import org.whispersystems.signalservice.api.websocket.WebSocketConnectionState;
+import org.whispersystems.signalservice.internal.websocket.WebSocketConnection;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import io.reactivex.rxjava3.core.Observable;
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * The catching-up listener fires once for each websocket connection, on the receive thread, after the first read
+ * from that connection returns and before anything that read produced is handled. These tests drive a real
+ * {@code SignalWebSocket.AuthenticatedWebSocket} over fake connections the way the receive loop does: read, then
+ * handle what came back.
+ */
+class ReceiveHelperCatchingUpTest {
+
+    private static final String ENVELOPE_PATH = "/api/v1/message";
+    private static final String QUEUE_EMPTY_PATH = "/api/v1/queue/empty";
+
+    private static final class FakeConnection {
+
+        final String name;
+        final LinkedBlockingQueue<WebSocketRequestMessage> queue = new LinkedBlockingQueue<>();
+        volatile boolean dead = false;
+
+        FakeConnection(final String name) {
+            this.name = name;
+        }
+
+        void queueEnvelope() {
+            queue.add(request(ENVELOPE_PATH));
+        }
+
+        void queueEmpty() {
+            queue.add(request(QUEUE_EMPTY_PATH));
+        }
+
+        private static WebSocketRequestMessage request(final String path) {
+            return new WebSocketRequestMessage.Builder().verb("PUT")
+                    .path(path)
+                    .id(1L)
+                    .body(ByteString.EMPTY)
+                    .headers(List.of("X-Signal-Timestamp: 1"))
+                    .build();
+        }
+
+        WebSocketConnection asConnection() {
+            return (WebSocketConnection) Proxy.newProxyInstance(WebSocketConnection.class.getClassLoader(),
+                    new Class<?>[]{WebSocketConnection.class},
+                    (proxy, method, args) -> switch (method.getName()) {
+                        case "getName" -> name;
+                        case "connect" -> Observable.<WebSocketConnectionState>never();
+                        case "isDead" -> dead;
+                        case "disconnect", "shutdown" -> {
+                            dead = true;
+                            yield null;
+                        }
+                        case "readRequestIfAvailable" -> Optional.ofNullable(queue.poll());
+                        case "readRequest" -> {
+                            final var next = queue.poll((Long) args[0], TimeUnit.MILLISECONDS);
+                            if (next == null) {
+                                throw new TimeoutException();
+                            }
+                            yield next;
+                        }
+                        case "hashCode" -> System.identityHashCode(proxy);
+                        case "equals" -> proxy == args[0];
+                        case "toString" -> name;
+                        default -> null;
+                    });
+        }
+    }
+
+    private static final class Harness {
+
+        final List<String> events = new ArrayList<>();
+        final List<FakeConnection> created = new ArrayList<>();
+        final List<FakeConnection> upcoming = new ArrayList<>();
+        final ReceiveHelper helper = new ReceiveHelper(new Context(null, null, null, null, null, null));
+        final SignalWebSocket.AuthenticatedWebSocket webSocket;
+
+        Harness() {
+            helper.setCatchingUpWithOldMessagesListener(() -> events.add("catchingUp"));
+            final SleepTimer timer = millis -> Thread.sleep(millis);
+            webSocket = new SignalWebSocket.AuthenticatedWebSocket(() -> {
+                final var next = upcoming.remove(0);
+                created.add(next);
+                return next.asConnection();
+            }, () -> true, timer, 30_000L);
+        }
+
+        FakeConnection nextConnection(final String name) {
+            final var connection = new FakeConnection(name);
+            upcoming.add(connection);
+            return connection;
+        }
+
+        /** One turn of the receive loop: read, then handle what the read produced. */
+        void step() throws Exception {
+            final var envelopes = new AtomicInteger();
+            final var queueNotEmpty = helper.readMessageBatch(webSocket, 100, batch -> envelopes.addAndGet(batch.size()));
+            if (queueNotEmpty) {
+                events.add("envelope");
+            } else {
+                events.add("caughtUp");
+            }
+        }
+    }
+
+    @Test
+    void catchingUpPrecedesTheFirstEnvelopeOfAConnection() throws Exception {
+        final var h = new Harness();
+        final var connection = h.nextConnection("a");
+        connection.queueEnvelope();
+        connection.queueEnvelope();
+        connection.queueEmpty();
+        h.webSocket.connect();
+
+        h.step();
+        h.step();
+        h.step();
+
+        assertEquals(List.of("catchingUp", "envelope", "envelope", "caughtUp"), h.events);
+    }
+
+    @Test
+    void aThrowingCatchingUpListenerDoesNotStrandTheEnvelope() throws Exception {
+        final var h = new Harness();
+        h.helper.setCatchingUpWithOldMessagesListener(() -> {
+            throw new IllegalStateException("listener failed");
+        });
+        final var connection = h.nextConnection("a");
+        connection.queueEnvelope();
+        connection.queueEmpty();
+        h.webSocket.connect();
+
+        h.step();
+        h.step();
+
+        assertEquals(List.of("envelope", "caughtUp"), h.events);
+    }
+
+    @Test
+    void anAssertionErrorFromAListenerStillReachesTheReceiveLoop() throws Exception {
+        final var h = new Harness();
+        h.helper.setCatchingUpWithOldMessagesListener(() -> {
+            throw new AssertionError("pipe closed");
+        });
+        h.nextConnection("a").queueEnvelope();
+        h.webSocket.connect();
+
+        org.junit.jupiter.api.Assertions.assertThrows(AssertionError.class, h::step);
+    }
+
+    @Test
+    void catchingUpPrecedesCaughtUpOnAnEmptyQueue() throws Exception {
+        final var h = new Harness();
+        h.nextConnection("a").queueEmpty();
+        h.webSocket.connect();
+
+        h.step();
+
+        assertEquals(List.of("catchingUp", "caughtUp"), h.events);
+    }
+
+    @Test
+    void firesOncePerConnectionNotPerRead() throws Exception {
+        final var h = new Harness();
+        final var connection = h.nextConnection("a");
+        for (int i = 0; i < 5; i++) {
+            connection.queueEnvelope();
+        }
+        h.webSocket.connect();
+
+        for (int i = 0; i < 5; i++) {
+            h.step();
+        }
+
+        assertEquals(1, h.events.stream().filter("catchingUp"::equals).count());
+        assertEquals("catchingUp", h.events.get(0));
+    }
+
+    @Test
+    void firesAgainBeforeTheFirstEnvelopeOfAReconnect() throws Exception {
+        final var h = new Harness();
+        final var first = h.nextConnection("a");
+        first.queueEmpty();
+        h.webSocket.connect();
+        h.step();
+        assertEquals(List.of("catchingUp", "caughtUp"), h.events);
+
+        // The connection drops; the next read is served by a new one that already has a backlog queued.
+        first.dead = true;
+        final var second = h.nextConnection("b");
+        second.queueEnvelope();
+        second.queueEmpty();
+
+        h.step();
+        h.step();
+
+        assertEquals(List.of("catchingUp", "caughtUp", "catchingUp", "envelope", "caughtUp"), h.events);
+        assertEquals(2, h.created.size());
+    }
+
+    @Test
+    void aTimedOutReadAnnouncesNothing() throws Exception {
+        final var h = new Harness();
+        h.nextConnection("a");
+        h.webSocket.connect();
+
+        try {
+            h.step();
+        } catch (TimeoutException expected) {
+            // no message within the timeout: nothing was read, so nothing is announced yet
+        }
+
+        assertTrue(h.events.isEmpty());
+    }
+
+    @Test
+    void noConnectionIsNotAnnounced() {
+        final var helper = new ReceiveHelper(new Context(null, null, null, null, null, null));
+        final var calls = new AtomicInteger();
+        helper.setCatchingUpWithOldMessagesListener(calls::incrementAndGet);
+
+        helper.announceConnection("[null]");
+        helper.announceConnection(null);
+        assertEquals(0, calls.get());
+
+        helper.announceConnection("[normal:1]");
+        helper.announceConnection("[normal:1]");
+        assertEquals(1, calls.get());
+        helper.announceConnection("[normal:2]");
+        assertEquals(2, calls.get());
+    }
+
+    @Test
+    void noListenerIsHarmless() {
+        final var helper = new ReceiveHelper(new Context(null, null, null, null, null, null));
+        assertDoesNotThrow(() -> helper.announceConnection("[normal:1]"));
+    }
+}
