+
+    @Test
+    void multiAccountNewManagerNotifiesOncePerEvent() {
+        var manager1 = createManager("+15551111111");
+        var manager2 = createManager("+15552222222");
+        var multi = new StubMultiAccountManager(List.of(manager1.manager()));
+        var writer = new CapturingJsonWriter();
+
+        Supplier<String> feeder = () -> {
+            // The account manager announces a manager that was added after the connection started.
+            multi.addedHandlers.forEach(h -> h.accept(manager2.manager()));
+            manager2.state().fireCaughtUp();
+            return null;
+        };
+
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder, false);
+        handler.handleConnection(multi);
+
+        assertEquals(1, manager2.state().addCaughtUpListenerCount.get(), "one listener on the new manager");
+        assertEquals(1, notificationsNamed(writer, "receiveCaughtUp").size(), "one notification per event");
+    }
 }
