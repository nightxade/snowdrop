diff --git a/lib/src/test/java/org/asamk/signal/manager/storage/AttachmentPointerStoreTest.java b/lib/src/test/java/org/asamk/signal/manager/storage/AttachmentPointerStoreTest.java
new file mode 100644
index 0000000..61c9ae7
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/storage/AttachmentPointerStoreTest.java
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.storage;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.whispersystems.signalservice.api.util.AttachmentPointerUtil;
+import org.whispersystems.signalservice.internal.push.AttachmentPointer;
+
+import java.nio.file.Path;
+
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class AttachmentPointerStoreTest {
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private AttachmentPointerStore store;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new AttachmentPointerStore(database);
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    /** Complete enough for {@code AttachmentPointerUtil.createSignalAttachmentPointer} to accept. */
+    private static AttachmentPointer downloadablePointer(long cdnId, long size) {
+        var builder = new AttachmentPointer.Builder().cdnId(cdnId)
+                .cdnNumber(2)
+                .key(ByteString.of((byte) 1, (byte) 2, (byte) 3))
+                .contentType("image/jpeg")
+                .fileName("photo.jpg")
+                .uploadTimestamp(42L);
+        if (size >= 0) {
+            builder.digest(ByteString.of((byte) 4, (byte) 5)).size((int) size);
+        }
+        return builder.build();
+    }
+
+    @Test
+    void roundTripsAStoredPointer() throws Exception {
+        final var pointer = AttachmentPointerUtil.createSignalAttachmentPointer(downloadablePointer(7, 123));
+
+        store.store("att-1.jpg", pointer);
+        final var retrieved = store.get("att-1.jpg");
+
+        assertTrue(retrieved.isPresent());
+        assertEquals(pointer.getRemoteId(), retrieved.get().getRemoteId());
+        assertEquals(pointer.getContentType(), retrieved.get().getContentType());
+        assertEquals(pointer.getSize(), retrieved.get().getSize());
+        assertEquals(pointer.getFileName(), retrieved.get().getFileName());
+    }
+
+    @Test
+    void unknownIdIsEmpty() {
+        assertFalse(store.get("never-seen").isPresent());
+    }
+
+    @Test
+    void overwritesAPreviouslyStoredPointerForTheSameId() throws Exception {
+        store.store("att-1.jpg", AttachmentPointerUtil.createSignalAttachmentPointer(downloadablePointer(1, 100)));
+        store.store("att-1.jpg", AttachmentPointerUtil.createSignalAttachmentPointer(downloadablePointer(2, 200)));
+
+        final var retrieved = store.get("att-1.jpg");
+
+        assertTrue(retrieved.isPresent());
+        assertEquals(200, retrieved.get().getSize().orElse(-1));
+    }
+
+    @Test
+    void skipsPersistingAPointerWithNoDigestOrSize() throws Exception {
+        final var pointer = AttachmentPointerUtil.createSignalAttachmentPointer(downloadablePointer(1, -1));
+
+        store.store("att-1.jpg", pointer);
+
+        assertFalse(store.get("att-1.jpg").isPresent());
+    }
+
+    @Test
+    void survivesAcrossDatabaseReopens() throws Exception {
+        store.store("att-1.jpg", AttachmentPointerUtil.createSignalAttachmentPointer(downloadablePointer(1, 50)));
+        database.close();
+
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new AttachmentPointerStore(database);
+
+        assertTrue(store.get("att-1.jpg").isPresent());
+    }
+}
