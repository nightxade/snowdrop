@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.storage;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.whispersystems.signalservice.api.InvalidMessageStructureException;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentPointer;
+import org.whispersystems.signalservice.api.util.AttachmentPointerUtil;
+import org.whispersystems.signalservice.internal.push.AttachmentPointer;
+
+import java.sql.SQLException;
+import java.util.Optional;
+
+/**
+ * Remembers the {@link SignalServiceAttachmentPointer} for each attachment signal-cli downloads,
+ * keyed by the same id {@code getAttachment} is called with (the downloaded file's name — see
+ * {@code AttachmentStore#getAttachmentFile}).
+ * <p>
+ * Without this, signal-cli only ever holds a pointer for the few seconds it takes to download
+ * during receive: a transient failure there (a network blip, one of the slow startup periods) —
+ * or the file being lost afterwards — left {@code getAttachment} unable to find the file and with
+ * nothing to retry, forever. {@link org.asamk.signal.manager.helper.AttachmentHelper} persists the
+ * pointer as soon as an attachment is seen (before attempting the download) and consults it to
+ * re-download on demand when the file isn't on disk.
+ * <p>
+ * Its table lives in the same account database as everything else, but — like
+ * {@code org.asamk.signal.manager.history.HistoryStore}'s {@code snowdrop_history_*} tables —
+ * outside {@link AccountDatabase}'s own versioned schema: a Snowdrop-only, {@code snowdrop_}-
+ * prefixed table created lazily with {@code CREATE TABLE IF NOT EXISTS} on first use, not gated
+ * behind a {@code DATABASE_VERSION} bump. Bumping that version would mark the database file as
+ * needing at least this signal-cli version to open (see {@code Database#initDb}'s "updated by a
+ * newer signal-cli version" check) — breaking the documented rollback to plain upstream
+ * signal-cli — and would collide with whatever version number upstream's own next schema change
+ * picks, silently skipping it on an account already marked past it.
+ */
+public class AttachmentPointerStore {
+
+    private static final Logger logger = LoggerFactory.getLogger(AttachmentPointerStore.class);
+    private static final String TABLE_ATTACHMENT_POINTER = "snowdrop_attachment_pointer";
+
+    private final Database database;
+
+    public AttachmentPointerStore(final Database database) {
+        this.database = database;
+        try (final var connection = database.getConnection(); final var statement = connection.createStatement()) {
+            statement.executeUpdate(("""
+                                     CREATE TABLE IF NOT EXISTS %s (
+                                       attachment_id TEXT PRIMARY KEY,
+                                       pointer BLOB NOT NULL
+                                     )
+                                     """).formatted(TABLE_ATTACHMENT_POINTER));
+        } catch (SQLException e) {
+            throw new RuntimeException("Failed to initialize attachment pointer storage", e);
+        }
+    }
+
+    /**
+     * Saves {@code pointer} under {@code attachmentId}, overwriting any previous pointer for the
+     * same id (e.g. a since-edited message's replacement attachment). Pointers with no digest or
+     * size are never stored: {@code AttachmentHelper} couldn't verify a re-download against them
+     * either, so there is nothing worth remembering.
+     */
+    public void store(final String attachmentId, final SignalServiceAttachmentPointer pointer) {
+        if (pointer.getDigest().isEmpty() || pointer.getSize().isEmpty()) {
+            return;
+        }
+        final byte[] bytes;
+        try {
+            bytes = AttachmentPointer.ADAPTER.encode(AttachmentPointerUtil.createAttachmentPointer(pointer));
+        } catch (RuntimeException e) {
+            logger.debug("Failed to serialize attachment pointer, not persisting it: {}", e.getMessage());
+            return;
+        }
+        final var sql = ("""
+                         INSERT INTO %s (attachment_id, pointer)
+                         VALUES (?, ?)
+                         ON CONFLICT (attachment_id) DO UPDATE SET pointer = excluded.pointer
+                         """).formatted(TABLE_ATTACHMENT_POINTER);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setString(1, attachmentId);
+            statement.setBytes(2, bytes);
+            statement.executeUpdate();
+        } catch (SQLException e) {
+            logger.warn("Failed to persist attachment pointer, ignoring: {}", e.getMessage());
+        }
+    }
+
+    /** The persisted pointer for {@code attachmentId}, if any was ever recorded. */
+    public Optional<SignalServiceAttachmentPointer> get(final String attachmentId) {
+        final var sql = ("""
+                         SELECT pointer FROM %s WHERE attachment_id = ?
+                         """).formatted(TABLE_ATTACHMENT_POINTER);
+        try (final var connection = database.getConnection(); final var statement = connection.prepareStatement(sql)) {
+            statement.setString(1, attachmentId);
+            try (final var result = statement.executeQuery()) {
+                if (!result.next()) {
+                    return Optional.empty();
+                }
+                final var proto = AttachmentPointer.ADAPTER.decode(result.getBytes("pointer"));
+                return Optional.of(AttachmentPointerUtil.createSignalAttachmentPointer(proto));
+            }
+        } catch (SQLException | java.io.IOException | InvalidMessageStructureException e) {
+            logger.warn("Failed to read persisted attachment pointer, ignoring: {}", e.getMessage());
+            return Optional.empty();
+        }
+    }
+}
