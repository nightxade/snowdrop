+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.api;
+
+import java.io.IOException;
+
+/**
+ * Thrown by {@code AttachmentHelper#retrieveAttachment(String)} when an attachment's file is
+ * missing locally and re-downloading it found the server no longer has it (the CDN returned 404
+ * or 410, typically because the attachment expired). Distinct from a plain {@link IOException} so
+ * callers — and, through the JSON-RPC error message, Snowdrop's UI — can tell "gone for good" from
+ * a transient download failure worth retrying.
+ */
+public class AttachmentNotAvailableException extends IOException {
+
+    public AttachmentNotAvailableException(String attachmentId, Throwable cause) {
+        super("Attachment is no longer available on the server: " + attachmentId, cause);
+    }
+}
