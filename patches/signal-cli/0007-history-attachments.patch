+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import java.io.IOException;
+import java.util.Optional;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import org.whispersystems.signalservice.api.crypto.AttachmentCipherInputStream.IntegrityCheck;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentPointer;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentRemoteId;
+
+/** Validated transit download parameters; never exposed by the attachment RPC. */
+public final class HistoryAttachment {
+    public static final int MAX_BYTES = 100 * 1024 * 1024;
+    public record Request(SignalServiceAttachmentPointer pointer, IntegrityCheck integrity) {}
+    @FunctionalInterface public interface Downloader {
+        java.io.InputStream open(Request request, java.io.File destination)
+                throws IOException, org.signal.libsignal.protocol.InvalidMessageException;
+    }
+    private HistoryAttachment() {}
+
+    public static Request request(Backups.FilePointer file) throws IOException {
+        var locator = file.getLocatorInfo();
+        if (!locator.hasTransitCdnKey() || locator.getTransitCdnKey().isEmpty() || !locator.hasTransitCdnNumber()) {
+            throw new IOException("This history attachment is not available from Signal's transit storage");
+        }
+        if (locator.getKey().size() != 64 || locator.getTransitCdnNumber() < 0) {
+            throw new IOException("Invalid history attachment key or CDN");
+        }
+        if (Integer.toUnsignedLong(locator.getSize()) > MAX_BYTES) {
+            throw new IOException("History attachments are limited to 100 MiB");
+        }
+        IntegrityCheck integrity;
+        if (locator.hasPlaintextHash() && locator.getPlaintextHash().size() == 32) {
+            integrity = IntegrityCheck.forPlaintextHash(locator.getPlaintextHash().toByteArray());
+        } else if (locator.hasEncryptedDigest() && locator.getEncryptedDigest().size() == 32) {
+            integrity = IntegrityCheck.forEncryptedDigest(locator.getEncryptedDigest().toByteArray());
+        } else {
+            throw new IOException("History attachment has no valid integrity hash");
+        }
+        var pointer = new SignalServiceAttachmentPointer(locator.getTransitCdnNumber(),
+                new SignalServiceAttachmentRemoteId.V4(locator.getTransitCdnKey()), file.getContentType(),
+                locator.getKey().toByteArray(), Optional.of(locator.getSize()), Optional.empty(),
+                file.getWidth(), file.getHeight(), Optional.empty(), Optional.empty(), 0,
+                Optional.of(file.getFileName()), false, false, false, Optional.empty(), Optional.empty(), 0L, null);
+        return new Request(pointer, integrity);
+    }
+
+    public static byte[] download(Backups.FilePointer file, Downloader downloader) throws IOException {
+        var request = request(file);
+        var temporary = org.asamk.signal.manager.util.IOUtils.createTempFile();
+        try {
+            try (var input = downloader.open(request, temporary)) {
+                var bytes = input.readNBytes(MAX_BYTES + 1);
+                if (bytes.length != request.pointer().getSize().orElseThrow()) {
+                    throw new IOException("History attachment size does not match its metadata");
+                }
+                return bytes;
+            }
+        } catch (org.signal.libsignal.protocol.InvalidMessageException e) {
+            // Kotlin's digest stream can throw this while reading, not only while opening.
+            throw new IOException("Could not verify history attachment", e);
+        } finally {
+            java.nio.file.Files.deleteIfExists(temporary.toPath());
+        }
+    }
+}
