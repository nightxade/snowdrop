+    /** Resolve an opaque UI attachment id without accepting caller-supplied keys or URLs. */
+    public Backups.FilePointer attachment(String id, long now) throws IOException {
+        var parts = id.split(":", -1);
+        if (parts.length != 5 || !parts[0].equals("history") || !parts[3].equals("attachment")) {
+            throw new IOException("Invalid history attachment id");
+        }
+        final long ordinal;
+        final int index;
+        try {
+            if (!UUID.fromString(parts[1]).toString().equals(parts[1])
+                    || !parts[2].matches("[1-9][0-9]*") || !parts[4].matches("0|[1-9][0-9]*")) {
+                throw new IllegalArgumentException();
+            }
+            ordinal = Long.parseLong(parts[2]);
+            index = Integer.parseInt(parts[4]);
+        } catch (IllegalArgumentException e) { throw new IOException("Invalid history attachment id", e); }
+        try (var connection = connections.open(); var query = connection.prepareStatement("""
+                SELECT f.frame FROM snowdrop_history_frame f JOIN snowdrop_history_meta m ON m.singleton = 1
+                WHERE m.archive_id = ? AND f.ordinal = ? AND (f.expires_at IS NULL OR f.expires_at > ?)
+                """)) {
+            query.setString(1, parts[1]);
+            query.setLong(2, ordinal);
+            query.setLong(3, now);
+            try (var rows = query.executeQuery()) {
+                if (!rows.next()) throw new IOException("History attachment is no longer available");
+                var frame = Backups.Frame.parseFrom(rows.getBytes(1));
+                if (!frame.hasChatItem() || !frame.getChatItem().hasStandardMessage()) {
+                    throw new IOException("This history message has no downloadable attachment");
+                }
+                var message = frame.getChatItem().getStandardMessage();
+                if (index >= message.getAttachmentsCount() || !message.getAttachments(index).hasPointer()) {
+                    throw new IOException("History attachment was not found");
+                }
+                return message.getAttachments(index).getPointer();
+            }
+        } catch (SQLException e) { throw new IOException("Cannot read history attachment", e); }
     }
 
