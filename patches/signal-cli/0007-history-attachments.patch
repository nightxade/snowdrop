+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import com.google.protobuf.ByteString;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryAttachmentTest {
+    @Test void decryptsBothIntegrityFormatsAndCleansUpDownloads() throws Exception {
+        var plain = new byte[] {1, 2, 3, 4};
+        var encrypted = new java.io.ByteArrayOutputStream();
+        try (var out = new org.whispersystems.signalservice.api.crypto.AttachmentCipherOutputStream(
+                new byte[64], new byte[16], encrypted)) { out.write(plain); }
+        var digest = java.security.MessageDigest.getInstance("SHA-256");
+        for (boolean plaintext : new boolean[] {true, false}) {
+            var locator = pointer().getLocatorInfo().toBuilder().clearPlaintextHash();
+            if (plaintext) locator.setPlaintextHash(ByteString.copyFrom(digest.digest(plain)));
+            else locator.setEncryptedDigest(ByteString.copyFrom(digest.digest(encrypted.toByteArray())));
+            var file = pointer().toBuilder().setLocatorInfo(locator).build();
+            var temporary = new java.util.concurrent.atomic.AtomicReference<java.io.File>();
+            HistoryAttachment.Downloader downloader = (request, target) -> {
+                temporary.set(target);
+                java.nio.file.Files.write(target.toPath(), encrypted.toByteArray());
+                try {
+                    return org.whispersystems.signalservice.api.crypto.AttachmentCipherInputStream.createForAttachment(
+                            target, plain.length, request.pointer().getKey(), request.integrity(), null, 0);
+                } catch (org.signal.libsignal.protocol.InvalidMessageException e) { throw new IOException(e); }
+            };
+            assertArrayEquals(plain, HistoryAttachment.download(file, downloader));
+            assertFalse(temporary.get().exists());
+            var wrongHash = ByteString.copyFrom(new byte[32]);
+            if (plaintext) locator.setPlaintextHash(wrongHash); else locator.setEncryptedDigest(wrongHash);
+            assertThrows(IOException.class, () -> HistoryAttachment.download(
+                    file.toBuilder().setLocatorInfo(locator).build(), downloader));
+            assertFalse(temporary.get().exists());
+        }
+    }
+
+    @TempDir Path directory;
+    private HistoryStore store() throws Exception {
+        return new HistoryStore(() -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db")));
+    }
+    private Backups.FilePointer pointer() {
+        return Backups.FilePointer.newBuilder().setContentType("image/png").setLocatorInfo(
+                Backups.FilePointer.LocatorInfo.newBuilder().setKey(ByteString.copyFrom(new byte[64]))
+                        .setPlaintextHash(ByteString.copyFrom(new byte[32])).setSize(4)
+                        .setTransitCdnKey("test-key").setTransitCdnNumber(3)).build();
+    }
+    private String seed(HistoryStore store, Backups.ChatItem.Builder item) throws Exception {
+        return store.replace(v -> {
+            v.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+            v.frame(Backups.Frame.newBuilder().setRecipient(Backups.Recipient.newBuilder().setId(1)
+                    .setSelf(Backups.Self.getDefaultInstance())).build());
+            v.frame(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(2).setRecipientId(1)).build());
+            v.frame(Backups.Frame.newBuilder().setChatItem(item.setChatId(2).setAuthorId(1).setDateSent(10)).build());
+        }, 1000);
+    }
+    private Backups.ChatItem.Builder message() {
+        return Backups.ChatItem.newBuilder().setStandardMessage(Backups.StandardMessage.newBuilder()
+                .addAttachments(Backups.MessageAttachment.newBuilder().setPointer(pointer())));
+    }
+    @Test void resolvesOnlyTheCurrentSnapshotAndExactAttachment() throws Exception {
+        var store = store();
+        var snapshot = seed(store, message());
+        var id = "history:" + snapshot + ":3:attachment:0";
+        assertEquals(pointer(), store.attachment(id, 1000));
+        assertThrows(IOException.class, () -> store.attachment(id.replace(":0", ":1"), 1000));
+        assertThrows(IOException.class, () -> store.attachment(id.replace(":attachment:", ":revision:"), 1000));
+        seed(store, message());
+        assertThrows(IOException.class, () -> store.attachment(id, 1000));
+    }
+    @Test void expiredDeletedAndViewOnceAttachmentsCannotBeRetrieved() throws Exception {
+        var store = store();
+        var snapshot = seed(store, message().setExpireStartDate(1000).setExpiresInMs(10));
+        assertThrows(IOException.class, () -> store.attachment("history:" + snapshot + ":3:attachment:0", 1010));
+        for (var item : new Backups.ChatItem.Builder[] {
+            Backups.ChatItem.newBuilder().setRemoteDeletedMessage(Backups.RemoteDeletedMessage.getDefaultInstance()).addRevisions(message()),
+            Backups.ChatItem.newBuilder().setViewOnceMessage(Backups.ViewOnceMessage.newBuilder()
+                    .setAttachment(Backups.MessageAttachment.newBuilder().setPointer(pointer())))
+        }) {
+            var current = seed(store, item);
+            assertThrows(IOException.class, () -> store.attachment("history:" + current + ":3:attachment:0", 1000));
+        }
+    }
+    @Test void validatesTransitKeysIntegrityAndSizeBeforeDownload() throws Exception {
+        var request = HistoryAttachment.request(pointer());
+        assertEquals(3, request.pointer().getCdnNumber());
+        assertEquals(4, request.pointer().getSize().orElseThrow());
+        for (var locator : new Backups.FilePointer.LocatorInfo.Builder[] {
+            pointer().getLocatorInfo().toBuilder().clearKey(),
+            pointer().getLocatorInfo().toBuilder().clearPlaintextHash(),
+            pointer().getLocatorInfo().toBuilder().clearTransitCdnKey(),
+            pointer().getLocatorInfo().toBuilder().setSize(-1)
+        }) {
+            assertThrows(IOException.class, () -> HistoryAttachment.request(pointer().toBuilder().setLocatorInfo(locator).build()));
+        }
+        assertNotNull(HistoryAttachment.request(pointer().toBuilder().setLocatorInfo(pointer().getLocatorInfo()
+                .toBuilder().clearPlaintextHash().setEncryptedDigest(ByteString.copyFrom(new byte[32]))).build()));
+    }
+}
