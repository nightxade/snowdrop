+    public byte[] retrieveHistoryAttachment(org.thoughtcrime.securesms.backup.v2.proto.Backups.FilePointer file) throws IOException {
+        return org.asamk.signal.manager.history.HistoryAttachment.download(file, (request, temporary) -> {
+            try {
+                return dependencies.getMessageReceiver().retrieveAttachment(request.pointer(), temporary,
+                        ServiceConfig.MAX_ATTACHMENT_SIZE, request.integrity());
+            } catch (MissingConfigurationException | InvalidMessageException e) {
+                throw new IOException("Could not verify history attachment", e);
+            }
+        });
+    }
