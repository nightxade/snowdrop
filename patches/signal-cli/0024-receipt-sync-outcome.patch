@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.api;
+
+/**
+ * Snowdrop: what became of the read/viewed sync message sent to the account's own other
+ * devices. {@link #json()} is the value of the {@code sync} field in {@code sendReceipt}'s
+ * JSON-RPC response.
+ */
+public enum ReceiptSyncOutcome {
+    SUCCESS("success"),
+    NETWORK("network"),
+    IDENTITY("identity"),
+    UNREGISTERED("unregistered"),
+    RATE_LIMIT("rate-limit"),
+    PROOF_REQUIRED("proof-required"),
+    SKIPPED_NO_ACI("skipped-no-aci"),
+    SKIPPED_SINGLE_DEVICE("skipped-single-device"),
+    ERROR("error");
+
+    private final String json;
+
+    ReceiptSyncOutcome(final String json) {
+        this.json = json;
+    }
+
+    public String json() {
+        return json;
+    }
+
+    public boolean isSuccess() {
+        return this == SUCCESS;
+    }
+
+    /** Classifies the result of sending the sync message. A missing result is an error. */
+    public static ReceiptSyncOutcome from(
+            final org.whispersystems.signalservice.api.messages.SendMessageResult result
+    ) {
+        if (result == null) {
+            return ERROR;
+        }
+        if (result.isSuccess()) {
+            return SUCCESS;
+        }
+        if (result.getProofRequiredFailure() != null) {
+            return PROOF_REQUIRED;
+        }
+        if (result.getRateLimitFailure() != null) {
+            return RATE_LIMIT;
+        }
+        if (result.getIdentityFailure() != null) {
+            return IDENTITY;
+        }
+        if (result.isUnregisteredFailure()) {
+            return UNREGISTERED;
+        }
+        if (result.isNetworkFailure()) {
+            return NETWORK;
+        }
+        return ERROR;
+    }
+}
