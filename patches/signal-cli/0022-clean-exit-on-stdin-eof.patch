@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+/**
+ * What happens on the way out of the process after stdin closes (snowdrop-history patch 0022).
+ * Snowdrop stops signal-cli by closing its stdin; the command then returns, its managers are closed,
+ * and Main exits. A GraalVM native image aborts that exit when the exiting thread is interrupted.
+ */
+class ShutdownTest {
+
+    @Test
+    void completingTheShutdownClearsThePendingInterrupt() {
+        Thread.currentThread().interrupt();
+        try {
+            Shutdown.shutdownComplete();
+            assertFalse(Thread.currentThread().isInterrupted(),
+                    "the thread that calls System.exit next must not be left interrupted");
+        } finally {
+            Thread.interrupted();
+        }
+    }
+
+    @Test
+    void theJvmShutdownHookDoesNotRunTheListenersOnceTheCommandHasFinished() {
+        final var listenerRan = new AtomicBoolean();
+        Shutdown.shutdownComplete();
+        Shutdown.registerShutdownListener(() -> listenerRan.set(true));
+
+        Shutdown.onJvmShutdown();
+
+        assertFalse(listenerRan.get(), "listeners interrupt the exiting thread, so they must not run on a normal exit");
+    }
+}
