@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.SendMessageResults;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SendReceiptCommandTest {
+
+    private static final String SENDER = "11111111-1111-1111-1111-111111111111";
+
+    private static Manager recordingManager(final List<String> calls) {
+        return (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(),
+                new Class<?>[]{Manager.class},
+                (proxy, method, args) -> {
+                    switch (method.getName()) {
+                        case "getSelfNumber":
+                            return "+15550000000";
+                        case "syncReceiptToOwnDevices":
+                            calls.add("sync:" + args[1] + ":" + args[2]);
+                            return true;
+                        case "sendReadReceipt":
+                            calls.add("read:" + args[1]);
+                            return new SendMessageResults(1, Map.of());
+                        case "sendViewedReceipt":
+                            calls.add("viewed:" + args[1]);
+                            return new SendMessageResults(1, Map.of());
+                        default:
+                            throw new AssertionError("unexpected call " + method.getName());
+                    }
+                });
+    }
+
+    private static Map<String, Object> args(final Object syncOnly, final String type) {
+        final var map = new HashMap<String, Object>();
+        map.put("recipient", SENDER);
+        map.put("targetTimestamp", List.of(7L, 8L));
+        map.put("type", type);
+        map.put("syncOnly", syncOnly);
+        return map;
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void syncOnlySyncsToOwnDevicesAndSendsNoReceipt() throws Exception {
+        final var calls = new ArrayList<String>();
+        final var output = new AtomicReference<Object>();
+        new SendReceiptCommand().handleCommand(args(true, "read"), recordingManager(calls), output::set);
+
+        assertEquals(List.of("sync:[7, 8]:false"), calls);
+        final var json = (Map<String, Object>) output.get();
+        assertTrue(((List<Object>) json.get("results")).isEmpty());
+    }
+
+    @Test
+    void syncOnlyKeepsTheViewedType() throws Exception {
+        final var calls = new ArrayList<String>();
+        new SendReceiptCommand().handleCommand(args(true, "viewed"), recordingManager(calls), o -> {});
+        assertEquals(List.of("sync:[7, 8]:true"), calls);
+    }
+
+    @Test
+    void withoutTheFlagItIsTheNormalReceipt() throws Exception {
+        final var calls = new ArrayList<String>();
+        new SendReceiptCommand().handleCommand(args(null, "read"), recordingManager(calls), o -> {});
+        new SendReceiptCommand().handleCommand(args(false, null), recordingManager(calls), o -> {});
+        assertEquals(List.of("read:[7, 8]", "read:[7, 8]"), calls);
+    }
+
+    @Test
+    void syncOnlyRejectsAnUnknownType() {
+        final var calls = new ArrayList<String>();
+        assertThrows(UserErrorException.class,
+                () -> new SendReceiptCommand().handleCommand(args(true, "bogus"), recordingManager(calls), o -> {}));
+        assertTrue(calls.isEmpty());
+    }
+
+}
