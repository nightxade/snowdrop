+    @Override
+    public boolean syncReceiptToOwnDevices(
+            final RecipientIdentifier.Single sender,
+            final List<Long> messageIds,
+            final boolean viewed
+    ) {
+        final var type = viewed
+                ? SignalServiceReceiptMessage.Type.VIEWED
+                : SignalServiceReceiptMessage.Type.READ;
+        final var receiptMessage = new SignalServiceReceiptMessage(type, messageIds, getNextMessageTimestamp());
+        try {
+            final var recipientId = context.getRecipientHelper().resolveRecipient(sender);
+            final var aci = account.getRecipientAddressResolver().resolveRecipientAddress(recipientId).aci();
+            if (aci.isEmpty()) {
+                return false;
+            }
+            context.getSyncHelper().sendSyncReceiptMessage(aci.get(), receiptMessage);
+            return true;
+        } catch (UnregisteredRecipientException e) {
+            return false;
+        }
+    }
