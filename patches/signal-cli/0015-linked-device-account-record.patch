+    /**
+     * A linked device builds its "local" AccountRecord baseline from whatever it last decoded off
+     * the wire (see StorageSyncModels#localToRemoteRecord), which can be stale or missing the
+     * username/usernameLink entirely. AccountRecordProcessor#merge must still always prefer
+     * remote's username/usernameLink, and must never drop fields it doesn't know about (simulated
+     * here with a hand-crafted unknown field) when producing the record it re-uploads. When local
+     * disagrees only in ways a linked device is allowed to disagree, the merged record should be
+     * byte-identical to remote, so AccountRecordProcessor#merge returns the remote record unchanged
+     * and no write to the storage service happens at all.
+     */
+    @Test
+    void mergeKeepsRemoteUsernameAndUnknownFieldsAndNeedsNoWriteOnFreshLink() throws IOException {
+        final var usernameLink = new AccountRecord.UsernameLink.Builder().entropy(ByteString.of(new byte[32]))
+                .serverId(ByteString.of(new byte[16]))
+                .color(AccountRecord.UsernameLink.Color.BLUE)
+                .build();
+        final var remoteBase = new AccountRecord.Builder().username("alice.01")
+                .usernameLink(usernameLink)
+                .givenName("Alice")
+                .readReceipts(true)
+                .build();
+        // Simulate a field a future Signal client set that this schema doesn't know about yet.
+        final var remote = AccountRecord.ADAPTER.decode(concat(ByteString.of(remoteBase.encode()),
+                unknownVarintField(9999, 42)));
+        assertFalse(remote.unknownFields().equals(ByteString.EMPTY), "Test fixture should carry an unknown field");
+
+        // A linked device that never learned the real username/link locally (e.g. the self
+        // recipient row was never refreshed) and otherwise has only default field values.
+        final var local = new AccountRecord.Builder().build();
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local);
+
+        assertArrayEquals(remote.encode(), merged.encode(), "Merged record must be byte-identical to remote");
+        assertEquals("alice.01", merged.username);
+        assertEquals(usernameLink, merged.usernameLink);
+        assertEquals(remote.unknownFields(), merged.unknownFields());
+        assertTrue(AccountRecordProcessor.doProtosMatch(merged, remote),
+                "A fresh link must not trigger any write: merged must match remote exactly");
+    }
+
+    /**
+     * Even when local legitimately contributes a field remote left unset (a normal, intended
+     * merge), remote's username/usernameLink and unknown fields must still win untouched.
+     */
