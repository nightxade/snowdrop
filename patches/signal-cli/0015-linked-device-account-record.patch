+                .build(); // no givenName/familyName set remotely
+        final var remote = AccountRecord.ADAPTER.decode(concat(ByteString.of(remoteBase.encode()),
+                unknownVarintField(9999, 7)));
+
+        final var local = new AccountRecord.Builder().givenName("Bob")
+                .familyName("Local")
+                .username("") // stale/never-learned locally; must not win
+                .build();
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local);
+
+        assertEquals("Bob", merged.givenName);
+        assertEquals("Local", merged.familyName);
+        assertEquals("bob.42", merged.username);
+        assertEquals(usernameLink, merged.usernameLink);
+        assertEquals(remote.unknownFields(), merged.unknownFields());
+        assertFalse(AccountRecordProcessor.doProtosMatch(merged, remote),
