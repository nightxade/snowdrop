+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.history.HistoryStore;
+import org.junit.jupiter.api.Test;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ReadHistoryCommandTest {
+    @Test void routesExactCursorsAndRejectsNumericJsonValues() throws Exception {
+        var expected = List.of(new HistoryStore.ReadState("9007199254740993", "5000", false));
+        var manager = (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(), new Class<?>[]{Manager.class}, (proxy, method, args) -> {
+            assertEquals("readHistory", method.getName());
+            assertArrayEquals(new Object[]{"snapshot", List.of(9007199254740993L)}, args);
+            return expected;
+        });
+        var output = new AtomicReference<Object>();
+        new ReadHistoryCommand().handleCommand(Map.of("archiveId", "snapshot", "cursors", List.of("9007199254740993")), manager, output::set);
+        assertEquals(expected, output.get());
+        assertThrows(UserErrorException.class, () -> new ReadHistoryCommand().handleCommand(
+                Map.of("archiveId", "snapshot", "cursors", List.of(9007199254740993L)), manager, output::set));
+    }
+}
