+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.IOErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Local read state only: no network read receipts are sent by this command. */
+public class ReadHistoryCommand implements JsonRpcLocalCommand {
+    @Override public String getName() { return "readHistory"; }
+    @Override public void attachToSubparser(Subparser parser) {
+        parser.help("Mark viewed archive messages read and start their disappearing timers.");
+        parser.addArgument("--archive-id").required(true).help("Snapshot id returned by getHistoryDirectory.");
+        parser.addArgument("--cursors").required(true).nargs("+").help("1..500 archive message cursors, as decimal strings.");
+    }
+    @Override public void handleCommand(Namespace ns, Manager manager, OutputWriter output) throws CommandException {
+        try {
+            List<?> values = ns.getList("cursors");
+            if (values == null || values.isEmpty() || values.size() > 500) throw new IllegalArgumentException("Expected 1..500 cursors");
+            var cursors = new ArrayList<Long>();
+            for (var value : values) {
+                if (!(value instanceof String text) || !text.matches("[1-9][0-9]*")) {
+                    throw new IllegalArgumentException("Cursors must be positive decimal strings");
+                }
+                cursors.add(Long.parseLong(text));
+            }
+            var states = manager.readHistory(ns.getString("archive-id"), cursors);
+            switch (output) {
+                case JsonWriter writer -> writer.write(states);
+                case PlainTextWriter writer -> {
+                    for (var state : states) writer.println("{} Expires: {} Unavailable: {}",
+                            state.cursor(), state.expiresAt(), state.unavailable());
+                }
+            }
+        } catch (IllegalArgumentException e) {
+            throw new UserErrorException("Invalid history read: " + e.getMessage(), e);
+        } catch (IOException e) {
+            throw new IOErrorException("History read failed: " + e.getMessage(), e);
+        }
+    }
+}
