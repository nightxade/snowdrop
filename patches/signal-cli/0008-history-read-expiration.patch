+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import java.util.List;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryReadTest {
+    @TempDir Path directory;
+    private HistoryStore store() throws Exception {
+        return new HistoryStore(() -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db")));
+    }
+    private String seed(HistoryStore store) throws Exception {
+        return store.replace(v -> {
+            v.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+            v.frame(Backups.Frame.newBuilder().setRecipient(Backups.Recipient.newBuilder().setId(1)
+                    .setSelf(Backups.Self.getDefaultInstance())).build());
+            v.frame(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(2).setRecipientId(1)).build());
+            for (int n = 0; n < 2; n++) {
+                v.frame(Backups.Frame.newBuilder().setChatItem(Backups.ChatItem.newBuilder()
+                        .setChatId(2).setAuthorId(1).setDateSent(10 + n).setExpiresInMs(100)
+                        .setIncoming(Backups.ChatItem.IncomingMessageDetails.getDefaultInstance())
+                        .setStandardMessage(Backups.StandardMessage.newBuilder()
+                                .setText(Backups.Text.newBuilder().setBody("timer")))).build());
+            }
+        }, 1000);
+    }
+    @Test void startsOnReadAndNeverRestartsAfterReload() throws Exception {
+        var store = store();
+        var snapshot = seed(store);
+        assertEquals("1100", store.read(snapshot, List.of(3L), 1000).getFirst().expiresAt());
+        assertEquals("1100", store().read(snapshot, List.of(3L), 1050).getFirst().expiresAt());
+        var page = store.chatPage(snapshot, "2", null, 10, 1050);
+        assertTrue(page.entries().getFirst().frame().toString().contains("expireStartDate=1000"));
+        assertTrue(page.entries().getFirst().frame().toString().contains("read=true"));
+        assertEquals(1, store.chatPage(snapshot, "2", null, 10, 1100).entries().size());
+        assertTrue(store.read(snapshot, List.of(3L), 1200).getFirst().unavailable());
+        assertEquals(1, store.chatPage(snapshot, "2", null, 10, 1200).entries().size());
+    }
+    @Test void rejectsSnapshotReplacementAndRollsBackInvalidBatch() throws Exception {
+        var store = store();
+        var snapshot = seed(store);
+        assertThrows(IOException.class, () -> store.read(snapshot, List.of(3L, 1L), 1000));
+        assertEquals("1200", store.read(snapshot, List.of(3L), 1100).getFirst().expiresAt());
+        seed(store);
+        assertThrows(IOException.class, () -> store.read(snapshot, List.of(4L), 1000));
+        assertThrows(IllegalArgumentException.class, () -> store.read(null, List.of(4L), 1000));
+        assertThrows(IllegalArgumentException.class, () -> store.read(snapshot, List.of(-1L), 1000));
+    }
+}
