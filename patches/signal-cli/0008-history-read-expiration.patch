+    public List<ReadState> read(String archiveId, List<Long> cursors, long now) throws IOException {
+        if (archiveId == null || archiveId.isBlank() || cursors == null || cursors.isEmpty()
+                || cursors.size() > 500 || now <= 0
+                || cursors.stream().anyMatch(cursor -> cursor == null || cursor <= 0)) {
+            throw new IllegalArgumentException("History reads require a snapshot and 1..500 positive cursors");
+        }
+        try (var connection = connections.open()) {
+            connection.setAutoCommit(false);
+            try {
+                var states = HistoryRead.apply(connection, archiveId, cursors, now);
+                connection.commit();
+                return states;
+            } catch (IOException | SQLException | RuntimeException e) {
+                connection.rollback();
+                throw e;
+            }
+        } catch (SQLException e) { throw new IOException("Cannot mark history read", e); }
     }
 
