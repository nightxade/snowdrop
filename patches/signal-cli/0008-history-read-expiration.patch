+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import java.io.IOException;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.List;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+
+/** Read-time expiration persisted in the archive, so paging cannot revive it. */
+final class HistoryRead {
+    private HistoryRead() {}
+    static List<HistoryStore.ReadState> apply(Connection connection, String archiveId,
+            List<Long> cursors, long now) throws IOException, SQLException {
+        try (var query = connection.prepareStatement("SELECT archive_id FROM snowdrop_history_meta WHERE singleton = 1");
+                var rows = query.executeQuery()) {
+            if (!rows.next() || !archiveId.equals(rows.getString(1))) {
+                throw new IOException("History changed; restart pagination");
+            }
+        }
+        HistoryIndex.purge(connection, now);
+        var states = new ArrayList<HistoryStore.ReadState>();
+        try (var query = connection.prepareStatement("SELECT frame, expires_at FROM snowdrop_history_frame WHERE ordinal = ?");
+                var update = connection.prepareStatement("UPDATE snowdrop_history_frame SET frame = ?, expires_at = ? WHERE ordinal = ?")) {
+            for (long cursor : cursors) {
+                query.setLong(1, cursor);
+                try (var rows = query.executeQuery()) {
+                    if (!rows.next()) {
+                        states.add(new HistoryStore.ReadState(Long.toString(cursor), null, true));
+                        continue;
+                    }
+                    var frame = Backups.Frame.parseFrom(rows.getBytes(1));
+                    if (!frame.hasChatItem()) throw new IOException("History read cursor does not identify a message");
+                    var item = frame.getChatItem().toBuilder();
+                    Long expiresAt = rows.getObject(2) == null ? null : rows.getLong(2);
+                    long duration = item.getExpiresInMs();
+                    if (duration < 0) throw new IOException("Invalid history expiration duration");
+                    if (duration > 0 && item.getExpireStartDate() == 0) {
+                        try { expiresAt = Math.addExact(now, duration); }
+                        catch (ArithmeticException e) { throw new IOException("Invalid history expiration", e); }
+                        item.setExpireStartDate(now);
+                    }
+                    if (item.hasIncoming()) item.setIncoming(item.getIncoming().toBuilder().setRead(true));
+                    update.setBytes(1, frame.toBuilder().setChatItem(item).build().toByteArray());
+                    update.setObject(2, expiresAt);
+                    update.setLong(3, cursor);
+                    update.executeUpdate();
+                    states.add(new HistoryStore.ReadState(Long.toString(cursor),
+                            expiresAt == null ? null : Long.toString(expiresAt), false));
+                }
+            }
+        }
+        return List.copyOf(states);
+    }
+}
