+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Rebuildable query indexes. Original protobuf frames remain the source of truth. */
+final class HistoryIndex {
+    private HistoryIndex() {}
+
+    static void initialize(Statement statement) throws SQLException {
+        statement.executeUpdate("""
+            CREATE TABLE IF NOT EXISTS snowdrop_history_lookup (
+              ordinal INTEGER PRIMARY KEY, kind TEXT NOT NULL, chat_id TEXT
+            )
+            """);
+        statement.executeUpdate("CREATE INDEX IF NOT EXISTS snowdrop_history_directory ON snowdrop_history_lookup(kind, ordinal)");
+        statement.executeUpdate("CREATE INDEX IF NOT EXISTS snowdrop_history_chat ON snowdrop_history_lookup(chat_id, ordinal)");
+        statement.executeUpdate("""
+            CREATE TABLE IF NOT EXISTS snowdrop_history_lookup_meta (
+              singleton INTEGER PRIMARY KEY CHECK(singleton = 1), archive_id TEXT NOT NULL
+            )
+            """);
+    }
+
+    /** Lazy migration also handles snapshots imported by earlier patch versions. */
+    private static void ensure(Connection connection, String archiveId) throws SQLException, IOException {
+        if (archiveId == null) return;
+        try (var query = connection.createStatement();
+                var rows = query.executeQuery("SELECT archive_id FROM snowdrop_history_lookup_meta WHERE singleton = 1")) {
+            if (rows.next() && archiveId.equals(rows.getString(1))) return;
+        }
+        try (var statement = connection.createStatement()) {
+            statement.executeUpdate("DELETE FROM snowdrop_history_lookup");
+            statement.executeUpdate("DELETE FROM snowdrop_history_lookup_meta");
+        }
+        try (var query = connection.createStatement();
+                var rows = query.executeQuery("SELECT ordinal, frame FROM snowdrop_history_frame ORDER BY ordinal");
+                var insert = connection.prepareStatement("INSERT INTO snowdrop_history_lookup VALUES(?, ?, ?)")) {
+            while (rows.next()) {
+                var frame = Backups.Frame.parseFrom(rows.getBytes(2));
+                insert.setLong(1, rows.getLong(1));
+                insert.setString(2, frame.hasRecipient() || frame.hasChat() ? "directory"
+                        : frame.hasChatItem() ? "message" : "other");
+                insert.setString(3, frame.hasChatItem() ? Long.toUnsignedString(frame.getChatItem().getChatId()) : null);
+                insert.executeUpdate();
+            }
+        }
+        try (var insert = connection.prepareStatement("INSERT INTO snowdrop_history_lookup_meta VALUES(1, ?)")) {
+            insert.setString(1, archiveId);
+            insert.executeUpdate();
+        }
+    }
+
+    static void purge(Connection connection, long now) throws SQLException {
+        try (var index = connection.prepareStatement("""
+                DELETE FROM snowdrop_history_lookup WHERE ordinal IN
+                (SELECT ordinal FROM snowdrop_history_frame WHERE expires_at <= ?)
+                """)) {
+            index.setLong(1, now);
+            index.executeUpdate();
+        }
+        try (var frames = connection.prepareStatement("DELETE FROM snowdrop_history_frame WHERE expires_at <= ?")) {
+            frames.setLong(1, now);
+            frames.executeUpdate();
+        }
+    }
+
+    static HistoryStore.Page page(Connection connection, String requestedArchive, long boundary,
+            String chatId, int limit, long now) throws SQLException, IOException {
+        String current = null;
+        try (var query = connection.createStatement();
+                var rows = query.executeQuery("SELECT archive_id FROM snowdrop_history_meta WHERE singleton = 1")) {
+            if (rows.next()) current = rows.getString(1);
+        }
+        if (requestedArchive != null && !requestedArchive.equals(current)) {
+            throw new IOException("History changed; restart pagination");
+        }
+        ensure(connection, current);
+        purge(connection, now);
+        boolean chat = chatId != null;
+        String sql = "SELECT f.ordinal, f.frame FROM snowdrop_history_lookup i "
+                + "JOIN snowdrop_history_frame f ON f.ordinal = i.ordinal WHERE "
+                + (chat ? "i.chat_id = ? AND i.ordinal < ? ORDER BY i.ordinal DESC LIMIT ?"
+                        : "i.kind = 'directory' AND i.ordinal > ? ORDER BY i.ordinal LIMIT ?");
+        var entries = new ArrayList<HistoryStore.Entry>();
+        boolean more = false;
+        String cursor = Long.toString(boundary);
+        try (var query = connection.prepareStatement(sql)) {
+            int param = 1;
+            if (chat) query.setString(param++, chatId);
+            query.setLong(param++, boundary);
+            query.setInt(param, limit + 1);
+            try (var rows = query.executeQuery()) {
+                while (rows.next()) {
+                    if (entries.size() == limit) { more = true; break; }
+                    cursor = Long.toString(rows.getLong(1));
+                    entries.add(new HistoryStore.Entry(cursor, HistoryJson.fields(Backups.Frame.parseFrom(rows.getBytes(2)))));
+                }
+            }
+        }
+        // Backfill callers receive the page in archive order, but continue at its oldest cursor.
+        if (chat) Collections.reverse(entries);
+        return new HistoryStore.Page(current, List.copyOf(entries), cursor, more);
+    }
+}
