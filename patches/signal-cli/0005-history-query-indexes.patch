+    public Page directoryPage(String archiveId, long after, int limit, long now) throws IOException {
+        if (after < 0 || (after > 0 && archiveId == null)) {
+            throw new IllegalArgumentException("Directory pagination requires an archiveId and a nonnegative cursor");
+        }
+        return indexedPage(archiveId, after, null, limit, now);
+    }
+
+    public Page chatPage(String archiveId, String chatId, Long before, int limit, long now) throws IOException {
+        if (chatId == null || !chatId.matches("[0-9]{1,20}")
+                || (before != null && (before < 0 || archiveId == null))) {
+            throw new IllegalArgumentException("Chat pagination requires a chat id, archiveId and a nonnegative cursor");
+        }
+        chatId = Long.toUnsignedString(Long.parseUnsignedLong(chatId));
+        return indexedPage(archiveId, before == null ? Long.MAX_VALUE : before, chatId, limit, now);
+    }
+
+    private Page indexedPage(String archiveId, long boundary, String chatId, int limit, long now) throws IOException {
+        if (limit < 1 || limit > 500) throw new IllegalArgumentException("History limit must be 1..500");
+        try (var connection = connections.open()) {
+            connection.setAutoCommit(false);
+            try {
+                var page = HistoryIndex.page(connection, archiveId, boundary, chatId, limit, now);
+                connection.commit();
+                return page;
+            } catch (IOException | SQLException | RuntimeException e) {
+                connection.rollback();
+                throw e;
+            }
+        } catch (SQLException e) { throw new IOException("Cannot query history", e); }
+    }
+
 }
