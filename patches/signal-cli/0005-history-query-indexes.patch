+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryIndexTest {
+    @TempDir Path directory;
+    private HistoryStore store() throws Exception {
+        return new HistoryStore(() -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db")));
+    }
+    private String seed(HistoryStore store) throws Exception {
+        return store.replace(v -> {
+            v.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+            v.frame(Backups.Frame.newBuilder().setAccount(Backups.AccountData.getDefaultInstance()).build());
+            v.frame(Backups.Frame.newBuilder().setRecipient(Backups.Recipient.newBuilder().setId(1)
+                    .setSelf(Backups.Self.getDefaultInstance())).build());
+            for (long chat = 2; chat <= 3; chat++) {
+                v.frame(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(chat).setRecipientId(1)).build());
+            }
+            // Interleaved conversations and sender-clock skew: archive order must survive.
+            for (long[] item : new long[][] {{2, 20}, {3, 30}, {2, 10}, {2, 40}}) {
+                v.frame(Backups.Frame.newBuilder().setChatItem(Backups.ChatItem.newBuilder()
+                        .setChatId(item[0]).setAuthorId(1).setDateSent(item[1])
+                        .setIncoming(Backups.ChatItem.IncomingMessageDetails.getDefaultInstance())
+                        .setStandardMessage(Backups.StandardMessage.newBuilder()
+                                .setText(Backups.Text.newBuilder().setBody("message " + item[1])))).build());
+            }
+        }, 1000);
+    }
+    @Test void pagesDirectoryWithoutReturningMessageBodies() throws Exception {
+        var store = store();
+        var id = seed(store);
+        var first = store.directoryPage(null, 0, 2, 1000);
+        assertEquals(id, first.archiveId());
+        assertEquals(2, first.entries().size());
+        assertTrue(first.hasMore());
+        var second = store().directoryPage(id, Long.parseLong(first.nextCursor()), 2, 1000);
+        assertEquals(1, second.entries().size());
+        assertFalse(second.hasMore());
+        assertTrue(second.entries().getFirst().frame().containsKey("chat"));
+    }
+    @Test void pagesOneChatInArchiveOrderWithoutLosingClockSkewedMessages() throws Exception {
+        var store = store();
+        var id = seed(store);
+        var newest = store.chatPage(id, "2", null, 2, 1000);
+        assertEquals(2, newest.entries().size());
+        assertTrue(newest.hasMore());
+        assertTrue(newest.entries().getFirst().frame().toString().contains("message 10"));
+        assertTrue(newest.entries().getLast().frame().toString().contains("message 40"));
+        var older = store.chatPage(id, "2", Long.parseLong(newest.nextCursor()), 2, 1000);
+        assertEquals(1, older.entries().size());
+        assertTrue(older.entries().getFirst().frame().toString().contains("message 20"));
+        assertFalse(older.hasMore());
+    }
+    @Test void replacesIndexWithSnapshotAndRejectsStaleCursors() throws Exception {
+        var store = store();
+        var old = seed(store);
+        store.directoryPage(old, 0, 10, 1000);
+        var current = seed(store);
+        assertNotEquals(old, current);
+        assertThrows(java.io.IOException.class, () -> store.directoryPage(old, 0, 10, 1000));
+        assertEquals(3, store.directoryPage(current, 0, 10, 1000).entries().size());
+        assertThrows(IllegalArgumentException.class, () -> store.chatPage(null, "2", 3L, 10, 1000));
+    }
+    @Test void purgesExpiredFramesAndTheirIndexesTogether() throws Exception {
+        var store = store();
+        var id = store.replace(v -> {
+            v.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+            v.frame(Backups.Frame.newBuilder().setRecipient(Backups.Recipient.newBuilder().setId(1)
+                    .setSelf(Backups.Self.getDefaultInstance())).build());
+            v.frame(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(2).setRecipientId(1)).build());
+            v.frame(Backups.Frame.newBuilder().setChatItem(Backups.ChatItem.newBuilder()
+                    .setChatId(2).setAuthorId(1).setDateSent(10).setExpireStartDate(1000).setExpiresInMs(100)
+                    .setStandardMessage(Backups.StandardMessage.getDefaultInstance())).build());
+        }, 1000);
+        assertEquals(1, store.chatPage(id, "2", null, 10, 1000).entries().size());
+        assertEquals(0, store.chatPage(id, "2", null, 10, 1100).entries().size());
+        try (var connection = DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db"));
+                var query = connection.createStatement();
+                var rows = query.executeQuery("SELECT COUNT(*) FROM snowdrop_history_lookup WHERE kind = 'message'")) {
+            assertTrue(rows.next());
+            assertEquals(0, rows.getInt(1));
+        }
+    }
+
+}
