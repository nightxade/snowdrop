+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import javax.crypto.Cipher;
+import javax.crypto.Mac;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.zip.GZIPOutputStream;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LinkHistoryReaderTest {
+    @TempDir Path directory;
+    private final byte[] aes = new byte[32];
+    private final byte[] mac = new byte[32];
+
+    private Path archive(byte[] plaintext) throws Exception {
+        Arrays.fill(aes, (byte) 0x42);
+        Arrays.fill(mac, (byte) 0x13);
+        var gzip = new ByteArrayOutputStream();
+        try (var out = new GZIPOutputStream(gzip)) { out.write(plaintext); }
+        // Link-and-sync pads the compressed stream before encryption.
+        gzip.write(new byte[40]);
+        byte[] iv = new byte[16];
+        var cipher = Cipher.getInstance("AES/CBC/PKCS5Padding");
+        cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(aes, "AES"), new IvParameterSpec(iv));
+        var encrypted = new ByteArrayOutputStream();
+        encrypted.write(iv);
+        encrypted.write(cipher.doFinal(gzip.toByteArray()));
+        var hmac = Mac.getInstance("HmacSHA256");
+        hmac.init(new SecretKeySpec(mac, "HmacSHA256"));
+        encrypted.write(hmac.doFinal(encrypted.toByteArray()));
+        return Files.write(directory.resolve("archive.bin"), encrypted.toByteArray());
+    }
+
+    @Test void decodesDelimitedFrames() throws Exception {
+        var file = archive(new byte[]{2, 8, 1, 3, 10, 1, 0});
+        var frames = new ArrayList<byte[]>();
+        LinkHistoryReader.read(file, aes, mac, frames::add);
+        assertEquals(2, frames.size());
+        assertArrayEquals(new byte[]{8, 1}, frames.get(0));
+        assertArrayEquals(new byte[]{10, 1, 0}, frames.get(1));
+    }
+
+    @Test void rejectsTamperingBeforeDeliveringFrames() throws Exception {
+        var file = archive(new byte[]{2, 8, 1});
+        byte[] bytes = Files.readAllBytes(file);
+        bytes[18] ^= 1;
+        Files.write(file, bytes);
+        var frames = new ArrayList<byte[]>();
+        assertThrows(IOException.class, () -> LinkHistoryReader.read(file, aes, mac, frames::add));
+        assertTrue(frames.isEmpty());
+    }
+
+    @Test void rejectsWrongMacKey() throws Exception {
+        var file = archive(new byte[]{2, 8, 1});
+        assertThrows(IOException.class, () -> LinkHistoryReader.read(file, aes, new byte[32],
+                frame -> fail("Unauthenticated plaintext")));
+    }
+
+    @Test void rejectsTruncatedFrame() throws Exception {
+        var file = archive(new byte[]{3, 8});
+        assertThrows(IOException.class, () -> LinkHistoryReader.read(file, aes, mac, frame -> fail()));
+    }
+
+    @Test void rejectsOversizedFrameBeforeAllocation() throws Exception {
+        var file = archive(new byte[]{-1, -1, -1, -1, 15});
+        assertThrows(IOException.class, () -> LinkHistoryReader.read(file, aes, mac, frame -> fail()));
+    }
+}
