 class HistoryReadTest {
+    @Test void inspectingReadStateDoesNotStartUnreadTimers() throws Exception {
+        var store = store();
+        var snapshot = seed(store);
+        var unread = store.readState(snapshot, List.of(3L, 4L), 1000);
+        assertNull(unread.getFirst().expiresAt());
+        assertFalse(unread.getFirst().unavailable());
+        store.read(snapshot, List.of(3L), 1100);
+        var recovered = store().readState(snapshot, List.of(3L, 4L), 1150);
+        assertEquals("1200", recovered.getFirst().expiresAt());
+        assertNull(recovered.getLast().expiresAt());
+        assertTrue(store.readState(snapshot, List.of(3L), 1200).getFirst().unavailable());
+    }
