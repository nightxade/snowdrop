@@ -0,0 +1,25 @@
+package org.asamk.signal.json;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+
+import org.asamk.signal.manager.api.MessageEnvelope;
+
+import io.micronaut.jsonschema.JsonSchema;
+
+/**
+ * A safety number marked verified or unverified on another device. The identity key is never included.
+ */
+@JsonSchema(title = "SyncVerified")
+record JsonSyncVerified(
+        @JsonInclude(JsonInclude.Include.NON_NULL) String destinationAci,
+        @JsonInclude(JsonInclude.Include.NON_NULL) String destinationNumber,
+        String state
+) {
+
+    static JsonSyncVerified from(MessageEnvelope.Sync.Verified verified) {
+        final var destination = verified.destination();
+        return new JsonSyncVerified(destination.aci().orElse(null),
+                destination.number().orElse(null),
+                verified.state().name());
+    }
+}
