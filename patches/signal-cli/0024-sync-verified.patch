diff --git a/src/test/java/org/asamk/signal/json/JsonSyncVerifiedTest.java b/src/test/java/org/asamk/signal/json/JsonSyncVerifiedTest.java
new file mode 100644
index 0000000..6e51f5a
--- /dev/null
+++ b/src/test/java/org/asamk/signal/json/JsonSyncVerifiedTest.java
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.json;
+
+import com.fasterxml.jackson.databind.JsonNode;
+
+import org.asamk.signal.manager.api.MessageEnvelope;
+import org.asamk.signal.manager.api.MessageEnvelope.Sync.Verified;
+import org.asamk.signal.manager.api.RecipientAddress;
+import org.asamk.signal.util.Util;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class JsonSyncVerifiedTest {
+
+    private static final String ACI = "a1b2c3d4-e5f6-7890-abcd-ef1234567890";
+
+    private static JsonNode json(Optional<Verified> verified) throws Exception {
+        final var sync = new MessageEnvelope.Sync(Optional.empty(),
+                Optional.empty(),
+                List.of(),
+                List.of(),
+                Optional.empty(),
+                Optional.empty(),
+                Optional.empty(),
+                Optional.empty(),
+                verified);
+        final var mapper = Util.createJsonObjectMapper();
+        return mapper.readTree(mapper.writeValueAsString(JsonSyncMessage.from(sync, null)));
+    }
+
+    @Test
+    void verifiedWithAciAndNumber() throws Exception {
+        final var node = json(Optional.of(new Verified(new RecipientAddress(ACI, null, "+15551234567", null),
+                Verified.State.VERIFIED)));
+
+        assertEquals("{\"verified\":{\"destinationAci\":\"" + ACI
+                + "\",\"destinationNumber\":\"+15551234567\",\"state\":\"VERIFIED\"}}", node.toString());
+    }
+
+    @Test
+    void everyStateAndAciOnly() throws Exception {
+        for (final var state : Verified.State.values()) {
+            final var node = json(Optional.of(new Verified(new RecipientAddress(ACI, null, null, null), state)));
+            final var verified = node.get("verified");
+            assertEquals(state.name(), verified.get("state").asText());
+            assertEquals(ACI, verified.get("destinationAci").asText());
+            assertFalse(verified.has("destinationNumber"));
+        }
+        assertEquals(List.of("DEFAULT", "VERIFIED", "UNVERIFIED"),
+                java.util.Arrays.stream(Verified.State.values()).map(Enum::name).toList());
+    }
+
+    @Test
+    void neverCarriesAnIdentityKey() throws Exception {
+        final var node = json(Optional.of(new Verified(new RecipientAddress(ACI, null, null, null),
+                Verified.State.UNVERIFIED)));
+
+        final var text = node.toString().toLowerCase();
+        assertFalse(text.contains("identity"));
+        assertFalse(text.contains("key"));
+        assertEquals(2, node.get("verified").size());
+    }
+
+    @Test
+    void absentWhenTheSyncHasNoVerification() throws Exception {
+        assertTrue(json(Optional.empty()).isEmpty());
+    }
+}
