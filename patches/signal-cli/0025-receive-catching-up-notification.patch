diff --git a/src/test/java/org/asamk/signal/jsonrpc/ReceiveCatchingUpNotificationTest.java b/src/test/java/org/asamk/signal/jsonrpc/ReceiveCatchingUpNotificationTest.java
new file mode 100644
index 0000000..b4bf85a
--- /dev/null
+++ b/src/test/java/org/asamk/signal/jsonrpc/ReceiveCatchingUpNotificationTest.java
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.jsonrpc;
+
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.testutil.ManagerMock;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.function.Supplier;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * The {@code receiveCatchingUp} JSON-RPC notification: sent each time the receive websocket
+ * connects and the server starts delivering what queued up meanwhile (snowdrop-history patch
+ * 0025). It has the same shape and subscription handling as {@code receiveCaughtUp}.
+ */
+class ReceiveCatchingUpNotificationTest {
+
+    private static class CapturingJsonWriter implements JsonWriter {
+
+        final List<Object> written = Collections.synchronizedList(new ArrayList<>());
+
+        @Override
+        public void write(final Object object) {
+            written.add(object);
+        }
+    }
+
+    private static List<JsonRpcRequest> notificationsNamed(final CapturingJsonWriter writer, final String method) {
+        return writer.written.stream()
+                .filter(JsonRpcRequest.class::isInstance)
+                .map(JsonRpcRequest.class::cast)
+                .filter(r -> method.equals(r.getMethod()))
+                .toList();
+    }
+
+    @Test
+    void defaultSubscriptionSendsBareAccountParamsAndCleansUp() {
+        final var state = new ManagerMock.State();
+        final var manager = ManagerMock.create("+15551234567", state);
+        final var writer = new CapturingJsonWriter();
+
+        Supplier<String> feeder = () -> {
+            state.fireCatchingUp();
+            return null;
+        };
+        new SignalJsonRpcDispatcherHandler(writer, feeder, false).handleConnection(manager);
+
+        assertEquals(1, state.addCatchingUpListenerCount.get());
+        assertEquals(1, state.removeCatchingUpListenerCount.get());
+        final var sent = notificationsNamed(writer, "receiveCatchingUp");
+        assertEquals(1, sent.size());
+        assertEquals("+15551234567", sent.get(0).getParams().get("account").asText());
+        assertNull(sent.get(0).getParams().get("subscription"));
+        assertEquals(1, sent.get(0).getParams().size());
+        assertEquals(0, notificationsNamed(writer, "receiveCaughtUp").size(), "a different notification");
+    }
+
+    @Test
+    void firesOnEveryConnect() {
+        final var state = new ManagerMock.State();
+        final var manager = ManagerMock.create("+15551234567", state);
+        final var writer = new CapturingJsonWriter();
+
+        Supplier<String> feeder = () -> {
+            state.fireCatchingUp();
+            state.fireCatchingUp();
+            return null;
+        };
+        new SignalJsonRpcDispatcherHandler(writer, feeder, false).handleConnection(manager);
+
+        assertEquals(2, notificationsNamed(writer, "receiveCatchingUp").size());
+    }
+
+    @Test
+    void explicitSubscriptionWrapsResultWithSubscriptionId() {
+        final var state = new ManagerMock.State();
+        final var manager = ManagerMock.create("+15551234567", state);
+        final var writer = new CapturingJsonWriter();
+        final var lines = new ArrayList<String>();
+        lines.add("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"subscribeReceive\"}");
+
+        Supplier<String> feeder = () -> {
+            if (!lines.isEmpty()) {
+                return lines.remove(0);
+            }
+            // subscribeReceive is handled on another thread; wait (bounded) for it to register.
+            for (var i = 0; i < 1000 && state.addCatchingUpListenerCount.get() == 0; i++) {
+                try {
+                    Thread.sleep(1);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+            }
+            state.fireCatchingUp();
+            return null;
+        };
+        new SignalJsonRpcDispatcherHandler(writer, feeder, true).handleConnection(manager);
+
+        final var sent = notificationsNamed(writer, "receiveCatchingUp");
+        assertEquals(1, sent.size());
+        assertTrue(sent.get(0).getParams().get("subscription").isInt());
+        assertEquals("+15551234567", sent.get(0).getParams().get("result").get("account").asText());
+    }
+
+    @Test
+    void notSubscribedWhenReceiveIsNotSubscribed() {
+        final var state = new ManagerMock.State();
+        final var manager = ManagerMock.create("+15551234567", state);
+        new SignalJsonRpcDispatcherHandler(new CapturingJsonWriter(), () -> null, true).handleConnection(manager);
+        assertEquals(0, state.addCatchingUpListenerCount.get());
+    }
+}
