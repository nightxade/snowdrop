index 0000000..c5a518d
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/helper/ReceiveHelperCatchingUpTest.java
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.junit.jupiter.api.Test;
+import org.whispersystems.signalservice.api.websocket.WebSocketConnectionState;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+/**
+ * The catching-up listener fires when the receive websocket reaches CONNECTED, and for no other
+ * state. The state stream is already de-duplicated (distinctUntilChanged) before it reaches
+ * the helper, so each connection fires it once.
+ */
+class ReceiveHelperCatchingUpTest {
+
+    private static ReceiveHelper helper() {
+        return new ReceiveHelper(new Context(null, null, null, null, null, null));
+    }
+
+    @Test
+    void firesOnConnectedOnly() {
+        final var helper = helper();
+        final var calls = new AtomicInteger();
+        helper.setCatchingUpWithOldMessagesListener(calls::incrementAndGet);
+
+        helper.onWebSocketStateChange(WebSocketConnectionState.CONNECTING);
+        helper.onWebSocketStateChange(WebSocketConnectionState.DISCONNECTING);
+        helper.onWebSocketStateChange(WebSocketConnectionState.DISCONNECTED);
+        helper.onWebSocketStateChange(WebSocketConnectionState.FAILED);
+        assertEquals(0, calls.get());
+
+        helper.onWebSocketStateChange(WebSocketConnectionState.CONNECTED);
+        assertEquals(1, calls.get());
+    }
+
+    @Test
+    void firesAgainOnReconnect() {
+        final var helper = helper();
+        final var calls = new AtomicInteger();
+        helper.setCatchingUpWithOldMessagesListener(calls::incrementAndGet);
+
+        helper.onWebSocketStateChange(WebSocketConnectionState.CONNECTED);
+        helper.onWebSocketStateChange(WebSocketConnectionState.DISCONNECTED);
+        helper.onWebSocketStateChange(WebSocketConnectionState.CONNECTED);
+        assertEquals(2, calls.get());
+    }
+
+    @Test
+    void noListenerIsHarmless() {
+        final var helper = helper();
+        assertDoesNotThrow(() -> helper.onWebSocketStateChange(WebSocketConnectionState.CONNECTED));
+    }
+}
