+    /** Resolve archive-local groups to the same identity used by live messages. */
+    static Map<String, Object> directoryFields(Backups.Frame frame) throws IOException {
+        var result = fields(frame);
+        if (frame.hasRecipient() && frame.getRecipient().hasGroup()) {
+            try {
+                var masterKey = new GroupMasterKey(frame.getRecipient().getGroup().getMasterKey().toByteArray());
+                var id = GroupSecretParams.deriveFromMasterKey(masterKey)
+                        .getPublicParams().getGroupIdentifier().serialize();
+                result.put("signalGroupId", Base64.getEncoder().encodeToString(id));
+            } catch (InvalidInputException e) {
+                throw new IOException("Invalid history group master key", e);
+            }
+        }
+        return result;
+    }
 
