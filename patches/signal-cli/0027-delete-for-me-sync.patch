@@ -0,0 +1,30 @@
+package org.asamk.signal.json;
+
+import org.asamk.signal.manager.api.DeleteForMeMessage;
+
+import java.util.List;
+
+import io.micronaut.jsonschema.JsonSchema;
+
+/**
+ * Messages or conversations deleted "for me" on one of our own other devices. Attachment deletes are not carried.
+ */
+@JsonSchema(title = "SyncDeleteForMe")
+record JsonSyncDeleteForMe(
+        List<JsonSyncDeleteForMeMessageDeletes> messageDeletes,
+        List<JsonSyncDeleteForMeConversationDelete> conversationDeletes,
+        List<JsonSyncDeleteForMeLocalOnlyConversationDelete> localOnlyConversationDeletes
+) {
+
+    static JsonSyncDeleteForMe from(DeleteForMeMessage deleteForMe) {
+        return new JsonSyncDeleteForMe(deleteForMe.messageDeletes()
+                .stream()
+                .map(JsonSyncDeleteForMeMessageDeletes::from)
+                .toList(),
+                deleteForMe.conversationDeletes().stream().map(JsonSyncDeleteForMeConversationDelete::from).toList(),
+                deleteForMe.localOnlyConversationDeletes()
+                        .stream()
+                        .map(JsonSyncDeleteForMeLocalOnlyConversationDelete::from)
+                        .toList());
+    }
+}
