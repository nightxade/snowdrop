diff --git a/src/test/java/org/asamk/signal/commands/SendDeleteForMeSyncCommandTest.java b/src/test/java/org/asamk/signal/commands/SendDeleteForMeSyncCommandTest.java
new file mode 100644
index 0000000..9ba34ee
--- /dev/null
+++ b/src/test/java/org/asamk/signal/commands/SendDeleteForMeSyncCommandTest.java
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.DeleteForMeTarget;
+import org.asamk.signal.manager.api.GroupId;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SendDeleteForMeSyncCommandTest {
+
+    private static final String PEER = "11111111-1111-1111-1111-111111111111";
+    private static final String AUTHOR = "22222222-2222-2222-2222-222222222222";
+    private record Call(RecipientIdentifier conversation, List<DeleteForMeTarget> messages) {}
+
+    private static Manager recordingManager(final List<Call> calls, final boolean linkedDevices) {
+        return (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(),
+                new Class<?>[]{Manager.class},
+                (proxy, method, args) -> {
+                    switch (method.getName()) {
+                        case "getSelfNumber":
+                            return "+15550000000";
+                        case "syncDeleteForMe":
+                            @SuppressWarnings("unchecked") final var messages = (List<DeleteForMeTarget>) args[1];
+                            calls.add(new Call((RecipientIdentifier) args[0], messages));
+                            return linkedDevices;
+                        default:
+                            throw new AssertionError("unexpected call " + method.getName());
+                    }
+                });
+    }
+
+    private static Map<String, Object> message(final String author, final Object timestamp) {
+        final var map = new HashMap<String, Object>();
+        map.put("author", author);
+        map.put("targetTimestamp", timestamp);
+        return map;
+    }
+
+    private static Map<String, Object> args(final String recipient, final String groupId, final Object messages) {
+        final var map = new HashMap<String, Object>();
+        map.put("recipient", recipient);
+        map.put("groupId", groupId);
+        map.put("messages", messages);
+        return map;
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void syncsEveryMessageOfADirectChat() throws Exception {
+        final var calls = new ArrayList<Call>();
+        final var output = new AtomicReference<Object>();
+        new SendDeleteForMeSyncCommand().handleCommand(args(PEER,
+                null,
+                List.of(message(AUTHOR, 1700000000123L), message("+15551234567", "42"), message(PEER, 7))),
+                recordingManager(calls, true),
+                output::set);
+
+        assertEquals(1, calls.size());
+        assertEquals(new RecipientIdentifier.Uuid(UUID.fromString(PEER)), calls.getFirst().conversation());
+        assertEquals(List.of(new DeleteForMeTarget(new RecipientIdentifier.Uuid(UUID.fromString(AUTHOR)),
+                        1700000000123L),
+                new DeleteForMeTarget(new RecipientIdentifier.Number("+15551234567"), 42L),
+                new DeleteForMeTarget(new RecipientIdentifier.Uuid(UUID.fromString(PEER)), 7L)),
+                calls.getFirst().messages());
+        assertEquals(Map.of("sent", true), output.get());
+    }
+
+    @Test
+    void aGroupIsTheConversation() throws Exception {
+        final var calls = new ArrayList<Call>();
+        final var groupId = GroupId.unknownVersion(new byte[32]);
+        new SendDeleteForMeSyncCommand().handleCommand(args(null, groupId.toBase64(), List.of(message(AUTHOR, 5L))),
+                recordingManager(calls, true),
+                o -> {});
+        assertEquals(new RecipientIdentifier.Group(groupId), calls.getFirst().conversation());
+    }
+
+    @Test
+    void reportsNotSentWhenThereIsNoOtherDevice() throws Exception {
+        final var output = new AtomicReference<Object>();
+        new SendDeleteForMeSyncCommand().handleCommand(args(PEER, null, List.of(message(AUTHOR, 5L))),
+                recordingManager(new ArrayList<>(), false),
+                output::set);
+        assertEquals(Map.of("sent", false), output.get());
+    }
+
+    @Test
+    void commandLineMessagesAreAuthorColonTimestamp() throws Exception {
+        final var targets = SendDeleteForMeSyncCommand.parseMessages(List.of(AUTHOR + ":9", "PNI:" + AUTHOR + ":10"),
+                "+15550000000");
+        assertEquals(new RecipientIdentifier.Uuid(UUID.fromString(AUTHOR)), targets.get(0).author());
+        assertEquals(9L, targets.get(0).sentTimestamp());
+        assertEquals(new RecipientIdentifier.Pni(UUID.fromString(AUTHOR)), targets.get(1).author());
+        assertEquals(10L, targets.get(1).sentTimestamp());
+    }
+
+    @Test
+    void needsExactlyOneConversation() {
+        final var calls = new ArrayList<Call>();
+        final var messages = List.of(message(AUTHOR, 5L));
+        final var command = new SendDeleteForMeSyncCommand();
+        assertThrows(UserErrorException.class,
+                () -> command.handleCommand(args(null, null, messages), recordingManager(calls, true), o -> {}));
+        assertThrows(UserErrorException.class,
+                () -> command.handleCommand(args(PEER, GroupId.unknownVersion(new byte[32]).toBase64(), messages),
+                        recordingManager(calls, true),
+                        o -> {}));
+        assertTrue(calls.isEmpty());
+    }
+
+    @Test
+    void refusesMissingOrBrokenMessages() {
+        final var calls = new ArrayList<Call>();
+        final var command = new SendDeleteForMeSyncCommand();
+        for (final Object bad : new Object[]{
+                null,
+                List.of(),
+                List.of(message(AUTHOR, null)),
+                List.of(message(AUTHOR, "abc")),
+                List.of(message(AUTHOR, -1L)),
+                List.of(message(null, 5L)),
+                List.of(message("", 5L)),
+                List.of(5),
+                List.of("nocolon"),
+        }) {
+            assertThrows(UserErrorException.class,
+                    () -> command.handleCommand(args(PEER, null, bad), recordingManager(calls, true), o -> {}),
+                    String.valueOf(bad));
+        }
+        assertTrue(calls.isEmpty());
+    }
+
+    @Test
+    void aSendFailureIsAnError() {
+        final var manager = (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(),
+                new Class<?>[]{Manager.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getSelfNumber")) {
+                        return "+15550000000";
+                    }
+                    throw new IOException("network");
+                });
+        final var error = assertThrows(Exception.class,
+                () -> new SendDeleteForMeSyncCommand().handleCommand(args(PEER, null, List.of(message(AUTHOR, 5L))),
+                        manager,
+                        o -> {}));
+        assertInstanceOf(org.asamk.signal.commands.exceptions.UnexpectedErrorException.class, error);
+    }
+
+    @Test
+    void theCommandIsRegistered() {
+        assertNotNull(Commands.getCommand("sendDeleteForMeSync"));
+    }
+}
diff --git a/src/test/java/org/asamk/signal/json/JsonSyncDeleteForMeTest.java b/src/test/java/org/asamk/signal/json/JsonSyncDeleteForMeTest.java
