@@ -0,0 +1,110 @@
+package org.asamk.signal.manager.api;
+
+import org.whispersystems.signalservice.internal.push.AddressableMessage;
+import org.whispersystems.signalservice.internal.push.ConversationIdentifier;
+import org.whispersystems.signalservice.internal.push.SyncMessage;
+import org.signal.core.models.ServiceId;
+
+import java.util.List;
+import java.util.Optional;
+
+/**
+ * A "delete for me" made on one of our own other devices ({@code SyncMessage.deleteForMe}): messages or whole
+ * conversations the user removed from that device only. Identifiers are carried as the protocol states them
+ * (service id string or E164, group id bytes) and are not resolved against the recipient store. Entries the
+ * protocol leaves incomplete (no conversation, no author, no timestamp) are dropped. Attachment deletes are not
+ * carried.
+ */
+public record DeleteForMeMessage(
+        List<MessageDeletes> messageDeletes,
+        List<ConversationDelete> conversationDeletes,
+        List<Conversation> localOnlyConversationDeletes
+) {
+
+    public record Conversation(Optional<String> serviceId, Optional<String> e164, Optional<GroupId> groupId) {
+
+        static Optional<Conversation> from(final ConversationIdentifier identifier) {
+            if (identifier == null) {
+                return Optional.empty();
+            }
+            final var serviceId = ServiceId.parseOrNull(identifier.threadServiceId, identifier.threadServiceIdBinary);
+            if (serviceId != null) {
+                return Optional.of(new Conversation(Optional.of(serviceId.toString()),
+                        Optional.empty(),
+                        Optional.empty()));
+            }
+            if (identifier.threadGroupId != null) {
+                try {
+                    return Optional.of(new Conversation(Optional.empty(),
+                            Optional.empty(),
+                            Optional.of(GroupId.unknownVersion(identifier.threadGroupId.toByteArray()))));
+                } catch (RuntimeException e) {
+                    return Optional.empty();
+                }
+            }
+            if (identifier.threadE164 != null && !identifier.threadE164.isEmpty()) {
+                return Optional.of(new Conversation(Optional.empty(),
+                        Optional.of(identifier.threadE164),
+                        Optional.empty()));
+            }
+            return Optional.empty();
+        }
+    }
+
+    public record Message(Optional<String> authorServiceId, Optional<String> authorE164, long sentTimestamp) {
+
+        static Optional<Message> from(final AddressableMessage message) {
+            if (message == null || message.sentTimestamp == null) {
+                return Optional.empty();
+            }
+            final var serviceId = ServiceId.parseOrNull(message.authorServiceId, message.authorServiceIdBinary);
+            if (serviceId != null) {
+                return Optional.of(new Message(Optional.of(serviceId.toString()),
+                        Optional.empty(),
+                        message.sentTimestamp));
+            }
+            if (message.authorE164 != null && !message.authorE164.isEmpty()) {
+                return Optional.of(new Message(Optional.empty(), Optional.of(message.authorE164), message.sentTimestamp));
+            }
+            return Optional.empty();
+        }
+    }
+
+    public record MessageDeletes(Conversation conversation, List<Message> messages) {}
+
+    public record ConversationDelete(
+            Conversation conversation,
+            List<Message> mostRecentMessages,
+            List<Message> mostRecentNonExpiringMessages,
+            boolean isFullDelete
+    ) {}
+
+    public static DeleteForMeMessage from(final SyncMessage.DeleteForMe deleteForMe) {
+        final var messageDeletes = deleteForMe.messageDeletes.stream().<MessageDeletes>mapMulti((d, out) -> {
+            final var conversation = Conversation.from(d.conversation);
+            final var messages = messages(d.messages);
+            if (conversation.isPresent() && !messages.isEmpty()) {
+                out.accept(new MessageDeletes(conversation.get(), messages));
+            }
+        }).toList();
+        final var conversationDeletes = deleteForMe.conversationDeletes.stream().<ConversationDelete>mapMulti((d, out) -> {
+            final var conversation = Conversation.from(d.conversation);
+            final var recent = messages(d.mostRecentMessages);
+            final var nonExpiring = messages(d.mostRecentNonExpiringMessages);
+            final var full = Boolean.TRUE.equals(d.isFullDelete);
+            // A delete that names no message and is not a full delete clears nothing.
+            if (conversation.isPresent() && (full || !recent.isEmpty() || !nonExpiring.isEmpty())) {
+                out.accept(new ConversationDelete(conversation.get(), recent, nonExpiring, full));
+            }
+        }).toList();
+        final var localOnly = deleteForMe.localOnlyConversationDeletes.stream()
+                .map(d -> Conversation.from(d.conversation))
+                .flatMap(Optional::stream)
+                .toList();
+        return new DeleteForMeMessage(messageDeletes, conversationDeletes, localOnly);
+    }
+
+    private static List<Message> messages(final List<AddressableMessage> messages) {
+        return messages.stream().map(Message::from).flatMap(Optional::stream).toList();
+    }
+}
