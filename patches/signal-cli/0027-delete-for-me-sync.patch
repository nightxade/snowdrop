@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.UnexpectedErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.DeleteForMeTarget;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+import org.asamk.signal.util.CommandUtil;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Tells our own other devices that messages were deleted here only ("delete for me"): one {@code
+ * SyncMessage.deleteForMe} with one {@code MessageDeletes} entry for one conversation. Over JSON-RPC the messages are
+ * a list of {@code {author, targetTimestamp}}; on the command line each one is {@code AUTHOR:TIMESTAMP}. See
+ * patches/signal-cli/README.md "0027: delete for me".
+ */
+public class SendDeleteForMeSyncCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "sendDeleteForMeSync";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Tell our other devices that messages were deleted here only (delete for me).");
+        var mut = subparser.addMutuallyExclusiveGroup().required(true);
+        mut.addArgument("--recipient").help("DM peer the messages belong to.");
+        mut.addArgument("-g", "--group-id").help("Group the messages belong to.");
+        subparser.addArgument("--message")
+                .required(true)
+                .nargs("+")
+                .help("A message to delete, as AUTHOR:SENT_TIMESTAMP (author is an ACI, PNI or phone number).");
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var recipientString = ns.getString("recipient");
+        final var groupIdString = ns.getString("group-id");
+        if ((recipientString == null) == (groupIdString == null)) {
+            throw new UserErrorException("Specify exactly one of recipient and group-id");
+        }
+        final RecipientIdentifier conversation = groupIdString != null
+                ? new RecipientIdentifier.Group(CommandUtil.getGroupId(groupIdString))
+                : CommandUtil.getSingleRecipientIdentifier(recipientString, m.getSelfNumber());
+
+        final List<?> rawMessages = ns.getList("message");
+        final var messages = parseMessages(rawMessages, m.getSelfNumber());
+
+        final boolean sent;
+        try {
+            sent = m.syncDeleteForMe(conversation, messages);
+        } catch (IllegalArgumentException e) {
+            throw new UserErrorException(e.getMessage(), e);
+        } catch (IOException e) {
+            throw new UnexpectedErrorException("Failed to sync the delete: " + e.getMessage(), e);
+        }
+
+        switch (outputWriter) {
+            case PlainTextWriter writer ->
+                    writer.println(sent ? "Sent" : "Nothing to sync (no other linked device)");
+            case JsonWriter writer -> writer.write(Map.of("sent", sent));
+        }
+    }
+
+    /**
+     * The messages from either JSON ({@code {author, targetTimestamp}} objects; the timestamp a number or a decimal
+     * string) or the command line ({@code AUTHOR:TIMESTAMP} strings).
+     */
+    static List<DeleteForMeTarget> parseMessages(
+            final List<?> raw,
+            final String selfNumber
+    ) throws UserErrorException {
+        if (raw == null || raw.isEmpty()) {
+            throw new UserErrorException("Missing messages parameter");
+        }
+        final var targets = new ArrayList<DeleteForMeTarget>(raw.size());
+        for (final var item : raw) {
+            final Object author;
+            final Object timestamp;
+            if (item instanceof Map<?, ?> map) {
+                author = map.get("author");
+                timestamp = map.containsKey("targetTimestamp") ? map.get("targetTimestamp") : map.get("target-timestamp");
+            } else if (item instanceof String string && string.lastIndexOf(':') > 0) {
+                final var split = string.lastIndexOf(':');
+                author = string.substring(0, split);
+                timestamp = string.substring(split + 1);
+            } else {
+                throw new UserErrorException("Invalid message: expected {author, targetTimestamp}");
+            }
+            if (!(author instanceof String authorString) || authorString.isEmpty()) {
+                throw new UserErrorException("Invalid message: missing author");
+            }
+            targets.add(new DeleteForMeTarget(CommandUtil.getSingleRecipientIdentifier(authorString, selfNumber),
+                    parseTimestamp(timestamp)));
+        }
+        return targets;
+    }
+
+    private static long parseTimestamp(final Object timestamp) throws UserErrorException {
+        try {
+            final long value = switch (timestamp) {
+                case Long l -> l;
+                case Integer i -> i;
+                case String s -> Long.parseLong(s);
+                case null, default -> throw new NumberFormatException();
+            };
+            if (value <= 0) {
+                throw new NumberFormatException();
+            }
+            return value;
+        } catch (NumberFormatException e) {
+            throw new UserErrorException("Invalid message: invalid targetTimestamp");
+        }
+    }
+}
