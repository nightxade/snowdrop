+    @Override
+    public boolean syncDeleteForMe(
+            final RecipientIdentifier conversation,
+            final List<DeleteForMeTarget> messages
+    ) throws IOException {
+        if (messages.isEmpty()) {
+            throw new IllegalArgumentException("No messages to delete");
+        }
+        if (!account.isMultiDevice()) {
+            return false;
+        }
+        final var conversationId = switch (conversation) {
+            case RecipientIdentifier.Group group -> DeleteForMeBuilder.conversation(group.groupId());
+            case RecipientIdentifier.NoteToSelf ignored ->
+                    DeleteForMeBuilder.conversation(account.getSelfRecipientAddress().toApiRecipientAddress());
+            case RecipientIdentifier.Single single -> DeleteForMeBuilder.conversation(resolveAddress(single));
+        };
+        final var addressable = new ArrayList<AddressableMessage>(messages.size());
+        for (final var target : messages) {
+            addressable.add(DeleteForMeBuilder.message(resolveAddress(target.author()), target.sentTimestamp()));
+        }
+        final var result = context.getSyncHelper()
+                .sendDeleteForMe(DeleteForMeBuilder.messageDeletes(conversationId, addressable));
+        if (!result.isSuccess()) {
+            // The kind only: no ids, numbers or timestamps.
+            throw new IOException("The delete could not be synced to the other devices");
+        }
+        return true;
+    }
+
+    private org.asamk.signal.manager.api.RecipientAddress resolveAddress(final RecipientIdentifier.Single identifier) {
+        try {
+            final var recipientId = context.getRecipientHelper().resolveRecipient(identifier);
+            return account.getRecipientAddressResolver().resolveRecipientAddress(recipientId).toApiRecipientAddress();
+        } catch (UnregisteredRecipientException e) {
+            return identifier.toPartialRecipientAddress();
+        }
+    }
+
