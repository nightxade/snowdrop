+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.asamk.signal.manager.api.GroupId;
+import org.asamk.signal.manager.api.RecipientAddress;
+import org.junit.jupiter.api.Test;
+import org.whispersystems.signalservice.internal.push.SyncMessage;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class DeleteForMeBuilderTest {
+
+    private static final String ACI = "a1b2c3d4-e5f6-7890-abcd-ef1234567890";
+    private static final String PNI = "PNI:11111111-2222-3333-4444-555555555555";
+
+    @Test
+    void aPersonIsIdentifiedByTheAciEvenWithANumber() {
+        final var conversation = DeleteForMeBuilder.conversation(new RecipientAddress(ACI, PNI, "+15551234567", null));
+        assertEquals(ACI, conversation.threadServiceId);
+        assertNull(conversation.threadE164);
+        assertNull(conversation.threadGroupId);
+    }
+
+    @Test
+    void thePniIsUsedOnlyWithoutAnAci() {
+        assertEquals(PNI,
+                DeleteForMeBuilder.conversation(new RecipientAddress(null, PNI, "+15551234567", null)).threadServiceId);
+    }
+
+    @Test
+    void theNumberIsUsedOnlyWithoutAnyServiceId() {
+        final var conversation = DeleteForMeBuilder.conversation(new RecipientAddress("+15551234567"));
+        assertEquals("+15551234567", conversation.threadE164);
+        assertNull(conversation.threadServiceId);
+    }
+
+    @Test
+    void aGroupIsIdentifiedByItsIdBytes() {
+        final var bytes = new byte[32];
+        for (int i = 0; i < bytes.length; i++) {
+            bytes[i] = (byte) i;
+        }
+        final var conversation = DeleteForMeBuilder.conversation(GroupId.unknownVersion(bytes));
+        assertArrayEquals(bytes, conversation.threadGroupId.toByteArray());
+        assertNull(conversation.threadServiceId);
+        assertNull(conversation.threadE164);
+    }
+
+    @Test
+    void aMessageIsAddressedByAuthorAndSentTimestamp() {
+        final var withAci = DeleteForMeBuilder.message(new RecipientAddress(ACI, null, "+15551234567", null),
+                1_700_000_000_123L);
+        assertEquals(ACI, withAci.authorServiceId);
+        assertNull(withAci.authorE164);
+        assertEquals(1_700_000_000_123L, withAci.sentTimestamp);
+
+        final var withNumber = DeleteForMeBuilder.message(new RecipientAddress("+15551234567"), 5L);
+        assertEquals("+15551234567", withNumber.authorE164);
+        assertNull(withNumber.authorServiceId);
+    }
+
+    @Test
+    void aUsernameOnlyRecipientCannotBeAddressed() {
+        final var usernameOnly = new RecipientAddress(null, null, null, "alice.01");
+        assertThrows(IllegalArgumentException.class, () -> DeleteForMeBuilder.conversation(usernameOnly));
+        assertThrows(IllegalArgumentException.class, () -> DeleteForMeBuilder.message(usernameOnly, 1L));
+    }
+
+    @Test
+    void oneMessageDeletesEntryForTheConversation() {
+        final var conversation = DeleteForMeBuilder.conversation(new RecipientAddress(ACI, null, null, null));
+        final var messages = List.of(DeleteForMeBuilder.message(new RecipientAddress(ACI, null, null, null), 10L),
+                DeleteForMeBuilder.message(new RecipientAddress("+15551234567"), 11L));
+
+        final SyncMessage.DeleteForMe deleteForMe = DeleteForMeBuilder.messageDeletes(conversation, messages);
+
+        assertEquals(1, deleteForMe.messageDeletes.size());
+        assertEquals(conversation, deleteForMe.messageDeletes.getFirst().conversation);
+        assertEquals(messages, deleteForMe.messageDeletes.getFirst().messages);
+        assertEquals(0, deleteForMe.conversationDeletes.size());
+        assertEquals(0, deleteForMe.localOnlyConversationDeletes.size());
+        assertEquals(0, deleteForMe.attachmentDeletes.size());
+    }
+
+    @Test
+    void noMessagesIsRefused() {
+        assertThrows(IllegalArgumentException.class,
+                () -> DeleteForMeBuilder.messageDeletes(DeleteForMeBuilder.conversation(new RecipientAddress(ACI,
+                        null,
+                        null,
+                        null)), List.of()));
+    }
+
+    @Test
+    void theBuiltMessageSurvivesTheWireFormat() throws Exception {
+        final var built = DeleteForMeBuilder.messageDeletes(DeleteForMeBuilder.conversation(GroupId.unknownVersion(new byte[32])),
+                List.of(DeleteForMeBuilder.message(new RecipientAddress(ACI, null, null, null), 77L)));
+        final var decoded = SyncMessage.DeleteForMe.ADAPTER.decode(SyncMessage.DeleteForMe.ADAPTER.encode(built));
+        assertEquals(built, decoded);
+    }
+}
