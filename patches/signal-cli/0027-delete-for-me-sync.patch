+++ b/lib/src/main/java/org/asamk/signal/manager/helper/DeleteForMeBuilder.java
@@ -0,0 +1,67 @@
+package org.asamk.signal.manager.helper;
+
+import okio.ByteString;
+
+import org.asamk.signal.manager.api.GroupId;
+import org.asamk.signal.manager.api.RecipientAddress;
+import org.whispersystems.signalservice.internal.push.AddressableMessage;
+import org.whispersystems.signalservice.internal.push.ConversationIdentifier;
+import org.whispersystems.signalservice.internal.push.SyncMessage;
+
+import java.util.List;
+
+/**
+ * Builds the {@code SyncMessage.DeleteForMe} for messages the user removed on this device only, the way Signal's own
+ * clients identify them: a service id (the ACI; the PNI only if there is no ACI) for a person, the group id bytes for
+ * a group, and the E164 only when there is no service id at all.
+ */
+public final class DeleteForMeBuilder {
+
+    private DeleteForMeBuilder() {}
+
+    public static ConversationIdentifier conversation(final RecipientAddress person) {
+        final var serviceId = serviceId(person);
+        if (serviceId != null) {
+            return new ConversationIdentifier.Builder().threadServiceId(serviceId).build();
+        }
+        return new ConversationIdentifier.Builder().threadE164(e164(person)).build();
+    }
+
+    public static ConversationIdentifier conversation(final GroupId groupId) {
+        return new ConversationIdentifier.Builder().threadGroupId(ByteString.of(groupId.serialize())).build();
+    }
+
+    public static AddressableMessage message(final RecipientAddress author, final long sentTimestamp) {
+        final var builder = new AddressableMessage.Builder().sentTimestamp(sentTimestamp);
+        final var serviceId = serviceId(author);
+        if (serviceId != null) {
+            builder.authorServiceId(serviceId);
+        } else {
+            builder.authorE164(e164(author));
+        }
+        return builder.build();
+    }
+
+    /** One {@code MessageDeletes} entry, for one conversation. */
+    public static SyncMessage.DeleteForMe messageDeletes(
+            final ConversationIdentifier conversation,
+            final List<AddressableMessage> messages
+    ) {
+        if (messages.isEmpty()) {
+            throw new IllegalArgumentException("No messages to delete");
+        }
+        return new SyncMessage.DeleteForMe.Builder().messageDeletes(List.of(new SyncMessage.DeleteForMe.MessageDeletes.Builder()
+                .conversation(conversation)
+                .messages(messages)
+                .build())).build();
+    }
+
+    private static String serviceId(final RecipientAddress address) {
+        return address.aci().or(address::pni).orElse(null);
+    }
+
+    private static String e164(final RecipientAddress address) {
+        return address.number()
+                .orElseThrow(() -> new IllegalArgumentException("A recipient needs an ACI, a PNI or a phone number"));
+    }
+}
