@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.IOErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+import java.io.IOException;
+
+public class GetHistoryCommand implements JsonRpcLocalCommand {
+    @Override public String getName() { return "getHistory"; }
+
+    @Override public void attachToSubparser(Subparser parser) {
+        parser.help("Retrieve a page of imported phone history in backup-frame order.");
+        parser.addArgument("--archive-id").help("Snapshot id returned by the first page.");
+        parser.addArgument("--after").setDefault("0").help("Exclusive cursor returned by the previous page.");
+        parser.addArgument("--limit").setDefault("100").help("Maximum frames to return (1..500).");
+    }
+
+    @Override public void handleCommand(Namespace ns, Manager manager, OutputWriter output)
+            throws CommandException {
+        try {
+            Object after = ns.get("after");
+            Object limit = ns.get("limit");
+            var page = manager.getHistory(ns.getString("archive-id"),
+                    after == null ? 0 : Long.parseLong(after.toString()),
+                    limit == null ? 100 : Integer.parseInt(limit.toString()));
+            switch (output) {
+                case JsonWriter writer -> writer.write(page);
+                case PlainTextWriter writer -> {
+                    writer.println("Archive: {}", page.archiveId());
+                    for (var entry : page.entries()) writer.println("{} {}", entry.cursor(), entry.frame());
+                    writer.println("Next cursor: {} More: {}", page.nextCursor(), page.hasMore());
+                }
+            }
+        } catch (IllegalArgumentException e) {
+            throw new UserErrorException("Invalid history pagination: " + e.getMessage(), e);
+        } catch (IOException e) {
+            throw new IOErrorException("History retrieval failed: " + e.getMessage(), e);
+        }
+    }
+}
