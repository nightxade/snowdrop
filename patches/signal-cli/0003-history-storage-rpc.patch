+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+/** Imported phone history inside signal-cli's existing account database.
+ * Imports replace a snapshot atomically. Cursors are scoped to that snapshot.
+ */
+public final class HistoryStore {
+    @FunctionalInterface public interface Connections { Connection open() throws SQLException; }
+    @FunctionalInterface interface Source { void read(HistoryFrames.Visitor visitor) throws IOException; }
+    public record Entry(String cursor, Map<String, Object> frame) {}
+    public record Page(String archiveId, List<Entry> entries, String nextCursor, boolean hasMore) {}
+    private final Connections connections;
+
+    public HistoryStore(Connections connections) throws SQLException {
+        this.connections = connections;
+        try (var connection = connections.open(); var statement = connection.createStatement()) {
+            statement.executeUpdate("""
+                CREATE TABLE IF NOT EXISTS snowdrop_history_meta (
+                  singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
+                  archive_id TEXT NOT NULL, backup_info BLOB NOT NULL
+                )
+                """);
+            statement.executeUpdate("""
+                CREATE TABLE IF NOT EXISTS snowdrop_history_frame (
+                  ordinal INTEGER PRIMARY KEY, frame BLOB NOT NULL, expires_at INTEGER
+                )
+                """);
+            statement.executeUpdate("CREATE INDEX IF NOT EXISTS snowdrop_history_expiry ON snowdrop_history_frame(expires_at)");
+        }
+    }
+
+    public String importArchive(Path archive, byte[] aesKey, byte[] macKey, long now) throws IOException {
+        return replace(visitor -> HistoryFrames.read(archive, aesKey, macKey, visitor), now);
+    }
+
+    String replace(Source source, long now) throws IOException {
+        String id = UUID.randomUUID().toString();
+        try (var connection = connections.open()) {
+            connection.setAutoCommit(false);
+            try {
+                try (var clear = connection.createStatement()) {
+                    clear.executeUpdate("DELETE FROM snowdrop_history_frame");
+                    clear.executeUpdate("DELETE FROM snowdrop_history_meta");
+                }
+                try (var insert = connection.prepareStatement(
+                        "INSERT INTO snowdrop_history_frame(ordinal, frame, expires_at) VALUES(?, ?, ?)")) {
+                    source.read(new HistoryFrames.Visitor() {
+                        private long ordinal;
+                        private final HashSet<Long> recipients = new HashSet<>();
+                        private final HashSet<Long> chats = new HashSet<>();
+                        @Override public void info(Backups.BackupInfo info) throws IOException {
+                            try (var meta = connection.prepareStatement(
+                                    "INSERT INTO snowdrop_history_meta VALUES(1, ?, ?)")) {
+                                meta.setString(1, id);
+                                meta.setBytes(2, info.toByteArray());
+                                meta.executeUpdate();
+                            } catch (SQLException e) { throw new IOException("Cannot store history metadata", e); }
+                        }
+                        @Override public void frame(Backups.Frame frame) throws IOException {
+                            // Account keys/settings are not needed by the history client.
+                            if (frame.hasAccount()) return;
+                            if (frame.hasRecipient() && !recipients.add(frame.getRecipient().getId())) {
+                                throw new IOException("Duplicate history recipient");
+                            }
+                            if (frame.hasChat() && (!recipients.contains(frame.getChat().getRecipientId())
+                                    || !chats.add(frame.getChat().getId()))) {
+                                throw new IOException("Invalid history chat reference");
+                            }
+                            Long expires = null;
+                            if (frame.hasChatItem()) {
+                                var item = frame.getChatItem();
+                                if (!chats.contains(item.getChatId()) || !recipients.contains(item.getAuthorId())) {
+                                    throw new IOException("Invalid history message reference");
+                                }
+                                if (item.hasExpireStartDate() && item.getExpireStartDate() != 0
+                                        && item.hasExpiresInMs() && item.getExpiresInMs() != 0) {
+                                    if (item.getExpireStartDate() < 0 || item.getExpiresInMs() < 0) {
+                                        throw new IOException("Invalid history expiration");
+                                    }
+                                    try { expires = Math.addExact(item.getExpireStartDate(), item.getExpiresInMs()); }
+                                    catch (ArithmeticException e) { throw new IOException("Invalid history expiration", e); }
+                                    if (expires <= now) return;
+                                }
+                            }
+                            try {
+                                insert.setLong(1, ++ordinal);
+                                insert.setBytes(2, frame.toByteArray());
+                                insert.setObject(3, expires);
+                                insert.executeUpdate();
+                            } catch (SQLException e) { throw new IOException("Cannot store history frame", e); }
+                        }
+                    });
+                }
+                connection.commit();
+                return id;
+            } catch (IOException | SQLException | RuntimeException e) {
+                connection.rollback();
+                throw e;
+            }
+        } catch (SQLException e) { throw new IOException("Cannot import history", e); }
+    }
+
+    public Page page(String archiveId, long after, int limit, long now) throws IOException {
+        if (after < 0 || limit < 1 || limit > 500 || (after > 0 && archiveId == null)) {
+            throw new IllegalArgumentException("History requires limit 1..500, a nonnegative cursor, and an archiveId when paging");
+        }
+        try (var connection = connections.open()) {
+            connection.setAutoCommit(false);
+            try (var purge = connection.prepareStatement("DELETE FROM snowdrop_history_frame WHERE expires_at <= ?")) {
+                purge.setLong(1, now);
+                purge.executeUpdate();
+            }
+            String current = null;
+            try (var query = connection.createStatement(); var rows = query.executeQuery(
+                    "SELECT archive_id FROM snowdrop_history_meta WHERE singleton = 1")) {
+                if (rows.next()) current = rows.getString(1);
+            }
+            if (archiveId != null && !archiveId.equals(current)) throw new IOException("History changed; restart pagination");
+            var entries = new ArrayList<Entry>();
+            boolean more = false;
+            String cursor = Long.toString(after);
+            try (var query = connection.prepareStatement(
+                    "SELECT ordinal, frame FROM snowdrop_history_frame WHERE ordinal > ? ORDER BY ordinal LIMIT ?")) {
+                query.setLong(1, after);
+                query.setInt(2, limit + 1);
+                try (var rows = query.executeQuery()) {
+                    while (rows.next()) {
+                        if (entries.size() == limit) { more = true; break; }
+                        cursor = Long.toString(rows.getLong(1));
+                        entries.add(new Entry(cursor, HistoryJson.fields(Backups.Frame.parseFrom(rows.getBytes(2)))));
+                    }
+                }
+            }
+            connection.commit();
+            return new Page(current, List.copyOf(entries), cursor, more);
+        } catch (SQLException e) { throw new IOException("Cannot read history", e); }
+    }
+}
