+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryStoreTest {
+    @TempDir Path directory;
+    private HistoryStore store() throws Exception {
+        return new HistoryStore(() -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db")));
+    }
+    private void seed(HistoryFrames.Visitor visitor) throws IOException {
+        visitor.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+        visitor.frame(Backups.Frame.newBuilder().setAccount(Backups.AccountData.getDefaultInstance()).build());
+        visitor.frame(Backups.Frame.newBuilder().setRecipient(Backups.Recipient.newBuilder().setId(1)
+                .setSelf(Backups.Self.getDefaultInstance())).build());
+        visitor.frame(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(2).setRecipientId(1)).build());
+    }
+    private Backups.Frame message(long sentAt, long expiresIn) {
+        var item = Backups.ChatItem.newBuilder().setChatId(2).setAuthorId(1).setDateSent(sentAt)
+                .setIncoming(Backups.ChatItem.IncomingMessageDetails.getDefaultInstance())
+                .setStandardMessage(Backups.StandardMessage.newBuilder().setText(Backups.Text.newBuilder().setBody("hello")));
+        if (expiresIn > 0) item.setExpireStartDate(1000).setExpiresInMs(expiresIn);
+        return Backups.Frame.newBuilder().setChatItem(item).build();
+    }
+    @Test void pagesDurableHistoryWithoutAccountSecrets() throws Exception {
+        var store = store();
+        String id = store.replace(v -> { seed(v); v.frame(message(10, 0)); }, 1000);
+        var first = store().page(null, 0, 2, 1000);
+        assertEquals(id, first.archiveId());
+        assertEquals(2, first.entries().size());
+        assertTrue(first.hasMore());
+        assertTrue(first.entries().getFirst().frame().containsKey("recipient"));
+        var last = store.page(id, Long.parseLong(first.nextCursor()), 2, 1000);
+        assertEquals(1, last.entries().size());
+        assertTrue(last.entries().getFirst().frame().containsKey("chatItem"));
+        assertFalse(last.hasMore());
+    }
+    @Test void failedImportRollsBackToPriorSnapshot() throws Exception {
+        var store = store();
+        String id = store.replace(this::seed, 1000);
+        assertThrows(IOException.class, () -> store.replace(v -> {
+            seed(v); throw new IOException("corrupt trailing frame");
+        }, 1000));
+        assertEquals(id, store.page(null, 0, 10, 1000).archiveId());
+        assertEquals(2, store.page(id, 0, 10, 1000).entries().size());
+    }
+    @Test void skipsExpiredMessagesAndPurgesNewlyExpiredMessages() throws Exception {
+        var store = store();
+        store.replace(v -> { seed(v); v.frame(message(10, 10)); v.frame(message(20, 100)); }, 1050);
+        assertEquals(3, store.page(null, 0, 10, 1050).entries().size());
+        assertEquals(2, store.page(null, 0, 10, 1100).entries().size());
+    }
+    @Test void rejectsStaleCursorsAndInvalidReferences() throws Exception {
+        var store = store();
+        String old = store.replace(this::seed, 1000);
+        store.replace(this::seed, 1000);
+        assertThrows(IOException.class, () -> store.page(old, 1, 10, 1000));
+        assertThrows(IllegalArgumentException.class, () -> store.page(null, 1, 10, 1000));
+        assertThrows(IOException.class, () -> store.replace(v -> {
+            v.info(Backups.BackupInfo.newBuilder().setVersion(1).build());
+            v.frame(message(1, 0));
+        }, 1000));
+    }
+}
