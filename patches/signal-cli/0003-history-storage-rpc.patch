@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import org.asamk.signal.commands.exceptions.IOErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.history.HistoryStore;
+import org.junit.jupiter.api.Test;
+import java.io.IOException;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+import static org.junit.jupiter.api.Assertions.*;
+
+class GetHistoryCommandTest {
+    private Manager manager(java.lang.reflect.InvocationHandler handler) {
+        return (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(), new Class<?>[]{Manager.class}, handler);
+    }
+    @Test void handlesJsonRpcNamesAndStringCursors() throws Exception {
+        var expected = new HistoryStore.Page("snapshot", List.of(), "9007199254740993", false);
+        var manager = manager((proxy, method, args) -> {
+            assertEquals("getHistory", method.getName());
+            assertArrayEquals(new Object[]{"snapshot", 9007199254740993L, 20}, args);
+            return expected;
+        });
+        var output = new AtomicReference<Object>();
+        new GetHistoryCommand().handleCommand(Map.of("archiveId", "snapshot", "after", "9007199254740993", "limit", 20),
+                manager, output::set);
+        assertEquals(expected, output.get());
+    }
+    @Test void usesFirstPageDefaults() throws Exception {
+        var manager = manager((proxy, method, args) -> {
+            assertArrayEquals(new Object[]{null, 0L, 100}, args);
+            return new HistoryStore.Page(null, List.of(), "0", false);
+        });
+        var output = new AtomicReference<Object>();
+        new GetHistoryCommand().handleCommand(Map.of(), manager, output::set);
+        assertNotNull(output.get());
+    }
+    @Test void reportsMalformedCursorsAndStorageErrors() {
+        var manager = manager((proxy, method, args) -> { throw new IOException("History changed"); });
+        var output = new AtomicReference<Object>();
+        assertThrows(UserErrorException.class, () -> new GetHistoryCommand().handleCommand(
+                Map.of("after", "1.5"), manager, output::set));
+        assertThrows(IOErrorException.class, () -> new GetHistoryCommand().handleCommand(
+                Map.of(), manager, output::set));
+        assertNull(output.get());
+    }
+}
