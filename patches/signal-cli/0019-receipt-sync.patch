+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.api;
+
+/**
+ * Snowdrop: the outcome of {@code sendReadReceipt} / {@code sendViewedReceipt}: the receipt to
+ * the sender (unchanged) plus the sync message to the account's own other devices.
+ */
