+/**
+ * The same JSON as {@link JsonAttachmentData} ({@code {"data":"<standard base64>"}}), but the bytes
+ * are Base64-encoded straight from {@code input} into the output while it is written, so neither
+ * the raw bytes nor the encoded String are ever held whole. Owns {@code input}: it is closed once
+ * written, or by {@link #close()} if the result is never written.
+ */
+public final class JsonStreamedAttachmentData extends JsonSerializable.Base implements Closeable {
+
+    private final InputStream input;
+
+    public JsonStreamedAttachmentData(final InputStream input) {
+        this.input = input;
+    }
+
+    /**
+     * Checks cheaply that {@code input} can be read (its first byte) before a response is begun, so an
+     * unreadable file is still an ordinary error. Closes {@code input} if it cannot.
+     */
+    public static JsonStreamedAttachmentData of(final InputStream input) throws IOException {
+        final var buffered = new BufferedInputStream(input);
+        try {
+            buffered.mark(1);
+            buffered.read();
+            buffered.reset();
+        } catch (IOException | RuntimeException e) {
+            try {
+                buffered.close();
+            } catch (IOException closeError) {
+                e.addSuppressed(closeError);
+            }
+            throw e;
+        }
+        return new JsonStreamedAttachmentData(buffered);
+    }
+
+    @Override
+    public void serialize(final JsonGenerator gen, final SerializerProvider serializers) throws IOException {
+        try (input) {
+            gen.writeStartObject();
+            gen.writeFieldName("data");
+            // Length -1: read to the end. MIME_NO_LINEFEEDS is Jackson's default variant, the
+            // standard alphabet with padding and no line breaks, as java.util.Base64's basic encoder.
+            gen.writeBinary(Base64Variants.MIME_NO_LINEFEEDS, input, -1);
+            gen.writeEndObject();
+        }
+    }
+
+    @Override
+    public void serializeWithType(
+            final JsonGenerator gen,
+            final SerializerProvider serializers,
+            final TypeSerializer typeSer
+    ) throws IOException {
+        serialize(gen, serializers);
+    }
+
+    @Override
+    public void close() throws IOException {
+        input.close();
+    }
+}
