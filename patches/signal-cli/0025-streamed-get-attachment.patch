+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.util;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermission;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PrivateTempFileTest {
+
+    @TempDir
+    Path base;
+
+    @AfterEach
+    void unset() throws Exception {
+        IOUtils.setPrivateTempDir(null);
+    }
+
+    @Test
+    void createsTheDirectoryPrivatelySweepsStaleFilesAndStagesFilesInIt() throws Exception {
+        final var dir = base.resolve("snowdrop-tmp");
+        Files.createDirectory(dir);
+        final var stale = Files.write(dir.resolve("snowdrop_plain_old.tmp"), new byte[]{1});
+
+        IOUtils.setPrivateTempDir(dir.toFile());
+
+        assertFalse(Files.exists(stale));
+        assertEquals(Set.of(PosixFilePermission.OWNER_READ, PosixFilePermission.OWNER_WRITE,
+                PosixFilePermission.OWNER_EXECUTE), Files.getPosixFilePermissions(dir));
+        final var file = IOUtils.createPrivateTempFile().toPath();
+        assertEquals(dir, file.getParent());
+        assertEquals(Set.of(PosixFilePermission.OWNER_READ, PosixFilePermission.OWNER_WRITE),
+                Files.getPosixFilePermissions(file));
+    }
+
+    @Test
+    void createsMissingParentDirectoriesAndNeedsNoDeleteOnExit() throws Exception {
+        final var dir = base.resolve("a").resolve("snowdrop-tmp");
+
+        IOUtils.setPrivateTempDir(dir.toFile());
+
+        assertTrue(Files.isDirectory(dir));
+        final var stream = new TempFileInputStream(IOUtils.createPrivateTempFile());
+        stream.close();
+        try (var entries = Files.list(dir)) {
+            assertEquals(0, entries.count());
+        }
+    }
+}
