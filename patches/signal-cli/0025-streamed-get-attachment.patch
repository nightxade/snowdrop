diff --git a/src/test/java/org/asamk/signal/json/JsonStreamedAttachmentDataTest.java b/src/test/java/org/asamk/signal/json/JsonStreamedAttachmentDataTest.java
new file mode 100644
index 0000000..aa25075
--- /dev/null
+++ b/src/test/java/org/asamk/signal/json/JsonStreamedAttachmentDataTest.java
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.json;
+
+import com.fasterxml.jackson.databind.node.JsonNodeFactory;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import com.fasterxml.jackson.databind.node.POJONode;
+import com.fasterxml.jackson.databind.node.TextNode;
+
+import org.asamk.signal.commands.GetAttachmentCommand;
+import org.asamk.signal.jsonrpc.JsonRpcException;
+import org.asamk.signal.jsonrpc.JsonRpcResponse;
+import org.asamk.signal.jsonrpc.SignalJsonRpcCommandHandler;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.output.JsonWriterImpl;
+import org.asamk.signal.util.Util;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.FileNotFoundException;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.StringWriter;
+import java.io.Writer;
+import java.lang.reflect.Proxy;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class JsonStreamedAttachmentDataTest {
+
+    private static final class Tracked extends FilterInputStream {
+
+        final AtomicBoolean closed = new AtomicBoolean();
+
+        Tracked(final InputStream in) {
+            super(in);
+        }
+
+        @Override
+        public void close() throws IOException {
+            closed.set(true);
+            super.close();
+        }
+    }
+
+    private static byte[] bytes(final int n) {
+        final var b = new byte[n];
+        new Random(n).nextBytes(b);
+        return b;
+    }
+
+    private static String write(final Object value) {
+        final var out = new StringWriter();
+        new JsonWriterImpl(out).write(value);
+        return out.toString();
+    }
+
+    @Test
+    void producesTheSameJsonAsTheBufferedType() {
+        // Every padding case, and sizes above Jackson's internal read buffer.
+        for (final var n : new int[]{0, 1, 2, 3, 4, 100, 1000, 65536, 100_001}) {
+            final var data = bytes(n);
+            final var base64 = Base64.getEncoder().encodeToString(data);
+            final var in = new Tracked(new ByteArrayInputStream(data));
+
+            final var streamed = write(new JsonStreamedAttachmentData(in));
+
+            assertEquals(write(new JsonAttachmentData(base64)), streamed, "size " + n);
+            assertTrue(in.closed.get());
+        }
+        assertEquals("{\"data\":\"AQID\"}" + System.lineSeparator(),
+                write(new JsonStreamedAttachmentData(new ByteArrayInputStream(new byte[]{1, 2, 3}))));
+    }
+
+    @Test
+    void writesALargeAttachmentWithoutBufferingIt() {
+        final var size = 96L * 1024 * 1024;
+        final var written = new AtomicLong();
+        final var counting = new Writer() {
+            @Override
+            public void write(final char[] c, final int off, final int len) {
+                written.addAndGet(len);
+            }
+
+            @Override
+            public void flush() {
+            }
+
+            @Override
+            public void close() {
+            }
+        };
+        final var zeros = new InputStream() {
+            long left = size;
+
+            @Override
+            public int read() {
+                return left-- > 0 ? 0 : -1;
+            }
+
+            @Override
+            public int read(final byte[] b, final int off, final int len) {
+                if (left <= 0) {
+                    return -1;
+                }
+                final var n = (int) Math.min(len, left);
+                Arrays.fill(b, off, off + n, (byte) 0);
+                left -= n;
+                return n;
+            }
+        };
+
+        new JsonWriterImpl(counting).write(new JsonStreamedAttachmentData(zeros));
+
+        // {"data":"..."} plus the line separator.
+        assertEquals(4 * ((size + 2) / 3) + "{\"data\":\"\"}".length() + System.lineSeparator().length(),
+                written.get());
+    }
+
+    private static InputStream failingAfter(final int good, final Tracked[] holder) {
+        final var in = new Tracked(new InputStream() {
+            int left = good;
+
+            @Override
+            public int read() throws IOException {
+                if (left-- <= 0) {
+                    throw new IOException("disk error");
+                }
+                return 'A';
+            }
+        });
+        if (holder != null) {
+            holder[0] = in;
+        }
+        return in;
+    }
+
+    @Test
+    void aStreamThatFailsMidWayLeavesATerminatedLineAndTheNextMessageIntact() throws Exception {
+        final var out = new StringWriter();
+        final var writer = new JsonWriterImpl(out);
+        final var holder = new Tracked[1];
+
+        assertThrows(AssertionError.class,
+                () -> writer.write(new JsonStreamedAttachmentData(failingAfter(20000, holder))));
+        writer.write(java.util.Map.of("ok", 1));
+
+        final var lines = out.toString().split("\\R");
+        assertEquals(2, lines.length);
+        // The broken line is cut off (never a complete object) and ends where the next message starts.
+        assertTrue(lines[0].isEmpty() || lines[0].startsWith("{\"data\":\""));
+        assertFalse(lines[0].endsWith("}"));
+        assertEquals("{\"ok\":1}", lines[1]);
+        assertTrue(holder[0].closed.get());
+    }
+
+    @Test
+    void aStreamThatFailsMidWayStillAnswersTheRequestWithAnError() throws Exception {
+        final var out = new StringWriter();
+        final var writer = new JsonWriterImpl(out);
+        final var holder = new Tracked[1];
+
+        writer.write(JsonRpcResponse.forSuccess(new POJONode(new JsonStreamedAttachmentData(failingAfter(20000, holder))),
+                TextNode.valueOf("7")));
+        writer.write(java.util.Map.of("ok", 1));
+
+        final var lines = out.toString().split("\\R");
+        assertEquals(3, lines.length);
+        assertFalse(lines[0].endsWith("}"));
+        // The id is answered on a line of its own, well-formed, and carries no result.
+        final var node = Util.createJsonObjectMapper().readTree(lines[1]);
+        assertEquals("2.0", node.get("jsonrpc").asText());
+        assertEquals("7", node.get("id").asText());
+        assertEquals(JsonRpcResponse.Error.INTERNAL_ERROR, node.get("error").get("code").asInt());
+        assertFalse(node.has("result"));
+        assertEquals("{\"ok\":1}", lines[2]);
+        assertTrue(holder[0].closed.get());
+    }
+
+    @Test
+    void anUnreadableStreamIsRefusedBeforeAnythingIsWritten() {
+        final var holder = new Tracked[1];
+
+        assertThrows(IOException.class, () -> JsonStreamedAttachmentData.of(failingAfter(0, holder)));
+        assertTrue(holder[0].closed.get());
+    }
+
+    @Test
+    void aReadableStreamKeepsItsFirstByte() throws Exception {
+        final var out = new StringWriter();
+
+        new JsonWriterImpl(out).write(JsonStreamedAttachmentData.of(new ByteArrayInputStream(new byte[]{1, 2, 3})));
+
+        assertEquals("{\"data\":\"AQID\"}" + System.lineSeparator(), out.toString());
+    }
+
+    private static Manager managerReturning(final Tracked stream) {
+        return (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(),
+                new Class<?>[]{Manager.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("retrieveAttachment")) {
+                        if (stream == null) {
+                            throw new FileNotFoundException("gone");
+                        }
+                        return stream;
+                    }
+                    throw new UnsupportedOperationException(method.getName());
+                });
+    }
+
+    private static ObjectNode params() {
+        final var params = JsonNodeFactory.instance.objectNode();
+        params.set("id", TextNode.valueOf("abc"));
+        return params;
+    }
+
+    @Test
+    void jsonRpcResponseKeepsTheWireFormat() throws Exception {
+        final var data = bytes(5000);
+        final var stream = new Tracked(new ByteArrayInputStream(data));
+        final var handler = new SignalJsonRpcCommandHandler(managerReturning(stream),
+                name -> new GetAttachmentCommand());
+
+        final var result = handler.handleRequest(Util.createJsonObjectMapper(), "getAttachment", params());
+        assertFalse(stream.closed.get(), "the stream stays open until the response is written");
+        final var out = new StringWriter();
+        new JsonWriterImpl(out).write(JsonRpcResponse.forSuccess(result, TextNode.valueOf("1")));
+
+        assertEquals("{\"jsonrpc\":\"2.0\",\"result\":{\"data\":\"" + Base64.getEncoder().encodeToString(data)
+                + "\"},\"id\":\"1\"}" + System.lineSeparator(), out.toString());
+        assertTrue(stream.closed.get());
+    }
+
+    @Test
+    void errorsStillComeBackAsJsonRpcErrors() {
+        final var handler = new SignalJsonRpcCommandHandler(managerReturning(null),
+                name -> new GetAttachmentCommand());
+
+        final var e = assertThrows(JsonRpcException.class,
+                () -> handler.handleRequest(Util.createJsonObjectMapper(), "getAttachment", params()));
+        assertEquals(-1, e.getError().getCode());
+        assertEquals("Could not find attachment with ID: abc", e.getError().getMessage());
+    }
+}
