+    private static volatile Path privateTempDir;
+
+    /**
+     * Sets, creates (mode 0700) and sweeps the directory {@link #createPrivateTempFile()} uses. Whatever
+     * a previous run left there (it is only ever filled with temporary files) is deleted, so nothing
+     * survives a crash. {@code null} unsets it. Call once at start-up, before any file is created.
+     */
+    public static void setPrivateTempDir(final File dir) throws IOException {
+        if (dir == null) {
+            privateTempDir = null;
+            return;
+        }
+        final var path = dir.toPath();
+        try {
+            Files.createDirectories(path,
+                    PosixFilePermissions.asFileAttribute(EnumSet.of(OWNER_READ, OWNER_WRITE, OWNER_EXECUTE)));
+            Files.setPosixFilePermissions(path, EnumSet.of(OWNER_READ, OWNER_WRITE, OWNER_EXECUTE));
+        } catch (UnsupportedOperationException e) {
+            Files.createDirectories(path);
+        }
+        try (var entries = Files.newDirectoryStream(path)) {
+            for (final var entry : entries) {
+                if (Files.isRegularFile(entry, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
+                    Files.deleteIfExists(entry);
+                }
+            }
+        }
+        privateTempDir = path;
+    }
+
+    /**
+     * A temporary file for <em>decrypted</em> data, in the directory set by {@link #setPrivateTempDir},
+     * inside signal-cli's own config directory rather than the system temp directory. Unlike
+     * {@link #createTempFile()} it is not registered for delete-on-exit: the owner deletes it when done, and
+     * the start-up sweep removes what a crash left. Without a configured directory (library use, tests) it
+     * falls back to the system temp directory.
+     */
+    public static File createPrivateTempFile() throws IOException {
+        final var dir = privateTempDir;
+        final var prefix = "snowdrop_plain_";
+        final var suffix = ".tmp";
+        try {
+            final var attribute = PosixFilePermissions.asFileAttribute(EnumSet.of(OWNER_READ, OWNER_WRITE));
+            return (dir == null
+                    ? Files.createTempFile(prefix, suffix, attribute)
+                    : Files.createTempFile(dir, prefix, suffix, attribute)).toFile();
+        } catch (UnsupportedOperationException e) {
+            return (dir == null
+                    ? Files.createTempFile(prefix, suffix)
+                    : Files.createTempFile(dir, prefix, suffix)).toFile();
+        }
+    }
