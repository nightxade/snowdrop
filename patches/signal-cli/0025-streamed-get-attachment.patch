--- /dev/null
+++ b/lib/src/main/java/org/asamk/signal/manager/util/TempFileInputStream.java
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.util;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+
+/**
+ * Reads a temporary file and deletes it when closed, so a large download can be handed on as a
+ * stream (and verified before it is) without being held in memory.
+ */
+public final class TempFileInputStream extends FilterInputStream {
+
+    private final File file;
+
+    public TempFileInputStream(final File file) throws IOException {
+        super(open(file));
+        this.file = file;
+    }
+
+    private static FileInputStream open(final File file) throws IOException {
+        try {
+            return new FileInputStream(file);
+        } catch (IOException | RuntimeException e) {
+            Files.deleteIfExists(file.toPath());
+            throw e;
+        }
+    }
+
+    @Override
+    public void close() throws IOException {
+        try {
+            super.close();
+        } finally {
+            Files.deleteIfExists(file.toPath());
+        }
+    }
+}
