+import java.util.UUID;
+
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+
+/**
+ * What the storage sync uploads for the self account record after a profile edit, against the
+ * real recipient store: the new name and avatar, every other field as it was stored.
+ */
+class ProfileStorageUploadTest {
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private RecipientStore recipients;
+    private ConfigurationStore config;
+    private AccountRecord stored;
+    private RecipientId selfId;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        final var self = new RecipientAddress(ACI.from(UUID.randomUUID()), "+15550000001");
+        recipients = new RecipientStore((c, a, b) -> {
+        }, () -> self, () -> null, database);
+        config = new ConfigurationStore(new KeyValueStore(database), recipients);
+        // Settings the account record also carries, as the last merge left them.
+        config.setReadReceipts(false);
+        config.setTypingIndicators(true);
+        config.setLinkPreviews(false);
+        config.setUnidentifiedDeliveryIndicators(true);
+        config.setPhoneNumberSharingMode(PhoneNumberSharingMode.NOBODY);
+        config.setPhoneNumberUnlisted(false);
+
+        stored = new AccountRecord.Builder().givenName("Old")
+                .familyName("Name")
+                .avatarUrlPath("avatars/old")
+                .readReceipts(false)
+                .typingIndicators(true)
+                .linkPreviews(false)
+                .sealedSenderIndicators(true)
+                .unlistedPhoneNumber(false)
+                .phoneNumberSharingMode(AccountRecord.PhoneNumberSharingMode.NOBODY)
+                .universalExpireTimer(3600)
+                .noteToSelfMarkedUnread(true)
+                .username("someone.01")
+                .usernameLink(new AccountRecord.UsernameLink.Builder().entropy(ByteString.of(new byte[32]))
+                        .serverId(ByteString.of(new byte[16]))
+                        .color(AccountRecord.UsernameLink.Color.BLUE)
+                        .build())
+                .build();
+        try (final var connection = database.getConnection()) {
+            selfId = recipients.resolveRecipient(connection, self);
+            recipients.storeProfile(selfId,
+                    Profile.newBuilder()
+                            .withGivenName("Old")
+                            .withFamilyName("Name")
+                            .withAvatarUrlPath("avatars/old")
+                            .withAbout("hi")
+                            .build());
+            recipients.storeStorageRecord(connection, selfId, StorageId.forAccount(new byte[]{9, 9}), stored.encode());
+        }
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    private AccountRecord upload() throws Exception {
+        try (final var connection = database.getConnection()) {
+            final var self = recipients.getRecipient(connection, selfId);
+            // Linked device: usernames come from the stored record, not from local state.
+            return StorageSyncModels.localToRemoteRecord(connection, config, self, null, false);
+        }
+    }
+
+    private void editProfile(final String given, final String family, final String avatar, final String about) {
+        recipients.storeProfile(selfId,
+                Profile.newBuilder(recipients.getProfile(selfId))
+                        .withGivenName(given)
+                        .withFamilyName(family)
+                        .withAvatarUrlPath(avatar)
