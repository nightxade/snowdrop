index 0000000..e895320
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/syncStorage/AccountRecordProfileWinsTest.java
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.syncStorage;
+
+import org.junit.jupiter.api.Test;
+import org.whispersystems.signalservice.api.storage.SignalAccountRecord;
+import org.whispersystems.signalservice.api.storage.StorageId;
+import org.whispersystems.signalservice.internal.storage.protos.AccountRecord;
+
+import java.util.List;
+
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+/**
+ * A profile edit that has not reached the storage service yet must survive the merge with the
+ * (stale) remote account record, and only for the name and avatar fields.
+ */
+class AccountRecordProfileWinsTest {
+
+    private static AccountRecord.Builder phoneRecord() {
+        return new AccountRecord.Builder().givenName("Old")
+                .familyName("Name")
+                .avatarUrlPath("avatars/old")
+                .profileKey(ByteString.of(new byte[32]))
+                .readReceipts(false)
+                .typingIndicators(true)
+                .universalExpireTimer(3600)
+                .noteToSelfArchived(true)
+                .username("someone.01")
+                .preferredReactionEmoji(List.of("a", "b"))
+                .pinnedConversations(List.of(new AccountRecord.PinnedConversation.Builder().contact(new AccountRecord.PinnedConversation.Contact.Builder()
+                        .serviceId("00000000-0000-4000-8000-000000000001")
+                        .build()).build()));
+    }
+
+    private static AccountRecord edited(final AccountRecord base) {
+        return base.newBuilder().givenName("New").familyName("Person").avatarUrlPath("avatars/new").build();
+    }
+
+    @Test
+    void staleRemoteNameDoesNotRevertAPendingEditAndNothingElseMoves() {
+        final var remote = phoneRecord().build();
+        final var local = edited(remote);
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local, true);
+
+        assertEquals("New", merged.givenName);
+        assertEquals("Person", merged.familyName);
+        assertEquals("avatars/new", merged.avatarUrlPath);
+        // Exactly the remote record with those three fields replaced: settings, pins, expire
+        // timer, username and everything else are byte-identical to remote.
+        assertArrayEquals(local.encode(), merged.encode());
+        assertArrayEquals(remote.newBuilder()
+                .givenName("New")
+                .familyName("Person")
+                .avatarUrlPath("avatars/new")
+                .build()
+                .encode(), merged.encode());
+    }
+
+    @Test
+    void withoutAPendingEditTheRemoteNameStillWins() {
+        final var remote = phoneRecord().build();
+        final var local = edited(remote);
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local, false);
+
+        assertEquals("Old", merged.givenName);
+        assertEquals("Name", merged.familyName);
+        assertEquals("avatars/old", merged.avatarUrlPath);
+        assertArrayEquals(remote.encode(), merged.encode());
+        assertArrayEquals(AccountRecordProcessor.buildMergedRecord(remote, local).encode(), merged.encode());
+    }
+
+    @Test
+    void aNewerRemoteChangeToAnyOtherFieldStillApplies() {
+        final var base = phoneRecord().build();
+        final var local = edited(base);
+        final var remote = base.newBuilder()
+                .readReceipts(true)
+                .universalExpireTimer(86400)
+                .noteToSelfArchived(false)
+                .username("renamed.02")
+                .pinnedConversations(List.of())
+                .build();
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local, true);
+
+        assertEquals(true, merged.readReceipts);
+        assertEquals(86400, merged.universalExpireTimer);
+        assertEquals(false, merged.noteToSelfArchived);
+        assertEquals("renamed.02", merged.username);
+        assertEquals(0, merged.pinnedConversations.size());
+        assertEquals("New", merged.givenName);
+        assertEquals("avatars/new", merged.avatarUrlPath);
+    }
+
+    @Test
+    void aLaterPhoneNameEditWinsOnceOurEditWasUploaded() {
+        // The flag is cleared after the upload; then the ordinary rule applies again.
+        final var uploaded = edited(phoneRecord().build());
+        final var remote = uploaded.newBuilder().givenName("Phone").familyName("Edit").avatarUrlPath("avatars/p").build();
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, uploaded, false);
+
+        assertEquals("Phone", merged.givenName);
+        assertEquals("Edit", merged.familyName);
+        assertEquals("avatars/p", merged.avatarUrlPath);
+    }
+
+    @Test
+    void removingTheAvatarClearsItEvenThoughRemoteStillHasOne() {
+        final var remote = phoneRecord().build();
+        final var local = remote.newBuilder().avatarUrlPath("").build();
+
+        assertEquals("", AccountRecordProcessor.buildMergedRecord(remote, local, true).avatarUrlPath);
+        assertEquals("avatars/old", AccountRecordProcessor.buildMergedRecord(remote, local, false).avatarUrlPath);
+    }
+
+    @Test
+    void clearingTheFamilyNameIsAnEditToo() {
+        final var remote = phoneRecord().build();
+        final var local = remote.newBuilder().familyName("").build();
+
+        final var merged = AccountRecordProcessor.buildMergedRecord(remote, local, true);
+
+        assertEquals("Old", merged.givenName);
+        assertEquals("", merged.familyName);
+    }
+
+    @Test
+    void mergeKeepsOurRecordWhenItAlreadyMatchesAndOtherwiseMintsANewId() {
+        final var remote = new SignalAccountRecord(StorageId.forAccount(new byte[]{1}), phoneRecord().build());
+        final var localProto = edited(remote.getProto());
+        final var local = new SignalAccountRecord(StorageId.forAccount(new byte[]{2}), localProto);
+        final var processor = new AccountRecordProcessor(local, true);
+
+        // Remote only differs in the profile fields: the merged record is exactly ours.
+        assertSame(local, processor.merge(remote, local));
+
+        // Remote also changed something else: a new record, so the merge gets uploaded.
+        final var remoteWithOtherChange = new SignalAccountRecord(StorageId.forAccount(new byte[]{3}),
+                remote.getProto().newBuilder().universalExpireTimer(60).build());
+        final var merged = processor.merge(remoteWithOtherChange, local);
+        assertNotEquals(remoteWithOtherChange.getId(), merged.getId());
+        assertNotEquals(local.getId(), merged.getId());
+        assertEquals("New", merged.getProto().givenName);
+        assertEquals(60, merged.getProto().universalExpireTimer);
+
+        // And when the remote already holds our values the remote record is kept as is.
+        final var remoteWithOurs = new SignalAccountRecord(StorageId.forAccount(new byte[]{4}), localProto);
+        assertSame(remoteWithOurs, processor.merge(remoteWithOurs, local));
+    }
+}
