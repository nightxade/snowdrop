+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.asamk.signal.manager.api.Profile;
+import org.junit.jupiter.api.Test;
+import org.whispersystems.signalservice.api.storage.StorageId;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ProfileStoragePendingTest {
+
+    private static Profile.Builder profile() {
+        return Profile.newBuilder().withGivenName("A").withFamilyName("B").withAbout("x").withAvatarUrlPath("p/1");
+    }
+
+    @Test
+    void nameAndAvatarEditsTouchTheAccountRecord() {
+        final var before = profile().build();
+        assertTrue(ProfileHelper.accountRecordFieldsChanged(before, Profile.newBuilder(before).withGivenName("C").build()));
+        assertTrue(ProfileHelper.accountRecordFieldsChanged(before, Profile.newBuilder(before).withFamilyName("").build()));
+        assertTrue(ProfileHelper.accountRecordFieldsChanged(before,
+                Profile.newBuilder(before).withAvatarUrlPath("p/2").build()));
+        assertTrue(ProfileHelper.accountRecordFieldsChanged(before,
+                Profile.newBuilder(before).withAvatarUrlPath(null).build()));
+        assertTrue(ProfileHelper.accountRecordFieldsChanged(null, before));
+    }
+
+    @Test
+    void anAboutOnlyOrNoOpEditPushesNothing() {
+        final var before = profile().build();
+        assertFalse(ProfileHelper.accountRecordFieldsChanged(before,
+                Profile.newBuilder(before).withAbout("new about").withAboutEmoji("x").build()));
+        assertFalse(ProfileHelper.accountRecordFieldsChanged(before, Profile.newBuilder(before).build()));
+        assertFalse(ProfileHelper.accountRecordFieldsChanged(null, null));
+        assertFalse(ProfileHelper.accountRecordFieldsChanged(null, Profile.newBuilder().withAbout("x").build()));
+    }
+
+    @Test
+    void theFlagClearsOnlyOnceTheCurrentSelfRecordIsInThePushedManifest() {
+        final var current = StorageId.forAccount(new byte[]{2});
+        final var older = StorageId.forAccount(new byte[]{1});
+        final var contact = StorageId.forContact(new byte[]{3});
+        assertTrue(StorageHelper.isSelfRecordPushed(current, List.of(contact, current)));
+        // a newer edit rotated the id after the manifest was built
+        assertFalse(StorageHelper.isSelfRecordPushed(current, List.of(contact, older)));
+    }
+}
diff --git a/lib/src/test/java/org/asamk/signal/manager/syncStorage/AccountRecordProfileWinsTest.java b/lib/src/test/java/org/asamk/signal/manager/syncStorage/AccountRecordProfileWinsTest.java
