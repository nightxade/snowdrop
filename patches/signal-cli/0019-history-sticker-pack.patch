+                var sticker = frame.getChatItem().getStickerMessage().getSticker();
+                if (sticker.getPackId().isEmpty() || sticker.getPackKey().isEmpty()) {
+                    throw new IOException("This history sticker has no pack key");
+                }
+                return new StickerPackRef(sticker.getPackId().toByteArray(), sticker.getPackKey().toByteArray());
+            }
+        } catch (SQLException e) { throw new IOException("Cannot read history sticker", e); }
+    }
