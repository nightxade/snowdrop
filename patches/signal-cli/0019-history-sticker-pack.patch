@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.IOErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+
+import java.io.IOException;
+import java.util.Map;
+
+/**
+ * Registers a history sticker's pack (id + decryption key) in the local
+ * sticker store so {@code getSticker} can retrieve it, without installing
+ * the pack or syncing anything to the primary device — see
+ * {@link Manager#registerHistoryStickerPack}. See patches/signal-cli/
+ * README.md "0019: history sticker pack".
+ */
+public class RegisterHistoryStickerPackCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "registerHistoryStickerPack";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Register a history sticker's pack key so getSticker can retrieve it.");
+        subparser.addArgument("--id")
+                .required(true)
+                .help("The opaque history sticker id (a message's own, as getHistory returns it).");
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var id = ns.getString("id");
+        if (id == null) {
+            throw new UserErrorException("Missing id parameter");
+        }
+        try {
+            m.registerHistoryStickerPack(id);
+        } catch (IOException ex) {
+            throw new IOErrorException("Could not register history sticker pack: " + id, ex);
+        }
+        switch (outputWriter) {
+            case PlainTextWriter writer -> writer.println("Registered");
+            case JsonWriter writer -> writer.write(Map.of("registered", true));
+        }
+    }
+}
