+    public StickerPackRef stickerPack(String id, long now) throws IOException {
+        var parts = id.split(":", -1);
+        if (parts.length != 5 || !parts[0].equals("history") || !parts[3].equals("sticker") || !parts[4].equals("0")) {
+            throw new IOException("Invalid history sticker id");
+        }
+        final long ordinal;
+        try {
+            if (!UUID.fromString(parts[1]).toString().equals(parts[1]) || !parts[2].matches("[1-9][0-9]*")) {
+                throw new IllegalArgumentException();
+            }
+            ordinal = Long.parseLong(parts[2]);
+        } catch (IllegalArgumentException e) { throw new IOException("Invalid history sticker id", e); }
+        try (var connection = connections.open(); var query = connection.prepareStatement("""
