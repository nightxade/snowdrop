--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/history/HistoryFramesTest.java
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import java.io.IOException;
+import java.util.ArrayList;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryFramesTest {
+    private final ArrayList<Backups.Frame> received = new ArrayList<>();
+    private final HistoryFrames decoder = new HistoryFrames(new HistoryFrames.Visitor() {
+        public void info(Backups.BackupInfo info) { assertEquals(1, info.getVersion()); }
+        public void frame(Backups.Frame frame) { received.add(frame); }
+    });
+
+    private void start() throws IOException {
+        decoder.accept(Backups.BackupInfo.newBuilder().setVersion(1).build().toByteArray());
+        decoder.accept(Backups.Frame.newBuilder().setAccount(Backups.AccountData.getDefaultInstance())
+                .build().toByteArray());
+    }
+
+    @Test void decodesOfficialSignalFixture() throws Exception {
+        try (var input = getClass().getResourceAsStream("/history/canonical-backup.binproto")) {
+            assertNotNull(input);
+            var info = Backups.BackupInfo.parseDelimitedFrom(input);
+            decoder.accept(info.toByteArray());
+            Backups.Frame frame;
+            while ((frame = Backups.Frame.parseDelimitedFrom(input)) != null) {
+                decoder.accept(frame.toByteArray());
+            }
+        }
+        decoder.finish();
+        assertEquals(5, received.size());
+        assertTrue(received.getFirst().hasAccount());
+        assertEquals(4, received.stream().filter(Backups.Frame::hasRecipient).count());
+    }
+
+    @Test void preservesMessageContentAndExpiration() throws Exception {
+        start();
+        var item = Backups.ChatItem.newBuilder().setChatId(7).setAuthorId(3)
+                .setDateSent(123).setExpireStartDate(200).setExpiresInMs(5000)
+                .setIncoming(Backups.ChatItem.IncomingMessageDetails.newBuilder().setDateReceived(124))
+                .setStandardMessage(Backups.StandardMessage.newBuilder()
+                        .setText(Backups.Text.newBuilder().setBody("hello 🌸")))
+                .build();
+        decoder.accept(Backups.Frame.newBuilder().setChatItem(item).build().toByteArray());
+        decoder.finish();
+        assertEquals(item, received.getLast().getChatItem());
+    }
+
+    @Test void ignoresUnknownFramesWithoutLosingFollowingFrames() throws Exception {
+        start();
+        decoder.accept(new byte[]{(byte) 0xa2, 6, 0}); // field 100, empty bytes
+        decoder.accept(Backups.Frame.newBuilder().setChat(Backups.Chat.newBuilder().setId(8))
+                .build().toByteArray());
+        decoder.finish();
+        assertEquals(2, received.size());
+        assertEquals(8, received.getLast().getChat().getId());
+    }
+
+    @Test void rejectsUnsupportedVersionsAndIncompleteArchives() {
+        assertThrows(IOException.class, () -> decoder.accept(
+                Backups.BackupInfo.newBuilder().setVersion(2).build().toByteArray()));
+        assertThrows(IOException.class, decoder::finish);
+    }
+
+    @Test void rejectsMissingOrDuplicateAccountFrames() throws Exception {
+        decoder.accept(Backups.BackupInfo.newBuilder().setVersion(1).build().toByteArray());
+        assertThrows(IOException.class, () -> decoder.accept(Backups.Frame.newBuilder()
+                .setChat(Backups.Chat.newBuilder().setId(8)).build().toByteArray()));
+        decoder.accept(Backups.Frame.newBuilder().setAccount(Backups.AccountData.getDefaultInstance())
+                .build().toByteArray());
+        assertThrows(IOException.class, () -> decoder.accept(Backups.Frame.newBuilder()
+                .setAccount(Backups.AccountData.getDefaultInstance()).build().toByteArray()));
+    }
+}
diff --git a/lib/src/test/java/org/asamk/signal/manager/history/HistoryJsonTest.java b/lib/src/test/java/org/asamk/signal/manager/history/HistoryJsonTest.java
new file mode 100644
index 0000000..e5610bb
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/history/HistoryJsonTest.java
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import com.google.protobuf.ByteString;
+import java.util.List;
+import java.util.Map;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HistoryJsonTest {
+    @Test void keepsUnsignedIdsExactAndRecursivelyConvertsMessages() {
+        var revision = Backups.ChatItem.newBuilder().setDateSent(42).build();
+        var message = Backups.ChatItem.newBuilder().setChatId(-1L).setExpiresInMs(5000)
+                .addRevisions(revision).setStandardMessage(Backups.StandardMessage.newBuilder()
+                        .setText(Backups.Text.newBuilder().setBody("hello"))).build();
+        var json = HistoryJson.fields(message);
+        assertEquals("18446744073709551615", json.get("chatId"));
+        assertEquals("5000", json.get("expiresInMs"));
+        assertEquals(List.of(Map.of("dateSent", "42")), json.get("revisions"));
+        assertEquals(Map.of("text", Map.of("body", "hello")), json.get("standardMessage"));
+    }
+
+    @Test void preservesUnsigned32BitFields() {
+        var chat = Backups.Chat.newBuilder().setExpireTimerVersion(-1).build();
+        assertEquals(4294967295L, HistoryJson.fields(chat).get("expireTimerVersion"));
+    }
+
+    @Test void encodesBinaryFieldsAsBase64() {
+        var info = Backups.BackupInfo.newBuilder().setMediaRootBackupKey(
+                ByteString.copyFrom(new byte[]{1, 2, 3})).build();
+        assertEquals("AQID", HistoryJson.fields(info).get("mediaRootBackupKey"));
+    }
+}
