+    /**
+     * Notifies subscribers each time the manager's receive loop catches up with
+     * messages queued on the server (and again after every reconnect), mirroring
+     * {@link #createReceiveHandler} but with no envelope payload.
+     */
+    private Pair<Manager, Runnable> createCaughtUpHandler(
+            final Manager m,
+            final int subscriptionId,
+            final boolean internalSubscription
+    ) {
+        final Runnable listener = () -> {
+            final var result = new HashMap<String, Object>();
+            result.put("account", m.getSelfNumber());
+            ContainerNode<?> params;
+            if (internalSubscription) {
+                params = objectMapper.valueToTree(result);
+            } else {
+                final var paramsNode = new ObjectNode(objectMapper.getNodeFactory());
+                paramsNode.set("subscription", IntNode.valueOf(subscriptionId));
+                paramsNode.set("result", objectMapper.valueToTree(result));
+                params = paramsNode;
+            }
+            final var jsonRpcRequest = JsonRpcRequest.forNotification("receiveCaughtUp", params, null);
+            try {
+                jsonRpcSender.sendRequest(jsonRpcRequest);
+            } catch (AssertionError e) {
+                if (e.getCause() instanceof ClosedChannelException) {
+                    unsubscribeReceive(subscriptionId);
+                }
+            }
+        };
+        m.addCaughtUpWithOldMessagesListener(listener);
+        return new Pair<>(m, listener);
+    }
+
     private boolean unsubscribeReceive(final int subscriptionId) {
         final var handlers = receiveHandlers.remove(subscriptionId);
+        final var caughtUp = caughtUpHandlers.remove(subscriptionId);
         if (handlers == null) {
             return false;
         }
         for (final var pair : handlers) {
             unsubscribeReceiveHandler(pair);
         }
+        if (caughtUp != null) {
+            for (final var pair : caughtUp) {
+                unsubscribeCaughtUpHandler(pair);
+            }
+        }
         return true;
     }
 
