+++ b/src/test/java/org/asamk/signal/jsonrpc/ReceiveCaughtUpNotificationTest.java
@@ -0,0 +1,259 @@
+package org.asamk.signal.jsonrpc;
+
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.MultiAccountManager;
+import org.asamk.signal.manager.ProvisioningManager;
+import org.asamk.signal.manager.RegistrationManager;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.testutil.ManagerMock;
+import org.junit.jupiter.api.Test;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Queue;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Tests for the {@code receiveCaughtUp} JSON-RPC notification: sent whenever a
+ * manager's receive loop catches up with messages that were queued on the
+ * server (snowdrop-history patch).
+ */
+class ReceiveCaughtUpNotificationTest {
+
+    /**
+     * Feeds pre-configured JSON-RPC lines to the handler, then returns null to end.
+     */
+    private static class LineFeeder {
+
+        private final Queue<String> lines = new ConcurrentLinkedQueue<>();
+
+        void addLine(String line) {
+            lines.add(line);
+        }
+
+        String getLine() {
+            return lines.poll();
+        }
+    }
+
+    /**
+     * Captures JSON-RPC requests/responses written by the handler.
+     */
+    private static class CapturingJsonWriter implements JsonWriter {
+
+        final List<Object> written = Collections.synchronizedList(new ArrayList<>());
+
+        @Override
+        public void write(final Object object) {
+            written.add(object);
+        }
+    }
+
+    private record ManagedManager(Manager manager, ManagerMock.State state) {}
+
+    private static ManagedManager createManager(final String selfNumber) {
+        final var state = new ManagerMock.State();
+        return new ManagedManager(ManagerMock.create(selfNumber, state), state);
+    }
+
+    /**
+     * Minimal MultiAccountManager stub for multi-account mode tests.
+     */
+    private static class StubMultiAccountManager implements MultiAccountManager {
+
+        final List<Manager> managers;
+        final List<Consumer<Manager>> addedHandlers = new ArrayList<>();
+
+        StubMultiAccountManager(List<Manager> managers) {
+            this.managers = new ArrayList<>(managers);
+        }
+
+        @Override
+        public List<String> getAccountNumbers() {
+            return managers.stream().map(Manager::getSelfNumber).toList();
+        }
+
+        @Override
+        public List<Manager> getManagers() {
+            return managers;
+        }
+
+        @Override
+        public void addOnManagerAddedHandler(Consumer<Manager> handler) {
+            addedHandlers.add(handler);
+        }
+
+        @Override
+        public void addOnManagerRemovedHandler(Consumer<Manager> handler) {
+        }
+
+        @Override
+        public Manager getManager(String phoneNumber) {
+            return managers.stream().filter(m -> phoneNumber.equals(m.getSelfNumber())).findFirst().orElse(null);
+        }
+
+        @Override
+        public URI getNewProvisioningDeviceLinkUri() {
+            return null;
+        }
+
+        @Override
+        public ProvisioningManager getProvisioningManagerFor(URI u) {
+            return null;
+        }
+
+        @Override
+        public RegistrationManager getNewRegistrationManager(String a) {
+            return null;
+        }
+
+        @Override
+        public void close() {
+        }
+    }
+
+    private static String jsonRpcCall(int id, String method) {
+        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"" + method + "\"}";
+    }
+
+    private static String jsonRpcCall(int id, String method, String params) {
+        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"" + method + "\",\"params\":" + params + "}";
+    }
+
+    private static List<JsonRpcRequest> notificationsNamed(final CapturingJsonWriter writer, final String method) {
+        return writer.written.stream()
+                .filter(JsonRpcRequest.class::isInstance)
+                .map(JsonRpcRequest.class::cast)
+                .filter(r -> method.equals(r.getMethod()))
+                .toList();
+    }
+
+    // --- Single-account mode ---
+
+    @Test
+    void notSubscribedWhenReceiveIsNotSubscribed() {
+        var manager = createManager("+15551234567");
+        var feeder = new LineFeeder();
+        var writer = new CapturingJsonWriter();
+
+        // noReceiveOnStart = true: no implicit subscribeReceive, so no caught-up listener either.
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder::getLine, true);
+        handler.handleConnection(manager.manager());
+
+        assertEquals(0, manager.state().addCaughtUpListenerCount.get(), "should not auto-subscribe");
+    }
+
+    @Test
+    void firesNotificationWithAccountOnDefaultSubscription() {
+        var manager = createManager("+15551234567");
+        var writer = new CapturingJsonWriter();
+
+        // Simulate the receive loop catching up with the server queue the instant the
+        // connection is handled, then end the connection.
+        Supplier<String> feeder = () -> {
+            manager.state().fireCaughtUp();
+            return null;
+        };
+
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder, false);
+        handler.handleConnection(manager.manager());
+
+        assertEquals(1, manager.state().addCaughtUpListenerCount.get(), "default subscribeReceive should register one");
+        assertEquals(1, manager.state().removeCaughtUpListenerCount.get(), "cleanup should remove it");
+
+        var notifications = notificationsNamed(writer, "receiveCaughtUp");
+        assertEquals(1, notifications.size());
+        assertEquals("+15551234567", notifications.get(0).getParams().get("account").asText());
+        // The default (internal) subscription sends bare params, with no "subscription" wrapper.
+        assertNull(notifications.get(0).getParams().get("subscription"));
+    }
+
+    @Test
+    void explicitSubscriptionWrapsResultWithSubscriptionId() {
+        var manager = createManager("+15551234567");
+        var writer = new CapturingJsonWriter();
+        var lines = new LineFeeder();
+        lines.addLine(jsonRpcCall(1, "subscribeReceive"));
+
+        Supplier<String> feeder = () -> {
+            var next = lines.getLine();
+            if (next != null) {
+                return next;
+            }
+            // The subscribeReceive command above is handled on another (virtual) thread;
+            // wait for it to register before firing, bounded so a stuck test still fails fast.
+            for (var i = 0; i < 1000 && manager.state().addCaughtUpListenerCount.get() == 0; i++) {
+                try {
+                    Thread.sleep(1);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+            }
+            manager.state().fireCaughtUp();
+            return null;
+        };
+
+        // noReceiveOnStart = true, so the only subscription is the explicit one above.
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder, true);
+        handler.handleConnection(manager.manager());
+
+        var notifications = notificationsNamed(writer, "receiveCaughtUp");
+        assertEquals(1, notifications.size());
+        // Explicit (non-default) subscriptions wrap the payload with their subscription id,
+        // unlike the bare params the default subscription sends (see the test above).
+        assertTrue(notifications.get(0).getParams().get("subscription").isInt());
+        assertEquals("+15551234567", notifications.get(0).getParams().get("result").get("account").asText());
+    }
+
+    @Test
+    void unsubscribeReceiveStopsCaughtUpNotifications() {
+        var manager = createManager("+15551234567");
+        var feeder = new LineFeeder();
+        var writer = new CapturingJsonWriter();
+
+        feeder.addLine(jsonRpcCall(1, "subscribeReceive"));
+        feeder.addLine(jsonRpcCall(2, "unsubscribeReceive", "{\"subscription\":0}"));
+
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder::getLine, true);
+        handler.handleConnection(manager.manager());
+
+        assertEquals(1, manager.state().addCaughtUpListenerCount.get());
+        assertEquals(1, manager.state().removeCaughtUpListenerCount.get(), "explicit unsubscribe should remove it");
+        assertEquals(0, manager.state().caughtUpListeners.size());
+
+        // Firing after unsubscribe must not produce a notification.
+        manager.state().fireCaughtUp();
+        assertEquals(0, notificationsNamed(writer, "receiveCaughtUp").size());
+    }
+
+    // --- Multi-account mode ---
+
+    @Test
+    void multiAccountNotificationNamesTheRightAccount() {
+        var manager1 = createManager("+15551111111");
+        var manager2 = createManager("+15552222222");
+        var multi = new StubMultiAccountManager(List.of(manager1.manager(), manager2.manager()));
+        var writer = new CapturingJsonWriter();
+
+        Supplier<String> feeder = () -> {
+            manager2.state().fireCaughtUp();
+            return null;
+        };
+
+        var handler = new SignalJsonRpcDispatcherHandler(writer, feeder, false);
+        handler.handleConnection(multi);
+
+        var notifications = notificationsNamed(writer, "receiveCaughtUp");
+        assertEquals(1, notifications.size(), "only manager2 caught up");
+        assertEquals("+15552222222", notifications.get(0).getParams().get("account").asText());
+    }
+}
