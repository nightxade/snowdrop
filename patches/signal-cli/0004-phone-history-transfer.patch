+    public org.asamk.signal.manager.history.LinkHistoryTransfer.Outcome importLinkedHistory(
+            byte[] ephemeralKey, java.nio.file.Path directory
+    ) throws IOException {
+        try {
+            final var key = new org.signal.core.models.backup.MessageBackupKey(ephemeralKey);
+            final var secrets = key.deriveBackupSecrets(account.getAci(), null);
+            try {
+                final var store = getHistoryStore();
+                return new org.asamk.signal.manager.history.LinkHistoryTransfer().run(
+                        new org.asamk.signal.manager.history.LinkHistoryTransfer.Client() {
+                            @Override public org.asamk.signal.manager.history.LinkHistoryTransfer.Reply poll() throws IOException {
+                                var request = new org.signal.network.websocket.WebSocketRequestMessage.Builder()
+                                        .id(new java.security.SecureRandom().nextLong())
+                                        .verb("GET").path("/v1/devices/transfer_archive?timeout=5").build();
+                                try {
+                                    var response = dependencies.getAuthenticatedSignalWebSocket().request(request)
+                                            .timeout(15, java.util.concurrent.TimeUnit.SECONDS).blockingGet();
+                                    return new org.asamk.signal.manager.history.LinkHistoryTransfer.Reply(
+                                            response.getStatus(), response.getBody());
+                                } catch (RuntimeException e) { throw new IOException("History transfer connection failed", e); }
+                            }
+                            @Override public void download(int cdn, String cdnKey, java.nio.file.Path target) throws IOException {
+                                handleResponseException(dependencies.getMessageReceiver().retrieveLinkAndSyncBackup(
+                                        cdn, cdnKey, target.toFile(), null));
+                            }
+                        },
+                        archive -> store.importArchive(archive, secrets.getAesKey(), secrets.getMacKey(), System.currentTimeMillis()),
+                        directory);
+            } finally {
+                java.util.Arrays.fill(secrets.getAesKey(), (byte) 0);
+                java.util.Arrays.fill(secrets.getMacKey(), (byte) 0);
+            }
+        } finally {
+            java.util.Arrays.fill(ephemeralKey, (byte) 0);
+        }
+    }
+
     private static final Logger logger = LoggerFactory.getLogger(ManagerImpl.class);
 
     private SignalAccount account;
