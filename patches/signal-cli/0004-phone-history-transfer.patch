+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import org.junit.jupiter.api.Test;
+import org.thoughtcrime.securesms.backup.v2.proto.Backups;
+import org.junit.jupiter.api.io.TempDir;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayDeque;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LinkHistoryTransferTest {
+    @TempDir Path directory;
+    private final AtomicLong clock = new AtomicLong();
+    private LinkHistoryTransfer transfer() {
+        return new LinkHistoryTransfer(clock::get, () -> clock.addAndGet(1_000_000_000), Duration.ofSeconds(3));
+    }
+    private static class Client implements LinkHistoryTransfer.Client {
+        final ArrayDeque<LinkHistoryTransfer.Reply> replies;
+        int downloads;
+        Client(LinkHistoryTransfer.Reply... replies) { this.replies = new ArrayDeque<>(List.of(replies)); }
+        public LinkHistoryTransfer.Reply poll() { return replies.remove(); }
+        public void download(int cdn, String key, Path destination) throws IOException {
+            assertEquals(3, cdn);
+            assertEquals("archive-key", key);
+            downloads++;
+            Files.writeString(destination, "encrypted bytes");
+        }
+    }
+    private LinkHistoryTransfer.Reply ready() {
+        return new LinkHistoryTransfer.Reply(200, "{\"cdn\":3,\"key\":\"archive-key\"}");
+    }
+    private void assertClean() throws IOException {
+        try (var files = Files.list(directory)) { assertEquals(0, files.count()); }
+    }
+    @Test void waitsForUploadThenImportsAndDeletesArchive() throws Exception {
+        var client = new Client(new LinkHistoryTransfer.Reply(204, ""), ready());
+        var imports = new AtomicLong();
+        assertEquals(LinkHistoryTransfer.Outcome.IMPORTED, transfer().run(client, file -> {
+            assertEquals("encrypted bytes", Files.readString(file));
+            imports.incrementAndGet();
+        }, directory));
+        assertEquals(1, client.downloads);
+        assertEquals(1, imports.get());
+        assertClean();
+    }
+    @Test void respectsPhoneDecliningTransfer() throws Exception {
+        var client = new Client(new LinkHistoryTransfer.Reply(200, "{\"error\":\"CONTINUE_WITHOUT_UPLOAD\"}"));
+        assertEquals(LinkHistoryTransfer.Outcome.DECLINED,
+                transfer().run(client, file -> fail("Must not import"), directory));
+        assertEquals(0, client.downloads);
+        assertClean();
+    }
+    @Test void stopsPollingAtDeadline() throws Exception {
+        var waiting = new LinkHistoryTransfer.Reply(204, "");
+        var client = new Client(waiting, waiting, waiting);
+        assertThrows(IOException.class, () -> transfer().run(client, file -> fail("Must not import"), directory));
+        assertEquals(3_000_000_000L, clock.get());
+        assertEquals(0, client.downloads);
+        assertClean();
+    }
+    @Test void rejectsErrorsAndMalformedLocations() throws Exception {
+        for (var reply : List.of(new LinkHistoryTransfer.Reply(403, ""),
+                new LinkHistoryTransfer.Reply(200, "{\"error\":\"RELINK_REQUESTED\"}"),
+                new LinkHistoryTransfer.Reply(200, "{\"cdn\":3}"),
+                new LinkHistoryTransfer.Reply(200, "{\"cdn\":3.5,\"key\":\"archive-key\"}"))) {
+            var client = new Client(reply);
+            assertThrows(IOException.class, () -> transfer().run(client, file -> fail("Must not import"), directory));
+            assertEquals(0, client.downloads);
+        }
+        assertClean();
+    }
+    @Test void deletesArchiveAfterImportFailure() throws Exception {
+        var client = new Client(ready());
+        assertThrows(IOException.class, () -> transfer().run(client, file -> {
+            throw new IOException("Authentication failed");
+        }, directory));
+        assertEquals(1, client.downloads);
+        assertClean();
+    }
+    @Test void retrievesMessagesFromAnAuthenticatedEncryptedDownload() throws Exception {
+        var plaintext = new java.io.ByteArrayOutputStream();
+        Backups.BackupInfo.newBuilder().setVersion(1).build()
+                .writeDelimitedTo(plaintext);
+        Backups.Frame.newBuilder().setAccount(
+                Backups.AccountData.getDefaultInstance()).build()
+                .writeDelimitedTo(plaintext);
+        Backups.Frame.newBuilder().setRecipient(
+                Backups.Recipient.newBuilder().setId(1).setSelf(
+                        Backups.Self.getDefaultInstance())).build()
+                .writeDelimitedTo(plaintext);
+        Backups.Frame.newBuilder().setChat(
+                Backups.Chat.newBuilder().setId(2).setRecipientId(1)).build()
+                .writeDelimitedTo(plaintext);
+        Backups.Frame.newBuilder().setChatItem(
+                Backups.ChatItem.newBuilder().setChatId(2).setAuthorId(1)
+                        .setDateSent(1234).setIncoming(
+                                Backups.ChatItem.IncomingMessageDetails.getDefaultInstance())
+                        .setStandardMessage(Backups.StandardMessage.newBuilder()
+                                .setText(Backups.Text.newBuilder().setBody("from phone"))))
+                .build().writeDelimitedTo(plaintext);
+        byte[] aes = new byte[32], mac = new byte[32], iv = new byte[16];
+        java.util.Arrays.fill(aes, (byte) 0x42);
+        java.util.Arrays.fill(mac, (byte) 0x13);
+        var compressed = new java.io.ByteArrayOutputStream();
+        try (var gzip = new java.util.zip.GZIPOutputStream(compressed)) { gzip.write(plaintext.toByteArray()); }
+        compressed.write(new byte[40]);
+        var cipher = javax.crypto.Cipher.getInstance("AES/CBC/PKCS5Padding");
+        cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.SecretKeySpec(aes, "AES"),
+                new javax.crypto.spec.IvParameterSpec(iv));
+        var encrypted = new java.io.ByteArrayOutputStream();
+        encrypted.write(iv);
+        encrypted.write(cipher.doFinal(compressed.toByteArray()));
+        var hmac = javax.crypto.Mac.getInstance("HmacSHA256");
+        hmac.init(new javax.crypto.spec.SecretKeySpec(mac, "HmacSHA256"));
+        encrypted.write(hmac.doFinal(encrypted.toByteArray()));
+        var store = new HistoryStore(() -> java.sql.DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("account.db")));
+        var client = new Client(ready()) {
+            @Override public void download(int cdn, String key, Path target) throws IOException {
+                Files.write(target, encrypted.toByteArray());
+            }
+        };
+        assertEquals(LinkHistoryTransfer.Outcome.IMPORTED, transfer().run(client,
+                file -> store.importArchive(file, aes, mac, 2000), directory));
+        var page = store.page(null, 0, 100, 2000);
+        assertNotNull(page.archiveId());
+        assertEquals(3, page.entries().size());
+        assertTrue(page.entries().getLast().frame().toString().contains("from phone"));
+        assertFalse(page.hasMore());
+        try (var files = Files.list(directory)) {
+            assertFalse(files.anyMatch(file -> file.getFileName().toString().startsWith("link-history-")));
+        }
+    }
+
+}
