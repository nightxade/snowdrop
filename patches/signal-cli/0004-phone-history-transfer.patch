+    /** The history import, as {@link #runHistoryImport} runs it. */
+    @FunctionalInterface
+    interface HistoryImport {
+
+        org.asamk.signal.manager.history.LinkHistoryTransfer.Outcome run() throws IOException;
+    }
+
+    /**
+     * Runs the history import and returns its outcome name, or {@code "FAILED"} if it throws
+     * anything but an {@link Error}. Linking is already committed when this runs, so a failed
+     * import (a libsignal, SQLite or validation failure, not only an {@link IOException}) must not
+     * abort the rest of {@code finishLink}: the account stays linked and the sync request still goes out.
+     */
+    static String runHistoryImport(final HistoryImport historyImport) {
+        try {
+            final var outcome = historyImport.run();
+            logger.info("Phone history transfer: {}", outcome);
+            return outcome.name();
+        } catch (IOException | RuntimeException e) {
+            // Keep the usable account and make the separate history failure explicit instead of
+            // breaking linking.
+            logger.error("Device linked, but history import failed. A fresh link is required to retry history transfer.", e);
+            return "FAILED";
+        }
+    }
+
