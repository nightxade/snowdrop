+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.internal;
+
+import org.asamk.signal.manager.history.LinkHistoryTransfer;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ProvisioningManagerImplHistoryImportTest {
+
+    @Test
+    void reportsTheOutcomeOfASuccessfulImport() {
+        assertEquals("IMPORTED", ProvisioningManagerImpl.runHistoryImport(() -> LinkHistoryTransfer.Outcome.IMPORTED));
+        assertEquals("DECLINED", ProvisioningManagerImpl.runHistoryImport(() -> LinkHistoryTransfer.Outcome.DECLINED));
+    }
+
+    @Test
+    void anIoFailureMarksTheTransferFailed() {
+        assertEquals("FAILED", ProvisioningManagerImpl.runHistoryImport(() -> {
+            throw new IOException("connection lost");
+        }));
+    }
+
+    @Test
+    void aRuntimeFailureMarksTheTransferFailedInsteadOfAbortingFinishLink() {
+        assertEquals("FAILED", ProvisioningManagerImpl.runHistoryImport(() -> {
+            throw new IllegalStateException("key derivation failed");
+        }));
+        assertEquals("FAILED", ProvisioningManagerImpl.runHistoryImport(() -> {
+            throw new IllegalArgumentException("bad archive");
+        }));
+    }
+}
