+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.history;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.function.LongSupplier;
+
+/** Polling and cleanup for the phone's temporary link-and-sync archive. */
+public final class LinkHistoryTransfer {
+    public enum Outcome { IMPORTED, DECLINED }
+    public record Reply(int status, String body) {}
+    public interface Client {
+        Reply poll() throws IOException;
+        void download(int cdn, String key, Path destination) throws IOException;
+    }
+    @FunctionalInterface public interface Importer { void read(Path archive) throws IOException; }
+    @FunctionalInterface interface Pause { void sleep() throws InterruptedException; }
+    private final LongSupplier nanoTime;
+    private final Pause pause;
+    private final long timeout;
+
+    public LinkHistoryTransfer() {
+        this(System::nanoTime, () -> Thread.sleep(100), Duration.ofMinutes(10));
+    }
+    LinkHistoryTransfer(LongSupplier nanoTime, Pause pause, Duration timeout) {
+        this.nanoTime = nanoTime;
+        this.pause = pause;
+        this.timeout = timeout.toNanos();
+    }
+
+    public Outcome run(Client client, Importer importer, Path privateDirectory) throws IOException {
+        long start = nanoTime.getAsLong();
+        while (nanoTime.getAsLong() - start < timeout) {
+            if (Thread.currentThread().isInterrupted()) throw new IOException("History transfer interrupted");
+            var reply = client.poll();
+            if (reply.status() == 204) {
+                try { pause.sleep(); }
+                catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new IOException("History transfer interrupted", e);
+                }
+                continue;
+            }
+            if (reply.status() != 200) throw new IOException("History transfer request failed (HTTP " + reply.status() + ")");
+            var body = new ObjectMapper().readTree(reply.body());
+            if (body == null || !body.isObject()) throw new IOException("Invalid history transfer response");
+            if (body.hasNonNull("error")) {
+                if ("CONTINUE_WITHOUT_UPLOAD".equals(body.path("error").asText())) return Outcome.DECLINED;
+                if ("RELINK_REQUESTED".equals(body.path("error").asText())) {
+                    throw new IOException("The phone requested a fresh link for history transfer");
+                }
+                throw new IOException("The phone could not provide history");
+            }
+            var cdn = body.path("cdn");
+            var key = body.path("key");
+            if (!cdn.isIntegralNumber() || !cdn.canConvertToInt() || cdn.intValue() < 0
+                    || !key.isTextual() || key.textValue().isEmpty() || key.textValue().length() > 4096) {
+                throw new IOException("Invalid history archive location");
+            }
+            var archive = Files.createTempFile(privateDirectory, "link-history-", ".encrypted");
+            try {
+                client.download(cdn.intValue(), key.textValue(), archive);
+                importer.read(archive);
+                return Outcome.IMPORTED;
+            } finally {
+                Files.deleteIfExists(archive);
+            }
+        }
+        throw new IOException("Timed out waiting for phone history");
+    }
+}
