new file mode 100644
index 0000000..fc4ffce
--- /dev/null
+++ b/src/main/java/org/asamk/signal/commands/InstallKnownStickerPackCommand.java
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.IOErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.StickerPackId;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+import org.asamk.signal.util.Hex;
+
+import java.io.IOException;
+import java.util.Map;
+
+/**
+ * Installs a sticker pack this account already knows, by pack id alone — the
+ * key never leaves signal-cli's own sticker store. The install is synced to
+ * the primary device, like {@code addStickerPack}. See
+ * {@link Manager#installKnownStickerPack} and patches/signal-cli/README.md
+ * "0021: install a known sticker pack".
+ */
+public class InstallKnownStickerPackCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "installKnownStickerPack";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Install a sticker pack this account already knows, by its pack id.");
+        subparser.addArgument("--pack-id").required(true).help("The ID of the sticker pack.");
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var rawId = ns.getString("pack-id");
+        if (rawId == null || !rawId.matches("[0-9a-fA-F]{2,128}") || rawId.length() % 2 != 0) {
+            throw new UserErrorException("Invalid sticker pack id");
+        }
+        try {
+            m.installKnownStickerPack(StickerPackId.deserialize(Hex.toByteArray(rawId)));
+        } catch (IOException ex) {
+            throw new IOErrorException("Could not install the sticker pack", ex);
+        }
+        switch (outputWriter) {
+            case PlainTextWriter writer -> writer.println("Installed");
+            case JsonWriter writer -> writer.write(Map.of("installed", true));
+        }
+    }
+}
