@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.asamk.signal.manager.api.StickerPackId;
+import org.asamk.signal.manager.storage.AccountDatabase;
+import org.asamk.signal.manager.storage.stickers.StickerPack;
+import org.asamk.signal.manager.storage.stickers.StickerStore;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class StickerHelperTest {
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private StickerStore store;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        store = new StickerStore(database);
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    private static StickerPackId id(final int b) {
+        return StickerPackId.deserialize(new byte[]{(byte) b, 2, 3, 4});
+    }
+
+    @Test
+    void refusesAPackTheAccountNeverLearnedOf() {
+        assertThrows(IOException.class, () -> StickerHelper.requireKnownPack(store, id(1)));
+    }
+
+    @Test
+    void findsAPackRegisteredButNotInstalledAndKeepsItOffThePhoneUntilInstalled() throws Exception {
+        final var key = new byte[]{9, 8, 7, 6};
+        // The state a live-received or history-registered sticker leaves behind.
+        store.addStickerPack(new StickerPack(id(1), key));
+        final var known = StickerHelper.requireKnownPack(store, id(1));
+        assertArrayEquals(key, known.packKey());
+        assertFalse(known.isInstalled());
+        assertNull(known.storageId());
+
+        // What the install path does with it: installed, and now synced (it has a storage id).
+        store.updateStickerPackInstalled(id(1), true);
+        final var installed = StickerHelper.requireKnownPack(store, id(1));
+        assertTrue(installed.isInstalled());
+        assertFalse(installed.storageId() == null);
+        assertArrayEquals(key, installed.packKey());
+    }
+}
