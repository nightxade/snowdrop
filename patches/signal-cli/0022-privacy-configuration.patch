+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.Configuration;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class GetConfigurationCommandTest {
+
+    private static Manager managerReturning(final Configuration configuration) {
+        return (Manager) Proxy.newProxyInstance(Manager.class.getClassLoader(),
+                new Class<?>[]{Manager.class},
+                (proxy, method, args) -> {
+                    assertEquals("getConfiguration", method.getName());
+                    return configuration;
+                });
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void reportsKnownValuesAndKeepsUnknownOnesAsExplicitNulls() throws Exception {
+        final var manager = managerReturning(new Configuration(Optional.of(false),
+                Optional.empty(),
+                Optional.of(true),
+                Optional.empty()));
+        final var output = new AtomicReference<Object>();
+        new GetConfigurationCommand().handleCommand(Map.of(), manager, output::set);
+
+        final var json = (Map<String, Object>) output.get();
+        assertEquals(false, json.get("readReceipts"));
+        assertEquals(true, json.get("typingIndicators"));
+        assertTrue(json.containsKey("linkPreviews"));
+        assertNull(json.get("linkPreviews"));
+        assertTrue(json.containsKey("unidentifiedDeliveryIndicators"));
+        assertNull(json.get("unidentifiedDeliveryIndicators"));
+        assertEquals(4, json.size(), "nothing but the four privacy settings is exposed");
+    }
+}
