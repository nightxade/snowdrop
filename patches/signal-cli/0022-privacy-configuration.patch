+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.Configuration;
+import org.asamk.signal.output.JsonWriter;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.output.PlainTextWriter;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+
+/**
+ * Returns the stored privacy configuration: the settings the phone syncs to this
+ * linked device (configuration sync message and storage-service account record).
+ * Each value is {@code true}, {@code false}, or {@code null} when the phone has
+ * not told this device yet. See patches/signal-cli/README.md
+ * "0022: privacy configuration".
+ */
+public class GetConfigurationCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "getConfiguration";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Show the privacy settings synced with the phone (read receipts, typing indicators, "
+                + "link previews, unidentified delivery indicators).");
+    }
+
+    static Map<String, Object> toJson(final Configuration configuration) {
+        final var json = new LinkedHashMap<String, Object>();
+        json.put("readReceipts", orNull(configuration.readReceipts()));
+        json.put("typingIndicators", orNull(configuration.typingIndicators()));
+        json.put("linkPreviews", orNull(configuration.linkPreviews()));
+        json.put("unidentifiedDeliveryIndicators", orNull(configuration.unidentifiedDeliveryIndicators()));
+        return json;
+    }
+
+    private static Boolean orNull(final Optional<Boolean> value) {
+        return value.orElse(null);
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var json = toJson(m.getConfiguration());
+        switch (outputWriter) {
+            case JsonWriter writer -> writer.write(json);
+            case PlainTextWriter writer -> json.forEach((key, value) -> writer.println("{}: {}",
+                    key,
+                    value == null ? "unknown" : value));
+        }
+    }
+}
