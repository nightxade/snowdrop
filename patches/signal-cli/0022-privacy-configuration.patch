@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.storage.configuration;
+
+import org.asamk.signal.manager.storage.AccountDatabase;
+import org.asamk.signal.manager.storage.keyValue.KeyValueStore;
+import org.asamk.signal.manager.storage.recipients.RecipientAddress;
+import org.asamk.signal.manager.storage.recipients.RecipientStore;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ConfigurationStoreTest {
+
+    @TempDir Path directory;
+
+    private AccountDatabase database;
+    private ConfigurationStore store;
+    private final AtomicInteger notifications = new AtomicInteger();
+
+    @BeforeEach
+    void setUp() throws Exception {
+        database = AccountDatabase.init(directory.resolve("account.db").toFile());
+        final var self = new RecipientAddress(Optional.empty(), Optional.of("+15550000001"));
+        final var recipients = new RecipientStore((c, a, b) -> {
+        }, () -> self, () -> null, database);
+        store = new ConfigurationStore(new KeyValueStore(database), recipients);
+        store.setChangeListener(notifications::incrementAndGet);
+    }
+
+    @AfterEach
+    void tearDown() {
+        database.close();
+    }
+
+    @Test
+    void valuesStartUnknownAndRoundTrip() {
+        final var unknown = store.snapshot();
+        assertTrue(unknown.readReceipts().isEmpty());
+        assertTrue(unknown.typingIndicators().isEmpty());
+        assertTrue(unknown.linkPreviews().isEmpty());
+        assertTrue(unknown.unidentifiedDeliveryIndicators().isEmpty());
+
+        store.setReadReceipts(false);
+        store.setTypingIndicators(true);
+        store.setLinkPreviews(false);
+        store.setUnidentifiedDeliveryIndicators(true);
+        final var known = store.snapshot();
+        assertEquals(Optional.of(false), known.readReceipts());
+        assertEquals(Optional.of(true), known.typingIndicators());
+        assertEquals(Optional.of(false), known.linkPreviews());
+        assertEquals(Optional.of(true), known.unidentifiedDeliveryIndicators());
+    }
+
+    @Test
+    void notifiesOnceWhenAWriteChangedSomethingAndNotWhenItDidNot() {
+        final var before = store.snapshot();
+        store.setReadReceipts(false);
+        store.setTypingIndicators(false);
+        store.notifyIfChanged(before);
+        assertEquals(1, notifications.get());
+
+        final var same = store.snapshot();
+        store.setReadReceipts(false);
+        store.setTypingIndicators(false);
+        store.notifyIfChanged(same);
+        assertEquals(1, notifications.get(), "re-writing identical values is not a change");
+
+        final var flipped = store.snapshot();
+        store.setReadReceipts(true);
+        store.notifyIfChanged(flipped);
+        assertEquals(2, notifications.get());
+    }
+
+    @Test
+    void aWriteWithoutAListenerIsHarmless() {
+        store.setChangeListener(null);
+        final var before = store.snapshot();
+        store.setLinkPreviews(true);
+        store.notifyIfChanged(before);
+        assertEquals(0, notifications.get());
+    }
+}
