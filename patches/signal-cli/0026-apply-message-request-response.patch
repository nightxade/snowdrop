+    private void applyMessageRequestResponse(final MessageRequestResponseMessage response) {
+        final var type = response.getType();
+        final var block = type == MessageRequestResponseMessage.Type.BLOCK
+                || type == MessageRequestResponseMessage.Type.BLOCK_AND_DELETE
+                || type == MessageRequestResponseMessage.Type.BLOCK_AND_SPAM;
+        final var accept = type == MessageRequestResponseMessage.Type.ACCEPT
+                || type == MessageRequestResponseMessage.Type.UNBLOCK_AND_ACCEPT;
+        if (!block && !accept) {
+            return;
+        }
+        if (response.getPerson().isPresent()) {
+            final var recipientId = account.getRecipientResolver().resolveRecipient(response.getPerson().get());
+            final var contact = account.getContactStore().getContact(recipientId);
+            if (block) {
+                context.getContactHelper().setContactBlocked(recipientId, true);
+                return;
+            }
+            if (contact != null && contact.isBlocked()) {
+                context.getContactHelper().setContactBlocked(recipientId, false);
+            }
+            context.getContactHelper().setContactProfileSharing(recipientId, true);
+        } else if (response.getGroupId().isPresent()) {
+            // Local stores only: read the group without GroupHelper.getGroup (which may fetch a V2 group from
+            // the group server) and without setGroupBlocked (which enqueues a storage sync), so nothing
+            // here touches the network on the receive thread.
+            final var groupId = GroupId.unknownVersion(response.getGroupId().get());
+            final var group = account.getGroupStore().getGroup(groupId);
+            if (group == null) {
+                logger.debug("Message request response for a group that is not in the GroupStore");
+            } else if (block) {
+                group.setBlocked(true);
+                group.setBlockedAt(System.currentTimeMillis());
+                account.getGroupStore().updateGroup(group);
+            } else if (group.isBlocked()) {
+                group.setBlocked(false);
+                group.setBlockedAt(0);
+                account.getGroupStore().updateGroup(group);
+            }
+        }
+    }
