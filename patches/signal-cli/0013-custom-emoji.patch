+            if (uploaded.getSize().orElse(0) > MAX_CUSTOM_EMOJI_ATTACHMENT_SIZE_BYTES) {
+                throw new AttachmentInvalidException(emoji.attachment(),
+                        new IOException("Custom emoji attachment is larger than "
+                                + MAX_CUSTOM_EMOJI_ATTACHMENT_SIZE_BYTES
