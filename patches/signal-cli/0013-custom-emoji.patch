--- /dev/null
+++ b/lib/src/main/java/org/asamk/signal/manager/helper/SnowdropCustomEmojiCodec.java
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import com.squareup.wire.ProtoAdapter;
+import com.squareup.wire.ProtoReader;
+import com.squareup.wire.ProtoWriter;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.whispersystems.signalservice.api.InvalidMessageStructureException;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentPointer;
+import org.whispersystems.signalservice.api.util.AttachmentPointerUtil;
+import org.whispersystems.signalservice.internal.push.AttachmentPointer;
+import org.whispersystems.signalservice.internal.push.Content;
+import org.whispersystems.signalservice.internal.push.DataMessage;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+import okio.Buffer;
+import okio.ByteString;
+
+/**
+ * Encodes and decodes Snowdrop's custom-emoji extension: a small, self-contained Wire
+ * submessage carried as an <em>unknown</em> field on the standard Signal {@code DataMessage}
+ * proto (see patches/signal-service-java's generic unknown-fields hook on
+ * {@code SignalServiceDataMessage}). Official Signal clients ignore unknown fields entirely,
+ * so a message built this way still renders its plain {@code :name:} text everywhere else.
+ * <p>
+ * Wire shape (not part of Signal's own .proto; defined and owned entirely by this patch):
+ * <pre>
+ *   // Field 9000 on DataMessage, chosen far outside Signal's own numbering.
+ *   message SnowdropExtension {
+ *     repeated SnowdropEmojiEntry emoji = 1;
+ *   }
+ *   message SnowdropEmojiEntry {
+ *     string name = 1;
+ *     bytes attachment = 2; // a serialized, standard Signal AttachmentPointer proto
+ *   }
+ * </pre>
+ * The nested attachment is a real {@code AttachmentPointer}, so the receiving side downloads
+ * and decrypts it through signal-cli's normal attachment path
+ * ({@code AttachmentPointerUtil.createSignalAttachmentPointer}, then the usual
+ * {@code MessageEnvelope.Data.Attachment} conversion) rather than a bespoke shape.
+ */
+public final class SnowdropCustomEmojiCodec {
+
+    private static final Logger logger = LoggerFactory.getLogger(SnowdropCustomEmojiCodec.class);
+
+    /** The DataMessage field number this extension occupies. Far above Signal's own fields. */
+    public static final int DATA_MESSAGE_FIELD_NUMBER = 9000;
+
+    /** Defensive cap on how many custom emoji a single message may carry, regardless of sender. */
+    public static final int MAX_ENTRIES = 50;
+
+    private static final int EXTENSION_EMOJI_TAG = 1;
+    private static final int ENTRY_NAME_TAG = 1;
+    private static final int ENTRY_ATTACHMENT_TAG = 2;
+
+    private SnowdropCustomEmojiCodec() {
+    }
+
+    public record Entry(String name, AttachmentPointer attachmentPointer) {}
+
+    /**
+     * Converts a decoded entry's raw {@code AttachmentPointer} proto into the
+     * {@code SignalServiceAttachmentPointer} the rest of signal-cli's attachment machinery
+     * (downloading it, converting it to {@code MessageEnvelope.Data.Attachment}) already knows
+     * how to handle — the same conversion ordinary attachments go through, just starting from a
+     * raw proto instead of a {@code SignalServiceContent}-parsed one. Returns {@code null},
+     * rather than throwing, for a pointer that doesn't parse: one malformed entry shouldn't take
+     * down the rest of the message.
+     */
+    public static SignalServiceAttachmentPointer toSignalAttachmentPointer(Entry entry) {
+        try {
+            return AttachmentPointerUtil.createSignalAttachmentPointer(entry.attachmentPointer());
+        } catch (InvalidMessageStructureException e) {
+            logger.debug("Ignoring Snowdrop custom emoji with an invalid attachment pointer", e);
+            return null;
+        }
+    }
+
+    /**
+     * Encodes {@code entries} into the raw unknown-field bytes to hand to
+     * {@code SignalServiceDataMessage.Builder#withUnknownFields}. Returns {@code null} (meaning
+     * "attach nothing") for a null/empty list.
+     */
+    public static ByteString encode(List<Entry> entries) throws IOException {
+        if (entries == null || entries.isEmpty()) {
+            return null;
+        }
+        if (entries.size() > MAX_ENTRIES) {
+            throw new IOException("Too many custom emoji entries (" + entries.size() + " > " + MAX_ENTRIES + ")");
+        }
+
+        final var extensionBuffer = new Buffer();
+        final var extensionWriter = new ProtoWriter(extensionBuffer);
+        for (final var entry : entries) {
+            final var entryBuffer = new Buffer();
+            final var entryWriter = new ProtoWriter(entryBuffer);
+            ProtoAdapter.STRING.encodeWithTag(entryWriter, ENTRY_NAME_TAG, entry.name());
+            AttachmentPointer.ADAPTER.encodeWithTag(entryWriter, ENTRY_ATTACHMENT_TAG, entry.attachmentPointer());
+            ProtoAdapter.BYTES.encodeWithTag(extensionWriter, EXTENSION_EMOJI_TAG, entryBuffer.readByteString());
+        }
+        final var extensionBytes = extensionBuffer.readByteString();
+
+        final var fieldBuffer = new Buffer();
+        final var fieldWriter = new ProtoWriter(fieldBuffer);
+        ProtoAdapter.BYTES.encodeWithTag(fieldWriter, DATA_MESSAGE_FIELD_NUMBER, extensionBytes);
+        return fieldBuffer.readByteString();
+    }
+
+    /** Decodes a received {@code DataMessage}'s custom emoji, tolerating malformed input. */
+    public static List<Entry> decodeDataMessage(Content content) {
+        if (content == null || content.dataMessage == null) {
+            return List.of();
+        }
+        return decode(content.dataMessage.unknownFields());
+    }
+
+    /** Decodes a received {@code EditMessage}'s wrapped {@code DataMessage} custom emoji. */
+    public static List<Entry> decodeEditMessage(Content content) {
+        if (content == null || content.editMessage == null || content.editMessage.dataMessage == null) {
+            return List.of();
+        }
+        return decode(content.editMessage.dataMessage.unknownFields());
+    }
+
+    private static List<Entry> decode(ByteString unknownFields) {
+        if (unknownFields == null || unknownFields.size() == 0) {
+            return List.of();
+        }
+        try {
+            final var reader = new ProtoReader(new Buffer().write(unknownFields));
+            final var token = reader.beginMessage();
+            for (int tag; (tag = reader.nextTag()) != -1;) {
+                if (tag == DATA_MESSAGE_FIELD_NUMBER) {
+                    final var extensionBytes = ProtoAdapter.BYTES.decode(reader);
+                    reader.endMessageAndGetUnknownFields(token);
+                    return decodeExtension(extensionBytes);
+                }
+                reader.skip();
+            }
+            reader.endMessageAndGetUnknownFields(token);
+        } catch (IOException | RuntimeException e) {
+            logger.debug("Ignoring malformed Snowdrop custom emoji extension", e);
+        }
+        return List.of();
+    }
+
+    private static List<Entry> decodeExtension(ByteString extensionBytes) {
+        final var entries = new ArrayList<Entry>();
+        try {
+            final var reader = new ProtoReader(new Buffer().write(extensionBytes));
+            final var token = reader.beginMessage();
+            for (int tag; (tag = reader.nextTag()) != -1;) {
+                if (tag == EXTENSION_EMOJI_TAG) {
+                    final var entry = decodeEntry(ProtoAdapter.BYTES.decode(reader));
+                    if (entry != null && entries.size() < MAX_ENTRIES) {
+                        entries.add(entry);
+                    }
+                } else {
+                    reader.skip();
+                }
+            }
+            reader.endMessageAndGetUnknownFields(token);
+        } catch (IOException | RuntimeException e) {
+            logger.debug("Ignoring malformed Snowdrop custom emoji extension entry list", e);
+            return List.of();
+        }
+        return entries;
+    }
+
+    private static Entry decodeEntry(ByteString entryBytes) {
+        String name = null;
+        AttachmentPointer attachmentPointer = null;
+        try {
+            final var reader = new ProtoReader(new Buffer().write(entryBytes));
+            final var token = reader.beginMessage();
+            for (int tag; (tag = reader.nextTag()) != -1;) {
+                switch (tag) {
+                    case ENTRY_NAME_TAG -> name = ProtoAdapter.STRING.decode(reader);
+                    case ENTRY_ATTACHMENT_TAG -> {
+                        final var pointerBytes = ProtoAdapter.BYTES.decode(reader);
+                        attachmentPointer = AttachmentPointer.ADAPTER.decode(pointerBytes);
+                    }
+                    default -> reader.skip();
+                }
+            }
+            reader.endMessageAndGetUnknownFields(token);
+        } catch (IOException | RuntimeException e) {
+            logger.debug("Ignoring malformed Snowdrop custom emoji entry", e);
+            return null;
+        }
+        if (name == null || name.isEmpty() || attachmentPointer == null) {
+            return null;
+        }
+        return new Entry(name, attachmentPointer);
+    }
+}
