new file mode 100644
index 0000000..a9e0694
--- /dev/null
+++ b/lib/src/test/java/org/asamk/signal/manager/helper/SnowdropCustomEmojiCodecTest.java
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.asamk.signal.manager.helper;
+
+import org.junit.jupiter.api.Test;
+import org.whispersystems.signalservice.api.InvalidMessageStructureException;
+import org.whispersystems.signalservice.api.messages.SignalServiceAttachmentRemoteId;
+import org.whispersystems.signalservice.internal.push.AttachmentPointer;
+import org.whispersystems.signalservice.internal.push.Content;
+import org.whispersystems.signalservice.internal.push.DataMessage;
+import org.whispersystems.signalservice.internal.push.EditMessage;
+
+import java.io.IOException;
+import java.util.List;
+
+import okio.ByteString;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SnowdropCustomEmojiCodecTest {
+
+    private static AttachmentPointer samplePointer(long cdnId) {
+        return new AttachmentPointer.Builder().cdnId(cdnId)
+                .key(ByteString.of((byte) 1, (byte) 2, (byte) 3))
+                .digest(ByteString.of((byte) 4, (byte) 5))
+                .size(123)
+                .contentType("image/png")
+                .uploadTimestamp(42L)
+                .build();
+    }
+
+    /**
+     * A pointer complete enough for {@code AttachmentPointerUtil.createSignalAttachmentPointer}
+     * to accept: unlike {@link #samplePointer}, it also sets {@code cdnNumber}, which that
+     * conversion requires (along with {@code key}) and {@code decode}/{@code encode} round
+     * trips here don't exercise.
+     */
+    private static AttachmentPointer downloadablePointer(long cdnId) {
+        return new AttachmentPointer.Builder().cdnId(cdnId)
+                .cdnNumber(2)
+                .key(ByteString.of((byte) 1, (byte) 2, (byte) 3))
+                .digest(ByteString.of((byte) 4, (byte) 5))
+                .size(123)
+                .contentType("image/png")
+                .uploadTimestamp(42L)
+                .build();
+    }
+
+    @Test
+    public void encodeThenDecode_roundTripsSingleEntry() throws IOException {
+        final var entry = new SnowdropCustomEmojiCodec.Entry("party", samplePointer(1));
+
+        final var unknownFields = SnowdropCustomEmojiCodec.encode(List.of(entry));
+        final var dataMessageBuilder = new DataMessage.Builder().body("hi :party:");
+        dataMessageBuilder.addUnknownFields(unknownFields);
+        final var dataMessage = dataMessageBuilder.build();
+        final var content = new Content.Builder().dataMessage(dataMessage).build();
+
+        // Round trip through the wire to prove this survives real proto encode/decode, not just
+        // in-memory builder state.
+        final var decodedContent = Content.ADAPTER.decode(Content.ADAPTER.encode(content));
+
+        final var decoded = SnowdropCustomEmojiCodec.decodeDataMessage(decodedContent);
+        assertEquals(1, decoded.size());
+        assertEquals("party", decoded.get(0).name());
+        assertEquals(1L, decoded.get(0).attachmentPointer().cdnId);
+    }
+
+    @Test
+    public void encodeThenDecode_roundTripsMultipleEntriesInOrder() throws IOException {
+        final var entries = List.of(new SnowdropCustomEmojiCodec.Entry("a", samplePointer(1)),
+                new SnowdropCustomEmojiCodec.Entry("b", samplePointer(2)),
+                new SnowdropCustomEmojiCodec.Entry("c", samplePointer(3)));
+
+        final var unknownFields = SnowdropCustomEmojiCodec.encode(entries);
+        final var dataMessageBuilder = new DataMessage.Builder();
+        dataMessageBuilder.addUnknownFields(unknownFields);
+        final var dataMessage = dataMessageBuilder.build();
+        final var content = new Content.Builder().dataMessage(dataMessage).build();
+        final var decodedContent = Content.ADAPTER.decode(Content.ADAPTER.encode(content));
+
+        final var decoded = SnowdropCustomEmojiCodec.decodeDataMessage(decodedContent);
+        assertEquals(List.of("a", "b", "c"), decoded.stream().map(SnowdropCustomEmojiCodec.Entry::name).toList());
+    }
+
+    @Test
+    public void decode_roundTripsThroughEditMessage() throws IOException {
+        final var entry = new SnowdropCustomEmojiCodec.Entry("edited", samplePointer(9));
+        final var unknownFields = SnowdropCustomEmojiCodec.encode(List.of(entry));
+        final var dataMessageBuilder = new DataMessage.Builder();
+        dataMessageBuilder.addUnknownFields(unknownFields);
+        final var dataMessage = dataMessageBuilder.build();
+        final var editMessage = new EditMessage.Builder().targetSentTimestamp(1L).dataMessage(dataMessage).build();
+        final var content = new Content.Builder().editMessage(editMessage).build();
+        final var decodedContent = Content.ADAPTER.decode(Content.ADAPTER.encode(content));
+
+        final var decoded = SnowdropCustomEmojiCodec.decodeEditMessage(decodedContent);
+        assertEquals(1, decoded.size());
+        assertEquals("edited", decoded.get(0).name());
+    }
+
+    @Test
+    public void encode_returnsNullForEmptyOrNullList() throws IOException {
+        assertNull(SnowdropCustomEmojiCodec.encode(List.of()));
+        assertNull(SnowdropCustomEmojiCodec.encode(null));
+    }
+
+    @Test
+    public void encode_rejectsTooManyEntries() {
+        final var tooMany = java.util.stream.IntStream.range(0, SnowdropCustomEmojiCodec.MAX_ENTRIES + 1)
+                .mapToObj(i -> new SnowdropCustomEmojiCodec.Entry("e" + i, samplePointer(i)))
+                .toList();
+
+        assertThrows(IOException.class, () -> SnowdropCustomEmojiCodec.encode(tooMany));
+    }
+
+    @Test
+    public void decodeDataMessage_toleratesNoExtensionPresent() {
+        final var content = new Content.Builder().dataMessage(new DataMessage.Builder().body("plain").build()).build();
+
+        assertTrue(SnowdropCustomEmojiCodec.decodeDataMessage(content).isEmpty());
+    }
+
+    @Test
+    public void decodeDataMessage_toleratesMissingDataMessage() {
+        assertTrue(SnowdropCustomEmojiCodec.decodeDataMessage(new Content.Builder().build()).isEmpty());
+        assertTrue(SnowdropCustomEmojiCodec.decodeDataMessage(null).isEmpty());
+    }
+
+    @Test
+    public void decodeDataMessage_toleratesGarbageInTheExtensionField() {
+        final var garbageField = new okio.Buffer();
+        try {
+            final var writer = new com.squareup.wire.ProtoWriter(garbageField);
+            writer.writeTag(SnowdropCustomEmojiCodec.DATA_MESSAGE_FIELD_NUMBER, com.squareup.wire.FieldEncoding.LENGTH_DELIMITED);
+            final var junk = ByteString.of((byte) 0xFF, (byte) 0xFF, (byte) 0xFF);
+            writer.writeVarint32(junk.size());
+            writer.writeBytes(junk);
+        } catch (IOException e) {
+            throw new AssertionError(e);
+        }
+
+        final var dataMessageBuilder = new DataMessage.Builder();
+        dataMessageBuilder.addUnknownFields(garbageField.readByteString());
+        final var dataMessage = dataMessageBuilder.build();
+        final var content = new Content.Builder().dataMessage(dataMessage).build();
+
+        assertTrue(SnowdropCustomEmojiCodec.decodeDataMessage(content).isEmpty());
+    }
+
+    @Test
+    public void decodeDataMessage_dropsEntriesMissingAFieldButKeepsOthers() throws IOException {
+        // Hand-build an extension where the first entry is missing its attachment (invalid) and
+        // the second is valid, to verify malformed entries are skipped individually.
+        final var validPointer = samplePointer(5);
+
+        final var entryBuffer = new okio.Buffer();
+        final var entryWriter = new com.squareup.wire.ProtoWriter(entryBuffer);
+        com.squareup.wire.ProtoAdapter.STRING.encodeWithTag(entryWriter, 1, "missingAttachment");
+        final var invalidEntryBytes = entryBuffer.readByteString();
+
+        final var validEntryBuffer = new okio.Buffer();
+        final var validEntryWriter = new com.squareup.wire.ProtoWriter(validEntryBuffer);
+        com.squareup.wire.ProtoAdapter.STRING.encodeWithTag(validEntryWriter, 1, "valid");
+        AttachmentPointer.ADAPTER.encodeWithTag(validEntryWriter, 2, validPointer);
+        final var validEntryBytes = validEntryBuffer.readByteString();
+
+        final var extensionBuffer = new okio.Buffer();
+        final var extensionWriter = new com.squareup.wire.ProtoWriter(extensionBuffer);
+        com.squareup.wire.ProtoAdapter.BYTES.encodeWithTag(extensionWriter, 1, invalidEntryBytes);
+        com.squareup.wire.ProtoAdapter.BYTES.encodeWithTag(extensionWriter, 1, validEntryBytes);
+        final var extensionBytes = extensionBuffer.readByteString();
+
+        final var fieldBuffer = new okio.Buffer();
+        final var fieldWriter = new com.squareup.wire.ProtoWriter(fieldBuffer);
+        com.squareup.wire.ProtoAdapter.BYTES.encodeWithTag(fieldWriter,
+                SnowdropCustomEmojiCodec.DATA_MESSAGE_FIELD_NUMBER,
+                extensionBytes);
+
+        final var dataMessageBuilder = new DataMessage.Builder();
+        dataMessageBuilder.addUnknownFields(fieldBuffer.readByteString());
+        final var dataMessage = dataMessageBuilder.build();
+        final var content = new Content.Builder().dataMessage(dataMessage).build();
+
+        final var decoded = SnowdropCustomEmojiCodec.decodeDataMessage(content);
+        assertEquals(1, decoded.size());
+        assertEquals("valid", decoded.get(0).name());
+    }
+
+    /**
+     * The seam {@code IncomingMessageHandler} uses to queue a received custom emoji's
+     * attachment for download (and {@code MessageEnvelope.CustomEmoji.from} uses to serialize
+     * it): converting a decoded entry's raw pointer into the
+     * {@code SignalServiceAttachmentPointer} the rest of signal-cli's attachment machinery
+     * accepts.
+     */
+    @Test
+    public void toSignalAttachmentPointer_convertsAValidPointerForDownload() throws InvalidMessageStructureException {
+        final var entry = new SnowdropCustomEmojiCodec.Entry("party", downloadablePointer(7));
+
+        final var pointer = SnowdropCustomEmojiCodec.toSignalAttachmentPointer(entry);
+
+        assertNotNull(pointer);
+        assertTrue(pointer.isPointer());
+        assertEquals("image/png", pointer.getContentType());
+        assertEquals(SignalServiceAttachmentRemoteId.from(downloadablePointer(7)), pointer.getRemoteId());
+    }
+
+    @Test
+    public void toSignalAttachmentPointer_returnsNullRatherThanThrowingForAnInvalidPointer() {
+        // Missing cdnNumber, which AttachmentPointerUtil.createSignalAttachmentPointer requires.
+        final var incomplete = new AttachmentPointer.Builder().cdnId(7L)
+                .key(ByteString.of((byte) 1))
+                .contentType("image/png")
+                .build();
+        final var entry = new SnowdropCustomEmojiCodec.Entry("party", incomplete);
+
+        assertNull(SnowdropCustomEmojiCodec.toSignalAttachmentPointer(entry));
+    }
+}
