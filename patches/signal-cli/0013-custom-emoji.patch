+/**
+ * A custom emoji delivered alongside a {@code DataMessage} (see patches/signal-cli's "Custom
+ * emoji" extension). {@code attachment} is the exact same JSON shape as an ordinary message
+ * attachment, so its {@code id} works with the existing {@code getAttachment} RPC.
+ */
+@JsonSchema(title = "CustomEmoji")
+record JsonCustomEmoji(String name, JsonAttachment attachment) {
+
+    static JsonCustomEmoji from(MessageEnvelope.Data.CustomEmoji customEmoji) {
+        return new JsonCustomEmoji(customEmoji.name(), JsonAttachment.from(customEmoji.attachment()));
+    }
+}
