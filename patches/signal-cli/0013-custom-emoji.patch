+    version = "0.14.8-snowdrop-history.11"
+
+    // Snowdrop: substitute a locally-built, patched signal-service-java
+    // (snowdrop/patches/signal-service-java) for the stock turasa jar, when
+    // SNOWDROP_SIGNAL_SERVICE_VERSION is set (set by Snowdrop's scripts/build-signal-cli.sh
+    // after it builds and publishes the patched jar — see settings.gradle.kts for the matching
+    // repository that makes the substituted coordinate resolvable). A plain build with the env
+    // var unset resolves the unmodified turasa coordinate exactly as before this patch. Applied
+    // to every project (not just :libsignal-cli, which declares the dependency): the root
+    // application project's own runtime classpath — what `installDist` actually packages —
+    // resolves it transitively and needs the same substitution.
+    val snowdropSignalServiceVersion = System.getenv("SNOWDROP_SIGNAL_SERVICE_VERSION")
+    if (snowdropSignalServiceVersion != null) {
+        configurations.all {
+            resolutionStrategy.dependencySubstitution {
+                substitute(module("com.github.turasa:signal-service-java"))
+                    .using(module("com.github.turasa:signal-service-java:$snowdropSignalServiceVersion"))
+                    .because("Snowdrop custom-emoji extension hook (patches/signal-service-java)")
+            }
+        }
+    }
 }
 
